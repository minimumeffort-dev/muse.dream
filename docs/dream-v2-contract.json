  "language": "Dream",
  "version": 2,
  "header": "dream 2;",
  "syntax": "kind id?(key=value,...); | kind id?(key=value,...){ statements }",
  "identifiers": "[a-z][a-z0-9_]{0,31}; references use IDs, labels are display-only",
  "coordinates": {
    "world": "[x,y], origin top-left, x right, y down",
    "object": "[x,y,z], Y up",
    "length": "canonical units",
    "angles": "degrees; Euler XYZ",
    "frequency": "cycles/second (hz)",
    "speed": "units/second"
  },
  "expressions": "finite numbers, constants, + - * /, sin(degrees), cos(degrees); no general code",
  "types": {
    "n": "numeric expression",
    "v2": "[n,n]",
