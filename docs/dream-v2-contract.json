    },
    "beam": {
      "contexts": [
        "object",
        "visual"
      ],
      "id": true,
      "fields": {
        "shape": "box|cylinder|capsule",
        "material": "ref",
        "from": "v3",
        "to": "v3",
        "width": "n",
        "depth": "n",
        "taper": "n?",
        "deform": "deform?",
        "motion": "part_motion?"
      }
    },
    "route": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "kind": "rail|path|water|air|ambient",
        "mode": "loop|shuttle",
        "speed": "n",
        "altitude": "n?",
        "wait_s": "n?",
        "width": "n?",
        "surface": "trail|cycle|paved?"
      },
      "block": "path"
    },
    "point": {
      "contexts": [
        "path"
      ],
      "id": false,
      "fields": {
        "at": "point"
      }
    },
    "place": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "object": "ref",
        "at": "v2?",
        "route": "ref?",
        "offset": "n?",
        "scale": "n?",
        "heading_deg": "n?",
        "role": "prop|npc|controllable?",
        "behavior": "ref?"
      }
    },
    "behavior": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "start": "ref"
      },
      "block": "behavior"
    },
    "state": {
      "contexts": [
        "behavior"
      ],
      "id": true,
      "fields": {
        "action": "idle|patrol|perform",
        "face": "none|player?"
      },
      "block": "npc_state"
    },
    "on": {
      "contexts": [
        "npc_state"
      ],
      "id": true,
      "fields": {
        "event": "after|near_player|far_player",
        "to": "ref",
        "seconds": "n?",
        "radius": "n?"
      }
    },
    "watercourse": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "level": "n",
        "depth": "n",
        "bank": "n",
        "color": "color",
        "flow": "v2"
      },
      "block": "path"
    },
    "world": {
      "contexts": [
        "top"
      ],
      "id": false,
      "fields": {
        "size": "v2",
        "spawn": "v2",
        "heading_deg": "n",
        "player": "ref?"
      }
