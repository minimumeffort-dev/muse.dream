  "agents": {
    "limits": {
      "programs": 16,
      "actors": 32,
      "states": 8,
      "transitions": 4,
      "seconds": [
        0.1,
        300
      ],
      "radius": [
        10,
        240
      ],
      "turnRadS": 2.5
    },
    "roles": {
      "prop": "passive scenery, no route or behavior",
      "controllable": "requires rideable control capability; parked until player boards",
      "npc": "engine-owned route or behavior; driver-capable NPC cannot be boarded, passenger-only seats remain available"
    },
    "legacy": "omitted role infers controllable from control capability, otherwise npc from route, otherwise prop",
    "program": "behavior ID is file-local; states and transition targets are local to that behavior; all states reachable from start",
    "actions": {
      "idle": "rest joints and pause route clock",
      "patrol": "advance placement route and animate while moving",
      "perform": "animate joints in place with route clock paused"
    },
    "events": {
      "after": "only seconds, since state entry",
      "near_player": "only radius; 3D distance <= radius",
      "far_player": "only radius; 3D distance >= radius"
    },
    "execution": "one transition per fixed tick, first matching declaration wins; elapsed resets on transition; per-instance clocks live outside Scene; patrol resumes without teleport; face=player turns stationary actors at 2.5 rad/s",
    "boundary": "data-only bounded state machines; no scripts, pathfinding, generated input profiles or model calls; root world.player remains the original car"
  },
  "worldLimits": {
    "dimension": 16384,
    "waterArea": 8000000,
    "waveCellsPerBody": 131072,
    "waveCellSize": 24,
    "watercourseStationWidth": [
      80,
      1200
    ]
  },
  "urbanGround": {
    "streets": 32,
    "surfaces": 64,
    "markings": 128,
    "streetLength": 120000,
    "markingLength": 40000,
    "street": {
      "anchors": [
        2,
        16
      ],
      "width": [
        60,
        180
      ],
      "sidewalkPerSide": [
        0,
        40
      ],
      "cycleWidthPerSide": [
        16,
        40
      ],
      "cycleSeparator": 6,
      "minimumSegment": 80,
      "geometry": "open orthogonal polyline; joined square intersections; optional cycle tracks with painted junction crossings",
      "acceptance": "every component reaches racing road; riding surface clear of solids; water crossings require an aligned bridge carrying the full street, cycle tracks and sidewalks between rails; dedicated paths remain separate"
    },
    "surface": {
      "points": [
        3,
        64
      ],
      "area": 1000000,
      "extent": 2000,
      "geometry": "simple polygon; declaration order overlays; cannot cover street riding surfaces"
    },
    "marking": {
      "points": [
        2,
        64
      ],
      "width": [
        0.5,
        12
      ],
      "closedMinimum": 3,
      "block": "point/let/repeat; omit repeated first point"
    },
    "semantics": "visual ground follows terrain/decks; streets and cycle tracks add normal road grip; explicit bridges only, no generated controllers, flattening or traffic"
  },
  "proportions": {
    "unitsPerMeter": 10,
    "profiles": {
      "car": {
        "axis": "x",
        "min": 2.5,
        "max": 6
      },
      "plane": {
        "axis": "z",
        "min": 7,
        "max": 24
      },
      "tree": {
        "axis": "y",
        "min": 4,
        "max": 30
      },
      "person": {
        "axis": "y",
        "min": 1.4,
        "max": 2.2
      },
      "bicycle": {
        "axis": "x",
        "min": 1.4,
        "max": 2.4
      },
      "skateboard": {
        "axis": "x",
        "min": 0.5,
        "max": 1.2
      },
      "bench": {
        "axis": "x",
        "min": 1.2,
        "max": 2.8
      },
      "table": {
        "axis": "x",
        "min": 1,
        "max": 3
      },
      "building": {
        "axis": "y",
        "min": 3,
        "max": 40
      },
      "train": {
        "axis": "x",
        "min": 6,
        "max": 20
      },
      "boat": {
        "axis": "x",
        "min": 3,
        "max": 12
      },
      "food": {
        "axis": "x",
        "min": 0.1,
        "max": 0.8
      },
      "custom": {
        "axis": null,
        "min": 0.05,
        "max": 60
      }
    },
    "relativeToPlayerCar": {
      "tree": "larger",
      "plane": "larger",
      "bicycle": "smaller",
      "skateboard": "smaller"
    },
    "rule": "measure sets one rest-pose extent; uniform scale preserves shape, physics and attachments. place.scale is 0.5..2 variation and must stay in the profile range. kind=custom permits deliberate fantasy sizes. Omit measure only for legacy local-unit assets."
  },
  "modules": {
    "registry": "host-supplied module ID to Dream 2 text; no file/URL resolution",
    "asset": "imports one exported object only, under a local alias",
    "include": "merges world data only; symbols remain file-local",
    "errors": "module ID accompanies nested diagnostics; failure returns no partial world"
  },
  "output": "validated Object DSL v2 and Scene v1; authoring-language version is separate"
}
