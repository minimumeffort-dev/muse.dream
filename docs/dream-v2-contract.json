  "geometry": {
    "shape": "prism",
    "outline": "3..24 simple polygon points [X,Y], 0..1 and spanning both axes; either winding, no repeated closing point, holes, touching or crossed edges; area >= .01",
    "extrusion": "outline maps across full size X/Y, centered, extruded along Z through full size Z; rotation and uniform scaling apply normally",
    "jointRoll": "roll(axis,radius) on a joint rotates all children rigidly by traveled distance / resolved radius; reduced motion rests it, parked furnishings bake the rest pose"
  },
  "scenarios": {
    "limits": {
      "scenarios": 1,
      "locations": 32,
      "links": 64,
      "items": 32,
      "stocks": 64,
      "services": 32,
      "agents": 8,
      "objectives": 32,
      "steps": 1000
    },
    "semantics": "Optional logical task environment, separate from driving physics and NPC clocks. Explicit bidirectional links take integer steps; source stock sells, sinks accept deliveries and cannot resell; services consume/produce one item with capacity, duration and fee. Agents have integer credits and carrying capacity. Deliver/produce objectives advance only on committed transfers/completions. Seed rotates contention priority deterministically. No generated scripts, real model calls, medical decisions or ecological realism.",
    "output": "Step API with local observations, joint actions, rewards, termination/truncation and replayable JSONL. Prompt interpreter and agent policies are labelled mocks."
  },
  "agents": {
    "limits": {
      "programs": 16,
      "actors": 32,
      "states": 8,
      "transitions": 4,
      "seconds": [
        0.1,
        300
      ],
      "radius": [
        10,
        240
      ],
      "turnRadS": 2.5
    },
    "roles": {
      "prop": "passive scenery, no route or behavior",
      "controllable": "requires rideable control capability; parked until player boards",
      "npc": "engine-owned route or behavior; driver-capable NPC cannot be boarded, passenger-only seats remain available"
    },
    "legacy": "omitted role infers controllable from control capability, otherwise npc from route, otherwise prop",
    "program": "behavior ID is file-local; states and transition targets are local to that behavior; all states reachable from start",
    "actions": {
      "idle": "rest joints and pause route clock",
      "patrol": "advance placement route and animate while moving",
      "perform": "animate joints in place with route clock paused"
    },
    "events": {
      "after": "only seconds, since state entry",
      "near_player": "only radius; 3D distance <= radius",
      "far_player": "only radius; 3D distance >= radius"
    },
    "execution": "one transition per fixed tick, first matching declaration wins; elapsed resets on transition; per-instance clocks live outside Scene; patrol resumes without teleport; face=player turns stationary actors at 2.5 rad/s",
    "boundary": "data-only bounded state machines; no scripts, pathfinding, generated input profiles or model calls; root world.player remains the original car"
  },
  "daylight": {
    "cycleSeconds": [
      120,
      3600
    ],
    "startHour": "0 <= hour < 24",
    "semantics": "optional single declaration beside world/road; paused visual clock, reduced motion freezes it; R preserves clock, Start over resets it; omitted keeps static daytime",
    "nightMaterial": "optional material.night color emits after dusk; daytime base paint unchanged",
    "lamp": "object-root local position and radius 8..80, color; static prop only, no damage/knockables; soft ground-projected pool, not a point light",
    "lightPools": 512
  },
