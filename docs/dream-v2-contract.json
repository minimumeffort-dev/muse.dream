        "rot_deg": "v3?",
        "scale": "n?"
      },
      "block": "visual"
    },
    "joint": {
      "contexts": [
        "object",
        "visual"
      ],
      "id": true,
      "fields": {
        "at": "v3?",
        "rot_deg": "v3?",
