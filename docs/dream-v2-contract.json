{
  "language": "Dream",
  "version": 2,
  "header": "dream 2;",
  "syntax": "kind id?(key=value,...); | kind id?(key=value,...){ statements }",
  "identifiers": "[a-z][a-z0-9_]{0,31}; references use IDs, labels are display-only",
  "coordinates": {
    "world": "[x,y], origin top-left, x right, y down",
    "object": "[x,y,z], Y up",
    "length": "canonical units",
    "angles": "degrees; Euler XYZ",
    "frequency": "cycles/second (hz)",
    "speed": "units/second"
  },
  "expressions": "finite numbers, constants, + - * /, sin(degrees), cos(degrees); no general code",
  "types": {
    "n": "numeric expression",
    "v2": "[n,n]",
    "v3": "[n,n,n]",
    "nums": "[n,...]",
    "symbols": "[symbol,...]",
    "point": "[n,n] or [n,n,n]",
    "points2": "[[n,n],...]",
    "colors": "[#rrggbb,#rrggbb]",
    "color": "#rrggbb",
    "ref": "symbol ID",
    "symbol": "identifier",
    "text": "\"JSON-escaped string\"",
    "bool": "true|false",
    "optional": "type suffix ?",
    "variants": "enum values separated by |; other types are nested constructor calls"
  },
  "limits": {
    "characters": 65536,
    "tokens": 12000,
    "nesting": 16,
    "steps": 2048,
    "objects": 16,
    "repeat": 32
  },
  "projectLimits": {
    "modules": 32,
    "depth": 8,
    "characters": 524288,
    "assemblies": 128
  },
  "commands": {
    "material": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "style": "toon|grain|glow|stripes|cloth",
        "colors": "colors"
      }
    },
    "let": {
      "contexts": [
        "top",
        "object",
        "visual",
        "path"
      ],
      "id": true,
      "fields": {
        "value": "n"
      }
    },
    "component": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "params": "symbols?"
      },
      "block": "visual"
    },
    "object": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "label": "text"
      },
      "block": "object"
    },
    "asset": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "module": "ref",
        "object": "ref"
      }
    },
    "include": {
      "contexts": [
        "top"
      ],
      "id": true,
      "fields": {
        "module": "ref"
      }
    },
    "body": {
      "contexts": [
        "object"
      ],
      "id": false,
      "fields": {
        "interaction": "solid|knockable|decor",
        "radius": "n",
        "height": "n",
        "friction": "n?"
      }
    },
    "measure": {
      "contexts": [
        "object"
      ],
      "id": false,
      "fields": {
        "kind": "car|plane|tree|person|bicycle|skateboard|bench|table|building|train|boat|food|custom",
        "axis": "x|y|z",
        "meters": "n"
      }
    },
    "ground": {
      "contexts": [
        "object"
      ],
      "id": false,
      "fields": {
        "mode": "upright|surface"
      }
    },
    "foundation": {
      "contexts": [
        "object"
      ],
      "id": false,
      "fields": {
        "size": "v2",
        "color": "color"
