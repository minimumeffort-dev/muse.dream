dream 2;
material iron(style=toon,colors=[#35464c,#25363d]);
material glass(style=glow,colors=[#f4db9c,#ffe9ba],night=#ffd18a);
object lantern(label="Night lantern"){
  measure(kind=custom,axis=y,meters=4);
  body(interaction=solid,radius=4,height=40);
  lamp(at=[0,38,0],radius=30,color=#ffd18a);
  beam pole(shape=cylinder,material=iron,from=[0,0,0],to=[0,35,0],width=1.5,depth=1.5);
  part lens(shape=box,material=glass,at=[0,37.5,0],size=[4,5,4]);
}
daylight(cycle_s=600,start_hour=17);
world(size=[4000,2400],spawn=[525,609],heading_deg=0);
road circuit(width=118,points=[[300,590],[660,590],[810,500],[810,220],[660,130],[300,130],[150,220],[150,500]]);
place roadside_lantern(object=lantern,at=[580,710],role=prop);
checkpoint start(at=[480,612.5],dir=[1,0],width=100);
checkpoint east(at=[828.75,360],dir=[0,-1],width=100);
checkpoint north(at=[480,107.5],dir=[-1,0],width=100);
checkpoint west(at=[131.25,360],dir=[0,1],width=100);
