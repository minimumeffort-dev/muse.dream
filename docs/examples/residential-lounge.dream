dream 2;
rule benches(kind=bench,mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
rule tables(kind=table,mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
asset homes(module=tower_assets,object=station_residences);
asset bench(module=destructible,object=slatted_bench);
asset settee(module=destructible,object=timber_settee);
asset bookcase(module=tower_assets,object=lounge_bookcase);
material lounge_wood(style=wood,colors=[#876448,#664a35]);
object table(label="Lounge table"){
 measure(kind=table,axis=x,meters=2.2);
 body(interaction=solid,radius=29,height=19.2);
 impact(mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
 part top(shape=box,material=lounge_wood,at=[0,17.2,0],size=[54,4,28]);
 repeat supports(index=i,count=2){part leg(shape=box,material=lounge_wood,at=[i*42-21,7.6,0],size=[4,15.2,20]);}
}
world(size=[2400,1800],spawn=[1400,1400],heading_deg=0);
street avenue(width=80,sidewalk=24,points=[[200,1400],[2200,1400]]);
place hall(object=homes,at=[1200,950],heading_deg=180,role=prop);
site hall_entry(object=hall,kind=home,entry=[0,-31],street=avenue,width=16,points=[[1200,1348]]);
floor lobby_floor(on=hall,at=[0,.5,0],size=[70,60]);
floor lounge(on=hall,at=[4,8.5,0],size=[62,60]);
floor landing(on=hall,at=[-31,8.5,16],size=[8,8]);
place lobby_bench(object=bench,at=[1130,940],heading_deg=270,role=prop,floor=lobby_floor);
place lounge_bench(object=settee,at=[1210.3125,977.5],heading_deg=180,role=prop,floor=lounge);
place opposite_settee(object=settee,at=[1210.3125,915.625],heading_deg=0,role=prop,floor=lounge);
place shared_books(object=bookcase,at=[1110,950],heading_deg=270,role=prop,floor=lounge);
place lounge_table(object=table,at=[1210.3125,946.5625],heading_deg=0,role=prop,floor=lounge);
