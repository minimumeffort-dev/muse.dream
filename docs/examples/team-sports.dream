dream 2;
material white(style=toon,colors=[#e9e5d7,#c9ccc7]);
material steel(style=toon,colors=[#6f8187,#4b626d]);
material net(style=toon,colors=[#b8c7b9,#8ca99c]);
material orange(style=toon,colors=[#d28a42,#ab622d]);
material skin(style=toon,colors=[#c59774,#a97655]);
material hair(style=toon,colors=[#4e4037,#362e29]);
material blue(style=toon,colors=[#537eaa,#3c5f87]);
material red(style=toon,colors=[#b96a60,#944f50]);
material dark(style=toon,colors=[#3c4c59,#283844]);
material yellow(style=toon,colors=[#e2bd5d,#b4913f]);
object football(label="Football"){
  measure(kind=custom,axis=x,meters=.22);
  body(interaction=knockable,radius=4,height=8,friction=.6);
  impact(mode=bounce(restitution=.62,lift=.15));
  part leather(shape=sphere,material=white,at=[0,4,0],size=[8,8,8]);
  repeat patches(index=p,count=6){
    part patch(shape=icosphere,material=dark,at=[cos(p*60)*3.98,4,sin(p*60)*3.98],size=[.25,2.1,2.1],rot_deg=[0,-p*60,0]);
  }
  part top_patch(shape=icosphere,material=dark,at=[0,7.98,0],size=[2.3,.25,2.3]);
}
object basketball(label="Basketball"){
  measure(kind=custom,axis=x,meters=.24);
  body(interaction=knockable,radius=4,height=8,friction=.5);
  impact(mode=bounce(restitution=.78,lift=.2));
  part leather(shape=sphere,material=orange,at=[0,4,0],size=[8,8,8]);
  part seam_horizontal(shape=torus,material=dark,at=[0,4,0],size=[8.3,8.3,.3],rot_deg=[90,0,0]);
  part seam_vertical(shape=torus,material=dark,at=[0,4,0],size=[8.3,8.3,.3]);
  part seam_cross(shape=torus,material=dark,at=[0,4,0],size=[8.3,8.3,.3],rot_deg=[0,90,0]);
}
object football_goal(label="Football goal"){
  measure(kind=custom,axis=x,meters=7.4);
  body(interaction=decor,radius=4,height=25);
  repeat posts(index=p,count=2){
    beam upright(shape=cylinder,material=white,from=[p*72-36,0,0],to=[p*72-36,24,0],width=1.2,depth=1.2);
    beam support(shape=cylinder,material=steel,from=[p*72-36,24,0],to=[p*72-36,0,18],width=0.8,depth=0.8);
  }
  beam bar(shape=cylinder,material=white,from=[-36,24,0],to=[36,24,0],width=1.2,depth=1.2);
  repeat threads(index=t,count=9){
    beam thread(shape=cylinder,material=net,from=[t*8-32,24,0],to=[t*8-32,0,18],width=0.5,depth=0.5);
  }
  repeat horizontals(index=n,count=3){
    beam thread(shape=cylinder,material=net,from=[-36,n*8,18-n*6],to=[36,n*8,18-n*6],width=0.5,depth=0.5);
  }
  repeat side_mesh(index=s,count=2){
    repeat rows(index=n,count=3){
      beam cord(shape=cylinder,material=net,from=[s*72-36,n*8,0],to=[s*72-36,n*8,18-n*6],width=.5,depth=.5);
    }
    repeat ribs(index=n,count=3){
      beam cord(shape=cylinder,material=net,from=[s*72-36,0,n*6],to=[s*72-36,24-n*8,n*6],width=.5,depth=.5);
    }
  }
}
object basketball_hoop(label="Basketball hoop"){
  measure(kind=custom,axis=y,meters=4);
  body(interaction=solid,radius=4,height=40);
  beam pole(shape=box,material=steel,from=[0,0,0],to=[0,36,0],width=1.5,depth=1.5);
  beam arm(shape=box,material=steel,from=[0,34,0],to=[0,34,9],width=1.5,depth=1.5);
  part board(shape=box,material=white,at=[0,34,9],size=[18,11,1]);
  part square(shape=box,material=steel,at=[0,33,9.7],size=[6,4,0.5]);
  beam rim_mount(shape=box,material=steel,from=[0,30,9.3],to=[0,30,10.25],width=.5,depth=.5);
  repeat rim_segments(index=r,count=16){
    beam rim(shape=cylinder,material=orange,from=[cos(r*22.5)*2.25,30,12+sin(r*22.5)*2.25],to=[cos((r+1)*22.5)*2.25,30,12+sin((r+1)*22.5)*2.25],width=.18,depth=.18);
  }
  repeat cords(index=c,count=6){
    beam net_cord(shape=cylinder,material=net,from=[cos(c*60)*2,30,12+sin(c*60)*2],to=[cos(c*60),25,12+sin(c*60)],width=0.5,depth=0.5);
  }
}
material skin_deep(style=toon,colors=[#925e45,#714631]);
material skin_warm(style=toon,colors=[#d5ad86,#ab805b]);
material hair_black(style=toon,colors=[#2d3137,#1e252b]);
component civic_person(params=[athletic],materials=[shirt,complexion,hair_tone,legwear,handwear]){
  joint pelvis(bone=root,at=[0,25,0]){
    part belt(shape=box,material=dark,at=[0,0,0],size=[12,3,15]);
    repeat uniform(index=u,count=athletic){part waistband(shape=box,material=shirt,at=[0,-1.5,0],size=[13,4,16]);}
    joint chest(bone=spine,at=[0,1,0]){
      part torso(shape=capsule,material=shirt,at=[0,8,0],size=[12,19,16]);
      part head(shape=sphere,material=complexion,at=[0,24,0],size=[12,12,12]);
      part hair(shape=sphere,material=hair_tone,at=[-.7,28,0],size=[12.8,6.4,13]);
      part nose(shape=sphere,material=complexion,at=[6,23,0],size=[3,3,3]);
      repeat eyes(index=s,count=2){
        part eye(shape=sphere,material=dark,at=[5.3,25.5,s*7-3.5],size=[1.5,1.5,1.5]);
        part ear(shape=sphere,material=complexion,at=[-.5,24,s*12-6],size=[2.5,3,2]);
      }
      repeat uniform(index=u,count=athletic){
        part stripe(shape=box,material=white,at=[6.1,8,0],size=[.5,2,12]);
        part neck(shape=capsule,material=complexion,at=[0,18,0],size=[5,6,6]);
      }
      joint left_arm(bone=left_shoulder,at=[0,17,9]){
        part sleeve(shape=capsule,material=shirt,at=[0,-4.5,0],size=[5,10.5,5]);
        joint left_forearm(bone=left_elbow,at=[0,-9.5,0]){
          part elbow(shape=sphere,material=complexion,at=[0,0,0],size=[4.2,4.2,4.2]);
          part forearm(shape=capsule,material=complexion,at=[0,-4.5,0],size=[4,10,4]);
          part hand(shape=box,material=handwear,at=[.5,-10,0],size=[4.5,4,3.5]);
        }
      }
      joint right_arm(bone=right_shoulder,at=[0,17,-9]){
        part sleeve(shape=capsule,material=shirt,at=[0,-4.5,0],size=[5,10.5,5]);
        joint right_forearm(bone=right_elbow,at=[0,-9.5,0]){
          part elbow(shape=sphere,material=complexion,at=[0,0,0],size=[4.2,4.2,4.2]);
          part forearm(shape=capsule,material=complexion,at=[0,-4.5,0],size=[4,10,4]);
          part hand(shape=box,material=handwear,at=[.5,-10,0],size=[4.5,4,3.5]);
        }
      }
    }
    joint left_leg(bone=left_hip,at=[0,0,4]){
      repeat uniform(index=u,count=athletic){part shorts(shape=capsule,material=shirt,at=[0,-3,0],size=[6.4,8,6.4]);}
      part thigh(shape=capsule,material=legwear,at=[0,-5.5,0],size=[5.7,12,5.7]);
      joint left_shin(bone=left_knee,at=[0,-11.5,0]){
        part knee(shape=sphere,material=legwear,at=[0,0,0],size=[5,5,5]);
        part calf(shape=capsule,material=legwear,at=[0,-5.2,0],size=[5,11,5]);
        joint left_foot(bone=left_ankle,at=[0,-10.5,0]){
          repeat uniform(index=u,count=athletic){part sock(shape=capsule,material=white,at=[0,3,0],size=[5.3,6,5.3]);}
          part shoe(shape=box,material=white,at=[2.3,-1,0],size=[9,4,6.2]);
        }
      }
    }
    joint right_leg(bone=right_hip,at=[0,0,-4]){
      repeat uniform(index=u,count=athletic){part shorts(shape=capsule,material=shirt,at=[0,-3,0],size=[6.4,8,6.4]);}
      part thigh(shape=capsule,material=legwear,at=[0,-5.5,0],size=[5.7,12,5.7]);
      joint right_shin(bone=right_knee,at=[0,-11.5,0]){
        part knee(shape=sphere,material=legwear,at=[0,0,0],size=[5,5,5]);
        part calf(shape=capsule,material=legwear,at=[0,-5.2,0],size=[5,11,5]);
        joint right_foot(bone=right_ankle,at=[0,-10.5,0]){
          repeat uniform(index=u,count=athletic){part sock(shape=capsule,material=white,at=[0,3,0],size=[5.3,6,5.3]);}
          part shoe(shape=box,material=white,at=[2.3,-1,0],size=[9,4,6.2]);
        }
      }
    }
  }
}
material home_kit(style=toon,colors=[#4f9593,#286c72]);
material away_kit(style=toon,colors=[#d47d43,#a94e37]);
object home_athlete(label="Home athlete"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,args=[1],materials=[home_kit,skin_deep,hair_black,skin_deep,skin_deep]);
}
object home_athlete_warm(label="Home athlete"){
 measure(kind=person,axis=y,meters=1.72);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,args=[1],materials=[home_kit,skin_warm,hair,skin_warm,skin_warm]);
}
object away_athlete(label="Away athlete"){
 measure(kind=person,axis=y,meters=1.84);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,args=[1],materials=[away_kit,skin_warm,hair_black,skin_warm,skin_warm]);
}
object away_athlete_deep(label="Away athlete"){
 measure(kind=person,axis=y,meters=1.77);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,args=[1],materials=[away_kit,skin_deep,hair,skin_deep,skin_deep]);
}

object keeper_athlete(label="Goalkeeper"){
 measure(kind=person,axis=y,meters=1.86);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,args=[1],materials=[yellow,skin_deep,hair_black,skin_deep,white]);
}

voxel_world(object_cell=1,ground_cell=8,height_step=1);
world(size=[2400,1800],spawn=[1200,150],heading_deg=0);
road circuit(width=80,points=[[1200.0,150.0],[1601.818,207.09],[1942.462,369.67],[2170.074,612.987],[2250.0,900.0],[2170.074,1187.013],[1942.462,1430.33],[1601.818,1592.91],[1200.0,1650.0],[798.182,1592.91],[457.538,1430.33],[229.926,1187.013],[150.0,900.0],[229.926,612.987],[457.538,369.67],[798.182,207.09]]);
surface pitch(color=#59834f,points=[[500,400],[1500,400],[1500,1040],[500,1040]]);
place west_goal(object=football_goal,at=[500,720],heading_deg=90);
place east_goal(object=football_goal,at=[1500,720],heading_deg=-90);
place match_ball(object=football,at=[1000,720]);
sport football_practice(kind=football,surface=pitch,ball=match_ball,targets=[west_goal,east_goal],target_at=[0,12,0],target_size=[72,24],net_depth=18,team_size=6,duration_s=180,score_to=5){
 team home(objects=[home_athlete,home_athlete_warm],role=npc,keeper=0,keeper_object=keeper_athlete,style=balanced,skill=.7);
 team away(objects=[away_athlete,away_athlete_deep],role=npc,keeper=0,keeper_object=keeper_athlete,style=press,skill=.7);
}
surface court(color=#647f8b,points=[[1750,600],[2030,600],[2030,750],[1750,750]]);
place west_hoop(object=basketball_hoop,at=[1742,675],heading_deg=-90);
place east_hoop(object=basketball_hoop,at=[2038,675],heading_deg=90);
place court_ball(object=basketball,at=[1890,675]);
sport basketball_practice(kind=basketball,surface=court,ball=court_ball,targets=[west_hoop,east_hoop],target_at=[0,30,12],target_size=[4.3,4.3],team_size=6,duration_s=180,score_to=5){
 team home(objects=[home_athlete,home_athlete_warm],role=npc,style=balanced,skill=.7);
 team away(objects=[away_athlete,away_athlete_deep],role=npc,style=press,skill=.7);
}
