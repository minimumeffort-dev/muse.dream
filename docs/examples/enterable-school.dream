  part lintel(shape=box,material=ochre,at=[0,12.75,-19.5],size=[4,12.5,1],cutaway=front);
  part ceiling(shape=box,material=trim,at=[0,8.75,0],size=[55.5,.5,38],cutaway=roof);
  part roof(shape=pyramid,material=tile,at=[0,22,0],size=[57.7,6,41.5],cutaway=roof);
  part eaves(shape=box,material=trim,at=[0,18.75,0],size=[57.7,.5,41.5],cutaway=roof);
  part window_0_0(shape=box,material=glass,at=[-17.25,7,-20.15],size=[7.13,3.99,0.5],cutaway=front);
