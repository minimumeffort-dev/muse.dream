  contact c_ceiling(at=[0,8.5,0],size=[57.5,40],height=16.5);
  part floor(shape=box,material=school_floor,at=[0,.25,0],size=[55.5,.5,38]);
  part left_wall(shape=box,material=ochre,at=[-28.25,9.5,0],size=[1,19,40],cutaway=left);
