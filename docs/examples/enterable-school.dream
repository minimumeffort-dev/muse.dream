material school_floor(style=wood,colors=[#c7b796,#ab9874]);
object primary_school(label="Garden primary school"){
  measure(kind=building,axis=y,meters=10);
  body(interaction=solid,radius=28.75,height=25);
  foundation(size=[57.9,40.4],color=#9e9d8c);
  lamp(at=[0,7.8,0],radius=28,color=#ffd69a);
