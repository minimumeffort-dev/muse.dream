  part window_0_2(shape=box,material=glass,at=[5.75,7,-20.15],size=[7.13,3.99,0.5],cutaway=front);
  part window_0_3(shape=box,material=glass,at=[17.25,7,-20.15],size=[7.13,3.99,0.5],cutaway=front);
  part window_1_0(shape=box,material=glass,at=[-17.25,14,-20.15],size=[7.13,3.99,0.5],cutaway=front);
  part window_1_1(shape=box,material=glass,at=[-5.75,14,-20.15],size=[7.13,3.99,0.5],cutaway=front);
  part window_1_2(shape=box,material=glass,at=[5.75,14,-20.15],size=[7.13,3.99,0.5],cutaway=front);
  part window_1_3(shape=box,material=glass,at=[17.25,14,-20.15],size=[7.13,3.99,0.5],cutaway=front);
