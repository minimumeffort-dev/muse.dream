dream 2;
material jacket(style=toon,colors=[#527487,#354e60]);
material skin(style=toon,colors=[#b98766,#99674b]);
material timber(style=wood,colors=[#92613d,#bd905d]);
object worker(label="Maintenance worker"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=4,height=18);
 part torso(shape=capsule,material=jacket,at=[0,11,0],size=[5,6,4]);
 part head(shape=sphere,material=skin,at=[0,16,0],size=[4,4,4]);
 repeat legs(index=i,count=2){joint leg(at=[0,8,i*3-1.5],motion=swing(axis=z,deg=18,hz=.6,phase_deg=i*180)){part shin(shape=capsule,material=jacket,at=[0,-4,0],size=[2,8,2]);}}
}
object table(label="Courtyard table"){
 measure(kind=table,axis=x,meters=2);
 body(interaction=solid,radius=12,height=10);
 impact(mode=break(speed=60,scatter=30,lift=40,spin=2,lifetime=6,pattern=splinter));
 fragment top(){part board(shape=box,material=timber,at=[0,9,0],size=[20,2,12]);}
 repeat legs(index=i,count=2){fragment leg(){part support(shape=box,material=timber,at=[i*14-7,4,0],size=[2,8,10]);}}
}
behavior waiting(start=idle){state idle(action=idle){}}
world(size=[1800,1000],spawn=[250,500],heading_deg=0);
street main(width=80,sidewalk=24,points=[[150,500],[1700,500]]);
crossing depot_access(street=main,at=[250,500],width=24);
place keeper(object=worker,at=[220,590],role=npc,behavior=waiting);
place caretaker(object=worker,at=[250,590],role=npc,behavior=waiting);

// Each courtyard overlaps the existing sidewalk by sixteen units.
surface yard_0(color=#b2aa96,points=[[200,548],[300,548],[300,648],[200,648]]);
surface yard_1(color=#b2aa96,points=[[320,548],[420,548],[420,648],[320,648]]);
surface yard_2(color=#b2aa96,points=[[440,548],[540,548],[540,648],[440,648]]);
surface yard_3(color=#b2aa96,points=[[560,548],[660,548],[660,648],[560,648]]);
surface yard_4(color=#b2aa96,points=[[680,548],[780,548],[780,648],[680,648]]);
surface yard_5(color=#b2aa96,points=[[800,548],[900,548],[900,648],[800,648]]);
surface yard_6(color=#b2aa96,points=[[920,548],[1020,548],[1020,648],[920,648]]);
surface yard_7(color=#b2aa96,points=[[1040,548],[1140,548],[1140,648],[1040,648]]);
surface yard_8(color=#b2aa96,points=[[1160,548],[1260,548],[1260,648],[1160,648]]);
surface yard_9(color=#b2aa96,points=[[1280,548],[1380,548],[1380,648],[1280,648]]);
surface yard_10(color=#b2aa96,points=[[1400,548],[1500,548],[1500,648],[1400,648]]);
surface yard_11(color=#b2aa96,points=[[1520,548],[1620,548],[1620,648],[1520,648]]);
place table_0(object=table,at=[270,620],role=prop);
place table_1(object=table,at=[370,610],role=prop);
place table_2(object=table,at=[490,610],role=prop);
place table_3(object=table,at=[610,610],role=prop);
place table_4(object=table,at=[730,610],role=prop);
place table_5(object=table,at=[850,610],role=prop);
place table_6(object=table,at=[970,610],role=prop);
place table_7(object=table,at=[1090,610],role=prop);
place table_8(object=table,at=[1210,610],role=prop);
place table_9(object=table,at=[1330,610],role=prop);
place table_10(object=table,at=[1450,610],role=prop);
place table_11(object=table,at=[1570,610],role=prop);

economy(){
 good kit(label="Repair kit");
 account pocket(actor=player,credits=20,capacity=4,satiety=80,drain_s=0);
 account maintenance(actor=caretaker,credits=0,capacity=4,satiety=80,drain_s=0,repair=courtyards);
 market depot(label="Maintenance depot",actor=keeper,credits=60,radius=70){lot kits(good=kit,quantity=12,limit=12);}
 // Twelve grounds share the existing navigation budget and finite kit supply.
 repair courtyards(label="Repair courtyard tables",market=depot,on=yard_0,grounds=[yard_1,yard_2,yard_3,yard_4,yard_5,yard_6,yard_7,yard_8,yard_9,yard_10,yard_11],kind=table,input=kit,take=1,seconds=2,pay=4,effort=2,dispatch_s=0);
}
