dream 2;
material blue(style=toon,colors=[#537eaa,#3c5f87]);
material skin(style=toon,colors=[#c59774,#a97655]);
object pedestrian(label="Pedestrian"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=4,height=18);
  part torso(shape=capsule,material=blue,at=[0,11,0],size=[5,6,4]);
  part head(shape=sphere,material=skin,at=[0,16,0],size=[4,4,4]);
  part nose(shape=sphere,material=skin,at=[2,16,0],size=[1,1,1]);
  repeat legs(index=i,count=2){
    joint leg(at=[0,8,i*3-1.5],motion=swing(axis=z,deg=18,hz=.6,phase_deg=i*180)){
      part shin(shape=capsule,material=blue,at=[0,-4,0],size=[2,8,2]);
    }
  }
}
behavior welcome(start=waiting){
  state waiting(action=idle){on talk(event=interact,to=hello,radius=55,familiar=false);on again(event=interact,to=returning,radius=55,familiar=true);}
  state hello(action=idle,face=player,say="Hello. Welcome to the neighborhood."){
    on ask(event=interact,to=about,radius=55);
    on finish(event=after,to=waiting,seconds=6);
  }
  state returning(action=idle,face=player,say="Good to see you again."){
    on finish(event=after,to=waiting,seconds=6);
  }
  state about(action=idle,face=player,say="I like walking by the river. See you around."){
    on finish(event=after,to=waiting,seconds=6);
  }
}
place neighbor(object=pedestrian,at=[580,710],role=npc,behavior=welcome);
world(size=[4000,2400],spawn=[525,609],heading_deg=0,damage_pool=true);
daylight(cycle_s=600,start_hour=22);
road circuit(width=118,points=[[300,590],[660,590],[810,500],[810,220],[660,130],[300,130],[150,220],[150,500]]);

checkpoint start(at=[480,612.5],dir=[1,0],width=100);
checkpoint east(at=[828.75,360],dir=[0,-1],width=100);
checkpoint north(at=[480,107.5],dir=[-1,0],width=100);
checkpoint west(at=[131.25,360],dir=[0,1],width=100);

place customer(object=pedestrian,at=[620,730],role=npc,behavior=welcome);
material timber(style=wood,colors=[#92613d,#bd905d]);
material bark(style=wood,colors=[#6b4c35,#503926]);
material leaf(style=toon,colors=[#70945a,#56743f]);
rule trees(kind=tree,mode=topple(speed=95,duration=1,lifetime=8));
object rowan(label="Young rowan"){
 measure(kind=tree,axis=y,meters=4);
 body(interaction=solid,radius=4,height=40);
 contact trunk_body(at=[0,0,0],radius=1.4,height=40);
 part trunk(shape=cylinder,material=bark,at=[0,12,0],size=[3,24,3]);
 part lower_crown(shape=icosphere,material=leaf,at=[0,26,0],size=[18,20,16]);
 part upper_crown(shape=icosphere,material=leaf,at=[1,35,0],size=[13,13,12]);
}
place yard_tree(object=rowan,at=[720,750],role=prop);
object crate(label="Produce crate"){
 measure(kind=custom,axis=x,meters=1);
 body(interaction=solid,radius=6,height=9);
 impact(mode=break(speed=60,scatter=30,lift=40,spin=2,lifetime=6,pattern=splinter));
 fragment base(){part board(shape=box,material=timber,at=[0,1,0],size=[10,2,10]);}
 repeat walls(index=i,count=2){fragment side(){part wall(shape=box,material=timber,at=[0,5,i*9-4.5],size=[10,8,1]);}}
}
place yard_crate(object=crate,at=[670,790],role=prop);
place depot_keeper(object=pedestrian,at=[1100,730],role=npc,behavior=welcome);
street access(width=60,sidewalk=24,points=[[400,590],[400,850]]);
street main(width=60,sidewalk=24,points=[[400,850],[1400,850]]);
crossing main_cross(street=main,at=[900,850],width=20);
place remote_tree(object=rowan,at=[1160,920],role=prop);
surface work_yard(points=[[530,680],[820,680],[820,816],[530,816]],finish=terrain);
economy(){
 good bread(label="Bread",food=45);
 good flour(label="Flour");
 good kit(label="Repair kit");
 good sapling(label="Tree sapling");
 account pocket(actor=player,credits=20,capacity=8,satiety=40,drain_s=.05);
 account baker(actor=neighbor,credits=0,capacity=4,satiety=65,drain_s=.05,shop=true,work=bake);
 account regular(actor=customer,credits=20,capacity=4,satiety=65,drain_s=.05,shop=true,repairs=[yard_furniture,tree_care]);
 market corner(label="Corner bakery",actor=neighbor,credits=100,radius=70){
  lot bread_shelf(good=bread,quantity=8,limit=16,price=5);
  lot flour_sack(good=flour,quantity=12,limit=12);
  lot kits(good=kit,quantity=3,limit=3);
  lot saplings(good=sapling,quantity=2,limit=2);
 }
 market depot(label="Supply depot",actor=depot_keeper,credits=0,radius=70){lot kit_store(good=kit,quantity=12,limit=12);}
 delivery kits_run(label="Bring repair kits",from=depot,to=corner,good=kit,quantity=2,pay=4,price=3,capacity=1);
 repair yard_furniture(label="Repair furniture",market=corner,on=work_yard,streets=[main],verge=24,kind=custom,input=kit,take=1,seconds=2,pay=4,effort=5,dispatch_s=0);
 repair tree_care(label="Plant a new tree",market=corner,on=work_yard,streets=[main],verge=24,kind=tree,input=sapling,take=1,seconds=2,pay=4,effort=5,dispatch_s=0,regrow_s=30,seed_scale=.2);
 work bake(label="Bake bread",market=corner,input=flour,take=1,output=bread,make=2,seconds=2,pay=3,effort=12,capacity=1,target=4);
}
