dream 2;
material brick(style=grain,colors=[#b87861,#975f50]);
material roof(style=toon,colors=[#535b64,#3b4753]);
material glass(style=toon,colors=[#6c929d,#42616f]);
material cream(style=toon,colors=[#e5decd,#c5bfae]);
material blue(style=toon,colors=[#648c9b,#466b7c]);
object car(label="Sketch car"){
 measure(kind=car,axis=x,meters=3.5);
 body(interaction=solid,radius=11,height=14);
 part chassis(shape=box,material=brick,at=[0,5,0],size=[35,10,17]);
 part cab(shape=box,material=glass,at=[-4,12,0],size=[14,8,15]);
}
object house(label="Street house"){
 measure(kind=building,axis=y,meters=4);
 body(interaction=solid,radius=12,height=40);
 foundation(size=[40,30],color=#9e9d8c);
 part walls(shape=box,material=brick,at=[0,15,0],size=[40,30,30]);
 part roof(shape=pyramid,material=roof,at=[0,35,0],size=[41,10,32]);
 part door(shape=box,material=glass,at=[0,7,-15.2],size=[7,14,.5]);
 part step(shape=box,material=cream,at=[0,.5,-17],size=[10,1,4]);
}
object shelter(label="Bus shelter"){
 measure(kind=custom,axis=y,meters=2.5);
 body(interaction=decor,radius=4,height=25);
 part roof(shape=box,material=roof,at=[0,24,0],size=[28,2,10]);
 repeat posts(index=p,count=2){part post(shape=box,material=cream,at=[p*24-12,12,0],size=[1,24,1]);}
}
object bus(label="Neighborhood bus"){
 measure(kind=bus,axis=x,meters=7.2);
 body(interaction=solid,radius=14,height=24);
 contact shell_0(at=[-25,0,0],radius=11,height=24);
 contact shell_1(at=[-15,0,0],radius=11,height=24);
 contact shell_2(at=[-5,0,0],radius=11,height=24);
 contact shell_3(at=[5,0,0],radius=11,height=24);
 contact shell_4(at=[15,0,0],radius=11,height=24);
 contact shell_5(at=[25,0,0],radius=11,height=24);
 part shell(shape=box,material=blue,at=[0,12,0],size=[72,24,22]);
 part windows(shape=box,material=glass,at=[0,17,-11.2],size=[60,8,.5]);
 part roof(shape=box,material=cream,at=[0,23,0],size=[70,2,22]);
}
object person(label="Neighbor"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=4,height=18);
 part feet(shape=box,material=roof,at=[0,1,0],size=[5,2,4]);
 part body(shape=capsule,material=blue,at=[0,8,0],size=[5,12,4]);
 part head(shape=sphere,material=cream,at=[0,16,0],size=[4,4,4]);
}
world(size=[1800,1400],spawn=[500,300],heading_deg=0,player=car);
junction west(at=[200,300]);
junction center(at=[900,300]);
junction east(at=[1200,300]);
junction north(at=[900,180]);
junction south(at=[900,1000]);
road ring(width=80,points=[[200,300],[500,180],[1200,180],[1550,400],[1550,1050],[1200,1200],[500,1200],[200,1000]],style=street);
street main(width=60,sidewalk=24,via=[west,center,east]);
street branch(width=60,sidewalk=24,via=[north,center,south]);
crossing center_crossing(street=main,at=[900,300],width=24,junction=true);
checkpoint start(at=[200,300],dir=[1,-1],width=80);
checkpoint east_gate(at=[1550,400],dir=[1,1],width=80);
checkpoint south_gate(at=[1200,1200],dir=[-1,1],width=80);
checkpoint west_gate(at=[200,1000],dir=[-1,-1],width=80);
place home_building(object=house,at=[700,450]);
place market_building(object=house,at=[1100,450]);
place waiting_area(object=shelter,at=[800,370]);
site home(object=home_building,kind=home,entry=[0,-19],street=main,width=16,points=[[700,342]]);
site market(object=market_building,kind=market,entry=[0,-19],street=main,width=16,points=[[1100,342]]);
site platform(object=waiting_area,kind=stop,entry=[0,-5],street=main,width=16,points=[[800,342]],serves=[home,market]);
route local_bus(kind=street,mode=shuttle,speed=30){
 point(at=[400,300]);
 stop neighborhood(at=[800,300],wait_s=4,site=platform);
 point(at=[1100,300]);
}
place service_bus(object=bus,route=local_bus,role=npc);
