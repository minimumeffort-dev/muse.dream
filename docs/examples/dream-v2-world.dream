dream 2;
material red(style=toon,colors=[#c85c43,#c85c43]);
material wood(style=grain,colors=[#92613d,#bd905d]);
material dark(style=toon,colors=[#303c43,#303c43]);
component leg(params=[x,z]){
  part post(shape=box,material=wood,at=[x,12,z],size=[4,24,4]);
}
object sketch_car(label="Sketch car"){
  body(interaction=solid,radius=11,height=15);
  part chassis(shape=box,material=red,at=[0,7,0],size=[26,10,17]);
  repeat axles(index=i,count=2){
    repeat sides(index=j,count=2){
      part wheel(shape=cylinder,material=dark,at=[i*18-9,5,j*18-9],size=[8,3,8],rot_deg=[90,0,0],motion=roll(axis=y,radius=4));
    }
  }
}
object picnic_table(label="Breakable table"){
  body(interaction=solid,radius=24,height=28);
  impact(mode=break(speed=90,scatter=62,lift=100,spin=4,lifetime=6));
  fragment top(){
    part board(shape=box,material=wood,at=[0,26,0],size=[48,4,32]);
  }
  repeat ends(index=i,count=2){
    repeat sides(index=j,count=2){
      fragment leg(){
        use post(component=leg,args=[i*36-18,j*22-11]);
      }
    }
  }
}
world(size=[960,900],spawn=[525,609],heading_deg=0,player=sketch_car);
road circuit(width=118,points=[[300,590],[660,590],[810,500],[810,220],[660,130],[300,130],[150,220],[150,500]]);
hill meadow(at=[480,350],radius=[120,120],height=60);
tint orchard(at=[480,350],radius=180,color=#998363);
watercourse river(level=0,depth=6,bank=32,color=#267f8a,flow=[0,24]){
  point(at=[480,250,140]);
  point(at=[480,450,140]);
  point(at=[480,640,140]);
  point(at=[480,800,140]);
}
water pond(points=[[650,750],[790,750],[790,870],[650,870]],level=0,depth=6,bank=32,color=#318d86,flow=[0,0],drag=2.2,waves=[55,1.1,1.4]);
bridge racing_bridge(from=[300,591],to=[660,591],width=240,arch=12,style=timber,rails=true);
checkpoint start(at=[480,612.5],dir=[1,0],width=100);
checkpoint east(at=[828.75,360],dir=[0,-1],width=100);
checkpoint north(at=[480,107.5],dir=[-1,0],width=100);
checkpoint west(at=[131.25,360],dir=[0,1],width=100);
effect boost_strip(kind=boost,points=[[600,570],[640,570],[640,640],[600,640]]);
effect ice_patch(kind=ice,points=[[430,76],[530,76],[530,142],[430,142]]);
route meadow_path(kind=path,mode=loop,speed=35,wait_s=2){
  point(at=[260,300]);
  point(at=[360,300]);
  point(at=[360,400]);
  point(at=[260,400]);
}
place touring_car(object=sketch_car,route=meadow_path);
place table(object=picnic_table,at=[640,350]);
unresolved sky_magic(label="Weather-changing spells are not supported");
