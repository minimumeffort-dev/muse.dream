dream 2;
// Complete live plant constructions. The enclosing world supplies voxel_world.
material stem(style=toon,colors=[#456749,#304e38]);
material fern_leaf(style=toon,colors=[#6c9652,#3e6d45]);
material dock_leaf(style=toon,colors=[#789455,#496c43]);
material bell_pink(style=toon,colors=[#c788a0,#985e80]);
material bark(style=toon,colors=[#806447,#544b37]);
material hazel_leaf(style=toon,colors=[#789451,#4d7042]);
material hydrangea_light(style=toon,colors=[#a8b6d1,#829dbf]);
material hydrangea_center(style=toon,colors=[#d7dccb,#a7b9b4]);
material leaf(style=toon,colors=[#527348,#77935d]);
material petal(style=toon,colors=[#cf9458,#e0ba73]);
material red(style=toon,colors=[#ac6b51,#b98362]);
material soil_dark(style=toon,colors=[#514b3c,#3d3a31]);
material flower_pollen(style=toon,colors=[#e7c06d,#b48b43]);

component rooted_blade(params=[length,width,thick],materials=[coat]){
 part blade(shape=prism,material=coat,at=[length/2,0,0],size=[length,width,thick],rot_deg=[90,0,0],outline=[[0,.5],[.18,.16],[.6,0],[1,.5],[.6,1],[.18,.84]]);
}

component bell_shell(materials=[coat]){
 // Four tapered panels meet around a seven-unit rise and one-unit flare.
 repeat panels(index=p,count=4){group side(rot_deg=[0,p*90,0]){
  part wall(shape=prism,material=coat,at=[0,0,2],size=[5,7.0710678118655,.16],rot_deg=[-8.130102354156,0,0],outline=[[0,0],[1,0],[.8,1],[.2,1]]);
 }}
}

component hydrangea_floret(materials=[coat]){
 part petals(shape=prism,material=coat,at=[0,0,0],size=[5,5,.2],rot_deg=[90,0,0],outline=[[1,.5],[.88065,.6775],[.62728,.62728],[.6775,.88065],[.5,1],[.3225,.88065],[.37272,.62728],[.11935,.6775],[0,.5],[.11935,.3225],[.37272,.37272],[.3225,.11935],[.5,0],[.6775,.11935],[.62728,.37272],[.88065,.3225]]);
}

component plant_blade(params=[length,width,thick],materials=[coat]){
 part blade(shape=prism,material=coat,at=[length/2,0,0],size=[length,width,thick],rot_deg=[90,0,0],outline=[[0,.5],[.18,.16],[.6,0],[1,.5],[.6,1],[.18,.84]]);
}

component plant_petal(params=[length,width,thick],materials=[coat]){
 part blade(shape=prism,material=coat,at=[length/2,0,0],size=[length,width,thick],rot_deg=[90,0,0],outline=[[0,.5],[.15,.25],[.65,0],[.88,.15],[1,.35],[1,.65],[.88,.85],[.65,1],[.15,.75]]);
}

object woodland_fern(label="Woodland fern"){
  measure(kind=custom,axis=y,meters=.9);
  body(interaction=decor,radius=4,height=15,clearance=18.050850028231);
  ground(mode=surface);

 // Preserve the released measure frame and furnishing reservation.
 group silhouette(at=[0,0,0],scale=1){
 repeat fronds(index=f,count=4){group fan(rot_deg=[0,f*92,0]){
   beam rib(shape=cylinder,material=stem,from=[0,1,0],to=[12,14,0],width=.7,depth=.7,taper=.25);
   repeat leaflets(index=l,count=3){
    let x(value=3+l*3);
    let y(value=1+x*13/12);
    use left(component=rooted_blade,args=[5.2-l,1.7-l*.25,.16],materials=[fern_leaf],at=[x,y,0],rot_deg=[0,62,12]);
    use right(component=rooted_blade,args=[5.2-l,1.7-l*.25,.16],materials=[fern_leaf],at=[x,y,0],rot_deg=[0,-62,12]);
   }
   part tip(shape=icosphere,material=fern_leaf,at=[11,13,0],size=[5,1,3],rot_deg=[0,0,45],faceted=true);
  }}
 }
}

object foxglove(label="Pink foxglove"){
  measure(kind=custom,axis=y,meters=1.5);
  body(interaction=decor,radius=4,height=50,clearance=16.31264117723);

 // Preserve the released measure frame and furnishing reservation.
 group silhouette(at=[-0.10004377365112,0,0.63315629959106],scale=1){
 beam stalk(shape=cylinder,material=stem,from=[0,0,0],to=[1,48,0],width=1.2,depth=1.2,taper=.35);
  repeat leaves(index=l,count=4){
   let y(value=4+l*2);
   use blade(component=rooted_blade,args=[10.5,4,.18],materials=[dock_leaf],at=[y/48,y,0],rot_deg=[0,l*97,20]);
  }
  repeat bells(index=b,count=5){
   let a(value=b*137);
   let y(value=19+b*5.1);
   beam pedicel(shape=cylinder,material=stem,from=[(y+3.5)/48,y+3.5,0],to=[cos(a)*1.5,y+3.5,sin(a)*1.5],width=.25,depth=.25,taper=.45);
   use flower(component=bell_shell,materials=[bell_pink],at=[cos(a)*3,y,sin(a)*3],rot_deg=[0,-a,0]);
  }
  part bud(shape=icosphere,material=bell_pink,at=[1,47,0],size=[3.5,5,3.5],faceted=true);
 }
}

object planted_tub(label="Planted street tub"){
 measure(kind=custom,axis=x,meters=1.2);
 body(interaction=solid,radius=5,height=8,clearance=7.778174593052);

 // Preserve the released measure frame and furnishing reservation.
 group silhouette(at=[0,0,0],scale=1){
 part tub(shape=cylinder,material=red,at=[0,3,0],size=[11,6,11],rot_deg=[180,0,0],taper=.82,faceted=true);
  part soil(shape=cylinder,material=soil_dark,at=[0,6,0],size=[9.3,.2,9.3],faceted=true);
  repeat halves(index=h,count=2){group lip(rot_deg=[0,h*180,0]){
   part rim(shape=prism,material=red,at=[0,6.2,2.75],size=[11,5.5,.6],rot_deg=[90,0,0],outline=[[1,0],[.96194,.38268],[.85355,.70711],[.69134,.92388],[.5,1],[.30866,.92388],[.14645,.70711],[.03806,.38268],[0,0],[.08,0],[.11196,.32145],[.20302,.59397],[.33927,.77606],[.5,.84],[.66073,.77606],[.79698,.59397],[.88804,.32145],[.92,0]]);
  }}
  repeat leaves(index=i,count=6){use leaf(component=plant_blade,args=[5.3,1.5,.2],materials=[leaf],at=[0,6,0],rot_deg=[0,-i*60,45+i*2]);}
  beam stalk(shape=cylinder,material=leaf,from=[0,6,0],to=[0,11,0],width=.25,depth=.25,taper=.4);
  repeat petals(index=p,count=6){use petal(component=plant_petal,args=[2.1,1,.18],materials=[petal],at=[0,11,0],rot_deg=[0,-p*60,0]);}
  part center(shape=icosphere,material=flower_pollen,at=[0,11.1,0],size=[1.2,.8,1.2],faceted=true);
 }
}

object blue_hydrangea(label="Blue hydrangea"){
 measure(kind=custom,axis=y,meters=1.1);
 body(interaction=decor,radius=4,height=24,clearance=15.052682846732);

 // Preserve the released measure frame and furnishing reservation.
 group silhouette(at=[0.13077890678953,-0.096261417737309,-0.6639205815655],scale=1.0231958470646){
 repeat branches(index=i,count=4){
   let x(value=cos(i*137)*6);
   let z(value=sin(i*137)*6);
   beam stem(shape=cylinder,material=bark,from=[0,0,0],to=[x,19.7+i,z],width=.6,depth=.6,taper=.4);
   use left(component=rooted_blade,args=[7,3.5,.2],materials=[hazel_leaf],at=[x*.5,(19.7+i)*.5,z*.5],rot_deg=[0,-i*137+65,20]);
   use right(component=rooted_blade,args=[7,3.5,.2],materials=[hazel_leaf],at=[x*.6,(19.7+i)*.6,z*.6],rot_deg=[0,-i*137-65,20]);
   part hub(shape=cylinder,material=hazel_leaf,at=[x,19.7+i,z],size=[5.5,.6,5.5],faceted=true);
   repeat flowers(index=f,count=2){
    let side(value=f*2-1);
    use blossom(component=hydrangea_floret,materials=[hydrangea_light],at=[x+side*1.7,20.05+i,z+side*.6],rot_deg=[0,f*35+i*17,0]);
    part center(shape=icosphere,material=hydrangea_center,at=[x+side*1.7,20.3+i,z+side*.6],size=[.55,.5,.55],faceted=true);
   }
  }
 }
}
