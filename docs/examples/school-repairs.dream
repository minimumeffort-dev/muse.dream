dream 2;
material blue(style=toon,colors=[#537eaa,#3c5f87]);
material skin(style=toon,colors=[#c59774,#a97655]);
object pedestrian(label="Pedestrian"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=4,height=18);
  part torso(shape=capsule,material=blue,at=[0,11,0],size=[5,6,4]);
  part head(shape=sphere,material=skin,at=[0,16,0],size=[4,4,4]);
  part nose(shape=sphere,material=skin,at=[2,16,0],size=[1,1,1]);
  repeat legs(index=i,count=2){
    joint leg(at=[0,8,i*3-1.5],motion=swing(axis=z,deg=18,hz=.6,phase_deg=i*180)){
      part shin(shape=capsule,material=blue,at=[0,-4,0],size=[2,8,2]);
    }
  }
}
behavior welcome(start=waiting){
  state waiting(action=idle){on talk(event=interact,to=hello,radius=55,familiar=false);on again(event=interact,to=returning,radius=55,familiar=true);}
  state hello(action=idle,face=player,say="Hello. Welcome to the neighborhood."){
    on ask(event=interact,to=about,radius=55);
    on finish(event=after,to=waiting,seconds=6);
  }
  state returning(action=idle,face=player,say="Good to see you again."){
    on finish(event=after,to=waiting,seconds=6);
  }
  state about(action=idle,face=player,say="I like walking by the river. See you around."){
    on finish(event=after,to=waiting,seconds=6);
  }
}
place neighbor(object=pedestrian,at=[580,710],role=npc,behavior=welcome);
world(size=[4000,2400],spawn=[525,609],heading_deg=0);
road circuit(width=118,points=[[300,590],[660,590],[810,500],[810,220],[660,130],[300,130],[150,220],[150,500]]);

checkpoint start(at=[480,612.5],dir=[1,0],width=100);
checkpoint east(at=[828.75,360],dir=[0,-1],width=100);
checkpoint north(at=[480,107.5],dir=[-1,0],width=100);
checkpoint west(at=[131.25,360],dir=[0,1],width=100);

place customer(object=pedestrian,at=[620,730],role=npc,behavior=welcome);
material wood(style=toon,colors=[#96714d,#6e503a]);
material dark_wood(style=wood,colors=[#53412e,#413325]);
material steel(style=toon,colors=[#737d7e,#49545b]);
object slatted_bench(label="Slatted park bench"){
  measure(kind=bench,axis=x,meters=1.8);
  body(interaction=solid,radius=28,height=31);
  seat left(at=[-13,18,12],approach=[-13,48],heading_deg=90);
  seat right(at=[13,18,12],approach=[13,48],heading_deg=90);
  impact(mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
  repeat slats(index=i,count=4){
    fragment plank(){voxels seat(material=wood,at=[0,16,-12+i*8],size=[60,4,6],grid=[30,2,3]){fill board(from=[0,0,0],to=[30,2,3]);}}
  }
  repeat supports(index=i,count=2){
    fragment frame(){
      voxels leg_front(material=dark_wood,at=[i*44-22,6.5,12],size=[5,13,6],grid=[2,6,3]){fill board(from=[0,0,0],to=[2,6,3]);}
      voxels leg_back(material=dark_wood,at=[i*44-22,15,-13],size=[5,30,6],grid=[2,15,3]){fill board(from=[0,0,0],to=[2,15,3]);}
      voxels brace(material=dark_wood,at=[i*44-22,12,0],size=[6,4,29],grid=[3,2,14]){fill board(from=[0,0,0],to=[3,2,14]);}
      voxels armrest(material=wood,at=[i*44-22,24,0],size=[5,3,29],grid=[2,2,14]){fill board(from=[0,0,0],to=[2,2,14]);}
      voxels arm_support(material=dark_wood,at=[i*44-22,20,12],size=[3,8,3],grid=[2,4,2]){fill board(from=[0,0,0],to=[2,4,2]);}
    }
  }
  fragment back(){
    voxels upper(material=wood,at=[0,27,-16],size=[60,6,4],grid=[30,3,2]){fill board(from=[0,0,0],to=[30,3,2]);}
    voxels lower(material=wood,at=[0,21,-16],size=[60,6,4],grid=[30,3,2]){fill board(from=[0,0,0],to=[30,3,2]);}
      repeat bolts(index=b,count=2){part bolt(shape=sphere,material=steel,at=[b*44-22,27,-13.7],size=[1,1,1]);}
  }
}
rule benches(kind=bench,mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
place school_bench(object=slatted_bench,at=[1160,970]);
street access(width=60,sidewalk=24,points=[[400,590],[400,850]]);
street main(width=60,sidewalk=24,points=[[400,850],[1400,850]]);
crossing main_cross(street=main,at=[900,850],width=20);
surface work_yard(color=#b2aa96,points=[[530,680],[820,680],[820,816],[530,816]]);
surface school_access(color=#b2aa96,points=[[1080,884],[1260,884],[1260,940],[1080,940]]);
surface school_yard(color=#b2aa96,points=[[1080,940],[1260,940],[1260,1020],[1080,1020]]);
economy(){
 good kit(label="Repair kit");
 account pocket(actor=player,credits=20,capacity=8,satiety=40,drain_s=0);
 account supplier(actor=neighbor,credits=0,capacity=4,satiety=65,drain_s=0);
 account caretaker(actor=customer,credits=0,capacity=4,satiety=65,drain_s=0,repair=school_furniture);
 market corner(label="Repair supplies",actor=neighbor,credits=100,radius=70){
  lot kits(good=kit,quantity=3,limit=3);
 }
 repair school_furniture(
  label="Repair school furniture",
  market=corner,on=work_yard,
  grounds=[school_access,school_yard],
  kind=bench,input=kit,take=1,
  seconds=8,pay=4,effort=5,
  dispatch_s=12
 );
}
