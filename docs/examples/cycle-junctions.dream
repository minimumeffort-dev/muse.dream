dream 2;
material red(style=toon,colors=[#b85a44,#b85a44]);
object car(label="Town car"){
  measure(kind=car,axis=x,meters=4);
  body(interaction=solid,radius=11,height=15);
  part bodywork(shape=box,material=red,at=[0,8,0],size=[40,12,18]);
}
world(size=[1600,1200],spawn=[800,500],heading_deg=0,player=car);
junction tee(at=[500,500]);
junction square(at=[1100,500]);
junction west(at=[200,500]);
junction east(at=[1400,500]);
junction branch_end(at=[500,200]);
junction north_end(at=[1100,200]);
junction south_end(at=[1100,1000]);
street main(width=100,sidewalk=24,cycle_width=20,via=[west,tee,square,east]);
street branch(width=100,sidewalk=24,cycle_width=20,via=[branch_end,tee]);
street through(width=100,sidewalk=24,cycle_width=20,via=[north_end,square,south_end]);
crossing tee_access(street=main,at=[500,500],width=24,junction=true);
crossing square_access(street=main,at=[1100,500],width=24,junction=true);
