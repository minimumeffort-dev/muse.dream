dream 2;
material brick(style=grain,colors=[#b17459,#985c48]);
material redbrick(style=grain,colors=[#9e6053,#bd8170]);
material plaster(style=toon,colors=[#ddd1b9,#c5b69a]);
material blue(style=toon,colors=[#9aadaf,#758e98]);
material ochre(style=toon,colors=[#d4b378,#b9955f]);
material glass(style=toon,colors=[#6c929d,#42616f]);
material roof(style=toon,colors=[#535b64,#3b4753]);
material tile(style=toon,colors=[#aa6b50,#864d3e]);
material trim(style=toon,colors=[#e5decd,#c5bfae]);
material wood(style=grain,colors=[#805c40,#aa815a]);
material dark(style=toon,colors=[#35464c,#28363e]);
material green(style=toon,colors=[#5e7c73,#405d55]);
material sign(style=toon,colors=[#e4b948,#c79435]);
material airport_glass(style=toon,colors=[#7ba5b2,#456a7c],night=#e6bd83);
object airport_terminal(label="Regional airport terminal"){
 measure(kind=building,axis=y,meters=7.7);
 body(interaction=solid,radius=30,height=22);
 foundation(size=[76,38],color=#a6a79b);
 contact wall_0(at=[-27,0,-8.5],radius=13,height=20);
 contact wall_1(at=[-9,0,-8.5],radius=13,height=20);
 contact wall_2(at=[9,0,-8.5],radius=13,height=20);
 contact wall_3(at=[27,0,-8.5],radius=13,height=20);
 contact wall_4(at=[-27,0,8.5],radius=13,height=20);
 contact wall_5(at=[-9,0,8.5],radius=13,height=20);
 contact wall_6(at=[9,0,8.5],radius=13,height=20);
 contact wall_7(at=[27,0,8.5],radius=13,height=20);
 part walls(shape=box,material=plaster,at=[0,10,0],size=[72,20,34]);
 part roof(shape=box,material=roof,at=[0,21,0],size=[76,2,38]);
 part fascia(shape=box,material=green,at=[0,18.8,-17.2],size=[72,2,.6]);
 repeat bays(index=i,count=6){
  part glazing(shape=box,material=airport_glass,at=[i*11-27.5,11,-17.15],size=[9.5,12,.5]);
  part mullion(shape=box,material=trim,at=[i*11-32.5,10,-17.3],size=[.7,18,.7]);
 }
 part doors(shape=box,material=dark,at=[0,5,-17.5],size=[9,10,.6]);
 part door_glass(shape=box,material=airport_glass,at=[0,6,-17.85],size=[7,7,.5]);
 part porch(shape=box,material=trim,at=[0,.25,-21],size=[36,.5,10]);
 part canopy(shape=box,material=green,at=[0,9,-21],size=[34,1,9]);
 repeat columns(index=i,count=2){part column(shape=cylinder,material=trim,at=[i*28-14,4.75,-24],size=[.9,8.5,.9]);}
 part sign_panel(shape=box,material=dark,at=[0,15,-17.6],size=[22,3,1]);
 beam aircraft_wing(shape=box,material=sign,from=[-6,15,-18.2],to=[6,15,-18.2],width=.5,depth=.5);
 beam aircraft_body(shape=box,material=sign,from=[0,14,-18.2],to=[0,16,-18.2],width=.5,depth=.5);
}
