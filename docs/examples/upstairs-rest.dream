dream 2;
material teal(style=toon,colors=[#297f88,#24616b]);
material skin(style=toon,colors=[#c59774,#a97655]);
material dark(style=toon,colors=[#303d48,#222c36]);
material cream(style=toon,colors=[#eee8d9,#c9c0ae]);
material wood(style=toon,colors=[#96714d,#6e503a]);
object pedestrian(label="Explorer"){
  measure(kind=person,axis=y,meters=1.75);
  body(interaction=decor,radius=8,height=57);
  joint pelvis(bone=root,at=[0,25,0]){
    part belt(shape=box,material=dark,at=[0,0,0],size=[12,3,15]);
    joint chest(bone=spine,at=[0,1,0]){
      part torso(shape=capsule,material=teal,at=[0,8,0],size=[12,19,16]);
      part head(shape=sphere,material=skin,at=[0,24,0],size=[12,12,12]);
      part hair(shape=sphere,material=dark,at=[-.7,28,0],size=[12.8,6.4,13]);
      part nose(shape=sphere,material=skin,at=[6,23,0],size=[3,3,3]);
      repeat eyes(index=s,count=2){
        part eye(shape=sphere,material=dark,at=[5.3,25.5,s*7-3.5],size=[1.5,1.5,1.5]);
        part ear(shape=sphere,material=skin,at=[-.5,24,s*12-6],size=[2.5,3,2]);
      }
      part backpack(shape=box,material=wood,at=[-7,8,0],size=[6,15,13]);
      joint left_arm(bone=left_shoulder,at=[0,17,9]){
        part sleeve(shape=capsule,material=teal,at=[0,-4.5,0],size=[5,10.5,5]);
        joint left_forearm(bone=left_elbow,at=[0,-9.5,0]){
          part elbow(shape=sphere,material=skin,at=[0,0,0],size=[4.2,4.2,4.2]);
          part forearm(shape=capsule,material=skin,at=[0,-4.5,0],size=[4,10,4]);
          part hand(shape=box,material=skin,at=[.5,-10,0],size=[4.5,4,3.5]);
        }
      }
      joint right_arm(bone=right_shoulder,at=[0,17,-9]){
        part sleeve(shape=capsule,material=teal,at=[0,-4.5,0],size=[5,10.5,5]);
        joint right_forearm(bone=right_elbow,at=[0,-9.5,0]){
          part elbow(shape=sphere,material=skin,at=[0,0,0],size=[4.2,4.2,4.2]);
          part forearm(shape=capsule,material=skin,at=[0,-4.5,0],size=[4,10,4]);
          part hand(shape=box,material=skin,at=[.5,-10,0],size=[4.5,4,3.5]);
        }
      }
    }
    joint left_leg(bone=left_hip,at=[0,0,4]){
      part thigh(shape=capsule,material=dark,at=[0,-5.5,0],size=[5.7,12,5.7]);
      joint left_shin(bone=left_knee,at=[0,-11.5,0]){
        part knee(shape=sphere,material=dark,at=[0,0,0],size=[5,5,5]);
        part calf(shape=capsule,material=dark,at=[0,-5.2,0],size=[5,11,5]);
        joint left_foot(bone=left_ankle,at=[0,-10.5,0]){
          part shoe(shape=box,material=cream,at=[2.3,-1,0],size=[9,4,6.2]);
        }
      }
    }
    joint right_leg(bone=right_hip,at=[0,0,-4]){
      part thigh(shape=capsule,material=dark,at=[0,-5.5,0],size=[5.7,12,5.7]);
      joint right_shin(bone=right_knee,at=[0,-11.5,0]){
        part knee(shape=sphere,material=dark,at=[0,0,0],size=[5,5,5]);
        part calf(shape=capsule,material=dark,at=[0,-5.2,0],size=[5,11,5]);
        joint right_foot(bone=right_ankle,at=[0,-10.5,0]){
          part shoe(shape=box,material=cream,at=[2.3,-1,0],size=[9,4,6.2]);
        }
      }
    }
  }
}

material dark_wood(style=wood,colors=[#53412e,#413325]);
material steel(style=toon,colors=[#737d7e,#49545b]);
object slatted_bench(label="Slatted park bench"){
  measure(kind=bench,axis=x,meters=1.8);
  body(interaction=solid,radius=28,height=31);
  seat left(at=[-13,18,12],approach=[-13,48],heading_deg=90);
  seat right(at=[13,18,12],approach=[13,48],heading_deg=90);
  impact(mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
  repeat slats(index=i,count=4){
    fragment plank(){voxels seat(material=wood,at=[0,16,-12+i*8],size=[60,4,6],grid=[30,2,3]){fill board(from=[0,0,0],to=[30,2,3]);}}
  }
  repeat supports(index=i,count=2){
    fragment frame(){
      voxels leg_front(material=dark_wood,at=[i*44-22,6.5,12],size=[5,13,6],grid=[2,6,3]){fill board(from=[0,0,0],to=[2,6,3]);}
      voxels leg_back(material=dark_wood,at=[i*44-22,15,-13],size=[5,30,6],grid=[2,15,3]){fill board(from=[0,0,0],to=[2,15,3]);}
      voxels brace(material=dark_wood,at=[i*44-22,12,0],size=[6,4,29],grid=[3,2,14]){fill board(from=[0,0,0],to=[3,2,14]);}
      voxels armrest(material=wood,at=[i*44-22,24,0],size=[5,3,29],grid=[2,2,14]){fill board(from=[0,0,0],to=[2,2,14]);}
      voxels arm_support(material=dark_wood,at=[i*44-22,20,12],size=[3,8,3],grid=[2,4,2]){fill board(from=[0,0,0],to=[2,4,2]);}
    }
  }
  fragment back(){
    voxels upper(material=wood,at=[0,27,-16],size=[60,6,4],grid=[30,3,2]){fill board(from=[0,0,0],to=[30,3,2]);}
    voxels lower(material=wood,at=[0,21,-16],size=[60,6,4],grid=[30,3,2]){fill board(from=[0,0,0],to=[30,3,2]);}
      repeat bolts(index=b,count=2){part bolt(shape=sphere,material=steel,at=[b*44-22,27,-13.7],size=[1,1,1]);}
  }
}
behavior welcome(start=waiting){
  state waiting(action=idle){on talk(event=interact,to=hello,radius=55,familiar=false);on again(event=interact,to=returning,radius=55,familiar=true);}
  state hello(action=idle,face=player,say="Hello. Welcome to the neighborhood."){
    on ask(event=interact,to=about,radius=55);
    on finish(event=after,to=waiting,seconds=6);
  }
  state returning(action=idle,face=player,say="Good to see you again."){
    on finish(event=after,to=waiting,seconds=6);
  }
  state about(action=idle,face=player,say="I like walking by the river. See you around."){
    on finish(event=after,to=waiting,seconds=6);
  }
}
place neighbor(object=pedestrian,at=[580,710],role=npc,behavior=welcome);

material home_brick(style=brick,colors=[#a96f55,#bcb1a0]);
material home_plaster(style=toon,colors=[#ddd1b9,#c5b69a]);
material home_glass(style=toon,colors=[#6c929d,#42616f],night=#edc590);
material home_roof(style=toon,colors=[#535b64,#3b4753]);
material home_trim(style=toon,colors=[#e5decd,#c5bfae]);
material home_wood(style=wood,colors=[#805c40,#aa815a]);
material home_dark(style=toon,colors=[#35464c,#28363e]);
material home_floorboards(style=wood,colors=[#c4aa83,#9b805d]);
material home_cushion(style=toon,colors=[#70887a,#50695e]);
material home_warm_light(style=toon,colors=[#f2d6a0,#e2c48c],night=#f6ce84);

object commuter_home(label="Commuter's terrace"){
 measure(kind=building,axis=y,meters=9);
 body(interaction=solid,radius=9.5,height=23);
 foundation(size=[19.4,34.8],color=#9e9d8c);
 lamp(at=[0,8.3,0],radius=20,color=#ffd69a);
 interior(at=[0,.5,0],size=[18,17,32]){portal front(side=front,offset=0,width=3,height=6);}
 contact c_floor(at=[0,0,0],size=[18,32],height=.5);
 contact c_left(at=[-9.25,0,0],size=[.5,32.8],height=17.5);
 contact c_right(at=[9.25,0,0],size=[.5,32.8],height=17.5);
 contact c_back(at=[0,0,16.15],size=[19,.5],height=17.5);
 contact c_front_left(at=[-5.5,0,-16.4],size=[8,.5],height=17.5);
 contact c_front_right(at=[5.5,0,-16.4],size=[8,.5],height=17.5);
 contact c_lintel(at=[0,6.5,-16.4],size=[3,.5],height=11);
 contact c_upper_floor(at=[-3,8.5,0],size=[12,32],height=.5);
 contact c_landing(at=[6,8.5,13.5],size=[6,5],height=.5);
 contact c_guard(at=[3.15,9,-2.5],size=[.2,27],height=2.5);
 contact c_ceiling(at=[0,17.5,0],size=[19,32.8],height=5.5);
 stairs flight(material=home_wood,at=[6,.5,0],size=[4,8.5,22],steps=12);
 part floor(shape=box,material=home_floorboards,at=[0,.25,0],size=[18,.5,32]);
 part left(shape=box,material=home_plaster,at=[-9.25,8.75,0],size=[.5,17.5,32.8],cutaway=left);
 part right(shape=box,material=home_plaster,at=[9.25,8.75,0],size=[.5,17.5,32.8],cutaway=right);
 part back(shape=box,material=home_plaster,at=[0,8.75,16.15],size=[19,17.5,.5],cutaway=back);
 part front_left(shape=box,material=home_brick,at=[-5.5,8.75,-16.4],size=[8,17.5,.5],cutaway=front);
 part front_right(shape=box,material=home_brick,at=[5.5,8.75,-16.4],size=[8,17.5,.5],cutaway=front);
 part lintel(shape=box,material=home_brick,at=[0,12,-16.4],size=[3,11,.5],cutaway=front);
 part ceiling(shape=box,material=home_trim,at=[0,17.7,0],size=[19,.4,32.8],cutaway=roof);
 part upper_floor(shape=box,material=home_floorboards,at=[-3,8.75,0],size=[12,.5,32],cutaway=above);
 part landing(shape=box,material=home_floorboards,at=[6,8.75,13.5],size=[6,.5,5],cutaway=above);
 part roof(shape=prism,material=home_roof,at=[0,20.5,0],size=[19.2,5,34.3],outline=[[0,0],[.5,1],[1,0],[.98,0],[.5,.88],[.02,0]],cutaway=roof);
 part attic(shape=prism,material=home_brick,at=[0,20.2,0],size=[19,4.4,32.8],outline=[[0,0],[1,0],[.5,1]],cutaway=roof);

 repeat bays(index=b,count=2){
  part lower_glass(shape=box,material=home_glass,at=[b*10-5,4.5,-16.7],size=[3.4,4.5,.12],cutaway=front);
  voxels lower_frame(material=home_trim,at=[b*10-5,4.5,-16.8],size=[3.8,4.9,.16],grid=[16,20,1],cutaway=front){fill frame(from=[0,0,0],to=[16,20,1]);cut aperture(from=[2,2,0],to=[14,18,1]);fill mullion(from=[7,2,0],to=[8,18,1]);}
  part upper_glass(shape=box,material=home_glass,at=[b*10-5,13.5,-16.5],size=[3.4,4.5,.12],cutaway=front);
  voxels upper_frame(material=home_trim,at=[b*10-5,13.5,-16.6],size=[3.8,4.9,.16],grid=[16,20,1],cutaway=front){fill frame(from=[0,0,0],to=[16,20,1]);cut aperture(from=[2,2,0],to=[14,18,1]);fill mullion(from=[7,2,0],to=[8,18,1]);}
 }
 part rear_glass(shape=box,material=home_glass,at=[0,13.5,16.5],size=[7,4.5,.12],cutaway=back);
 voxels rear_frame(material=home_trim,at=[0,13.5,16.6],size=[7.5,4.9,.16],grid=[24,20,1],cutaway=back){fill frame(from=[0,0,0],to=[24,20,1]);cut aperture(from=[2,2,0],to=[22,18,1]);fill mullion(from=[11,2,0],to=[12,18,1]);}
 part left_glass(shape=box,material=home_glass,at=[-9.5,4.8,5.4],size=[.12,4,5],cutaway=left);
 part right_glass(shape=box,material=home_glass,at=[9.5,4.8,5.4],size=[.12,4,5],cutaway=right);
 part step(shape=box,material=home_trim,at=[0,.25,-17.4],size=[6,.5,2.4]);
 part open_door(shape=box,material=home_dark,at=[-1.65,3.5,-14.9],size=[.16,6,3],cutaway=front);
 voxels door_frame(material=home_trim,at=[0,3.5,-16.76],size=[3.8,6.8,.18],grid=[20,30,1],cutaway=front){fill surround(from=[0,0,0],to=[20,30,1]);cut aperture(from=[2,0,0],to=[18,27,1]);}
 voxels guard(material=home_wood,at=[3.15,10.25,-2.5],size=[.2,2.5,27],grid=[1,12,27],cutaway=above){fill rail(from=[0,11,0],to=[1,12,27]);repeat posts(index=i,count=3){fill post(from=[0,0,i*13],to=[1,12,i*13+1]);}}
 part pendant(shape=box,material=home_warm_light,at=[0,8.35,0],size=[3,.3,2],cutaway=roof);
 voxels chimney(material=home_brick,at=[6,20.2,6.9],size=[2.4,4.4,2.8],grid=[12,16,12],cutaway=roof){fill shaft(from=[2,0,2],to=[10,14,10]);fill crown(from=[0,14,0],to=[12,16,12]);cut flue(from=[4,14,4],to=[8,16,8]);}
}

object timber_settee(label="Timber settee"){
 measure(kind=bench,axis=x,meters=2.1);
 body(interaction=solid,radius=16,height=15);
 impact(mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
 seat left(at=[-6.5,6.8,1],approach=[-6.5,22],heading_deg=90);
 seat right(at=[6.5,6.8,1],approach=[6.5,22],heading_deg=90);
 fragment frame(){
  part base(shape=box,material=home_wood,at=[0,4,0],size=[30,2,12]);
  part back_rail(shape=box,material=home_wood,at=[0,10,-5.5],size=[30,10,1]);
  repeat legs(index=l,count=2){
   part front(shape=box,material=home_wood,at=[l*26-13,1.5,4.5],size=[2,3,2]);
   part back(shape=box,material=home_wood,at=[l*26-13,1.5,-4.5],size=[2,3,2]);
  }
 }
 repeat cushions(index=c,count=2){fragment cushion(){
  part seat(shape=prism,material=home_cushion,at=[c*14-7,5.9,.5],size=[13.5,1.8,10.5],outline=[[.04,0],[.96,0],[1,.2],[1,.8],[.96,1],[.04,1],[0,.8],[0,.2]]);
  part back(shape=prism,material=home_cushion,at=[c*14-7,10,-4],size=[13.5,8,2],outline=[[.04,0],[.96,0],[1,.08],[1,.92],[.96,1],[.04,1],[0,.92],[0,.08]]);
 }}
 repeat arms(index=a,count=2){fragment arm(){part side(shape=prism,material=home_wood,at=[a*30-15,8,0],size=[2,6,14],outline=[[.08,0],[.92,0],[1,.1],[1,.9],[.92,1],[.08,1],[0,.9],[0,.1]]);}}
}

place house(object=commuter_home,at=[760,760],role=prop);
site home_entry(object=house,kind=home,entry=[0,-18.6],street=work_street,width=12,points=[[760,674]]);
floor upper_room(on=house,at=[-3,9,0],size=[12,32]);
floor upper_landing(on=house,at=[6,9,13.5],size=[6,5]);
place upper_settee(object=timber_settee,at=[748,760],role=prop,floor=upper_room);
place repairer(object=pedestrian,at=[590,740],role=npc,behavior=welcome);
world(size=[4000,2400],spawn=[525,609],heading_deg=0);
road circuit(width=118,points=[[300,590],[660,590],[810,500],[810,220],[660,130],[300,130],[150,220],[150,500]]);

checkpoint start(at=[480,612.5],dir=[1,0],width=100);
checkpoint east(at=[828.75,360],dir=[0,-1],width=100);
checkpoint north(at=[480,107.5],dir=[-1,0],width=100);
checkpoint west(at=[131.25,360],dir=[0,1],width=100);

route work_walk(kind=walk,mode=shuttle,speed=10){point(at=[750,750]);point(at=[750,760]);}
behavior work_routine(start=walk){
 state walk(action=patrol,face=none){on hello(event=near_player,radius=40,to=chat);}
 state chat(action=idle,face=player){on resume(event=far_player,radius=70,to=walk);}
}
place customer(object=pedestrian,route=work_walk,role=npc,behavior=work_routine);
street work_street(width=60,sidewalk=12,points=[[500,638],[850,638]]);
surface plaza(finish=terrain,points=[[530,680],[820,680],[820,816],[530,816]]);
place lunch_bench(object=slatted_bench,at=[690,775],role=prop);
economy(){
 rest home_rest(energy=20,drain_s=.05,recover_s=5,below=25,until=85,seats=[upper_settee,lunch_bench],on=house,grounds=[plaza,upper_room,upper_landing]);
 good bread(label="Bread",food=45);
 good flour(label="Flour");
 good kit(label="Repair kit");
 account fixer(actor=repairer,credits=0,capacity=4,satiety=80,drain_s=0,repair=home_furniture);
 account pocket(rest=home_rest,actor=player,credits=20,capacity=8,satiety=40,drain_s=.05);
 account baker(actor=neighbor,credits=0,capacity=4,satiety=65,drain_s=.05);
 meal bakery_break(good=bread,markets=[corner],on=plaza,eat_s=4,seats=[lunch_bench]);
 account regular(rest=home_rest,actor=customer,credits=20,capacity=4,satiety=65,drain_s=.05,works=[bake],commute=true,on=plaza);
 market corner(label="Corner bakery",actor=neighbor,credits=100,radius=70){
  lot bread_shelf(good=bread,quantity=2,limit=16,price=5);
  lot flour_sack(good=flour,quantity=12,limit=12);
  lot repair_kits(good=kit,quantity=4,limit=4);
 }
 repair home_furniture(label="Repair home seating",market=corner,input=kit,take=1,kind=bench,on=plaza,grounds=[house,upper_room,upper_landing],seconds=2,pay=3,effort=5,dispatch_s=0);
 work bake(label="Bake bread",market=corner,input=flour,take=1,output=bread,make=2,seconds=2,pay=3,effort=12,capacity=1,target=4);
}
