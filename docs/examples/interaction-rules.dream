dream 2;
rule wooden_tables(kind=table,mode=break(speed=90,scatter=62,lift=100,spin=4,lifetime=6,pattern=splinter));
material oak(style=wood,colors=[#92613d,#bd905d]);
material dark(style=wood,colors=[#654632,#92613d]);
component leg(params=[x,z]){
  fragment leg(){
    part leg(shape=box,material=dark,at=[x,12,z],size=[4,24,4]);
    part foot(shape=box,material=dark,at=[x,1,z],size=[6,2,6]);
  }
}
object square_table(label="Square table"){
  measure(kind=table,axis=x,meters=1.6);
  body(interaction=solid,radius=24,height=27);
  fragment top(){part top(shape=box,material=oak,at=[0,25,0],size=[48,4,40]);}
  repeat rows(index=i,count=2){
    repeat legs(index=j,count=2){use leg(component=leg,args=[i*36-18,j*28-14]);}
  }
}
object round_table(label="Round table"){
  measure(kind=table,axis=x,meters=1.2);
  body(interaction=solid,radius=24,height=27);
  fragment top(){part top(shape=cylinder,material=oak,at=[0,25,0],size=[48,4,48]);}
  fragment pedestal(){
    part stem(shape=cylinder,material=dark,at=[0,12,0],size=[6,24,6]);
    part foot(shape=cylinder,material=dark,at=[0,1.5,0],size=[28,3,28]);
  }
}
place market_table(object=square_table,at=[400,300],role=prop);
place garden_table(object=round_table,at=[600,420],role=prop);
