(* Structural grammar only. dream-v2-contract.json supplies command contexts,
   required IDs/fields, field types and allowed constructors. *)
program = "dream", "2", ";", statement, { statement } ;
statement = identifier, [ identifier ], "(", [ fields ], ")",
            ( ";" | "{", { statement }, "}" ) ;
fields = field, { ",", field }, [ "," ] ;
field = identifier, "=", value ;
(* material styles: toon, grain, glow, stripes, cloth, brick, wood, stone.
   Two hex colors: brick face/mortar, wood base/grain, stone base/mineral.
   Pattern dimensions and relief belong to the engine; no shader source/URLs. *)
(* scenario is a top-level bounded logical environment. Its block permits only
   item, location, link, stock, service, agent and objective declarations.
   IDs/references are local to that block; no scripts or general rule callbacks. *)
value = expression | string | color | "true" | "false" | array | constructor ;
array = "[", [ value, { ",", value }, [ "," ] ], "]" ;
(* part(shape=prism) requires outline: 3..24 [X,Y] arrays, each coordinate 0..1,
   full extents 0..1 on both axes, simple closed contour without repeated start.
   The engine extrudes the profile along Z. roll is a part_motion or joint_motion
   constructor; a joint owns one rigid distance-driven mechanism. *)
constructor = identifier, "(", fields, ")" ;
expression = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "/"), unary } ;
unary = ("+" | "-"), unary | primary ;
primary = number | identifier | "(", expression, ")"
        | ("sin" | "cos"), "(", expression, ")" ;
identifier = lower_letter, { lower_letter | digit | "_" } ;
(* Identifier length 1..32; sin/cos/true/false are reserved IDs.
   number: /(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/
   color: /#[0-9a-fA-F]{6}\b/
   string: JSON double-quoted string without literal CR/LF.
   Whitespace and // line comments are ignored. *)

(* A position2 field accepts an XY array or a file-local junction identifier.
   road/street require exactly one points or via field. A route_path block may
   contain named stop anchors; ordinary path blocks accept point/let/repeat only. *)
(* site.kind=airport identifies a connected terminal destination. It adds no
   runway, aircraft, routes or flight controller implicitly. *)

(* furnish/flock are top-level data commands, not loops or executable scripts.
   furnish targets streets XOR sites after module linking; sites require count.
   place.phase_s shifts a declared route clock; all bounds live in the contract. *)

(* daylight is a single optional world-owner declaration. lamp is object-root only;
   material.night is an optional color. All three are bounded data, not scripts. *)

(* voxels is an object/visual command with a voxel_ops block. Its block accepts
   fill/cut/let/repeat. fill/cut use integer half-open from/to cell bounds and
   optional shape=box|ellipsoid. grid and optional chunks are numeric triples;
   semantic validation enforces cell, work, surface and fracture limits. *)

(* Object DSL v2 visual size axes: .1..128; v1 .5..128. Beam endpoint length >= .5. Semantic bounds are enforced after expansion. *)

(* voxel_world is a singleton top-level world-owner construction policy with
   object_cell, ground_cell and height_step numeric fields. See contract bounds.
   It changes all linked render geometry, not physical contact ownership. *)

(* component.params and component.materials declare separate numeric/material
   formals, at most eight unique names combined. use.args and use.materials bind
   exact positional lists. Material actuals resolve in the caller; callees see
   globals and their own explicit bindings, never implicit caller locals. *)
