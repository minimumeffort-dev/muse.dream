(* Structural grammar only. dream-v2-contract.json supplies command contexts,
   required IDs/fields, field types and allowed constructors. *)
program = "dream", "2", ";", statement, { statement } ;
statement = identifier, [ identifier ], "(", [ fields ], ")",
            ( ";" | "{", { statement }, "}" ) ;
fields = field, { ",", field }, [ "," ] ;
field = identifier, "=", value ;
(* material styles: toon, grain, glow, stripes, cloth, brick, wood, stone.
   Two hex colors: brick face/mortar, wood base/grain, stone base/mineral.
   Pattern dimensions and relief belong to the engine; no shader source/URLs. *)
(* scenario is a top-level bounded logical environment. Its block permits only
   item, location, link, stock, service, agent and objective declarations.
   IDs/references are local to that block; no scripts or general rule callbacks. *)
value = expression | string | color | "true" | "false" | array | constructor ;
array = "[", [ value, { ",", value }, [ "," ] ], "]" ;
(* part(shape=prism) requires outline: 3..24 [X,Y] arrays, each coordinate 0..1,
   full extents 0..1 on both axes, simple closed contour without repeated start.
   The engine extrudes the profile along Z. roll is a part_motion or joint_motion
   constructor; a joint owns one rigid distance-driven mechanism.
   stride(axis,deg,length,phase_deg) is joint_motion only: a bounded sinusoidal
   cycle per length local travel units, without physics or a saved clock. *)
constructor = identifier, "(", fields, ")" ;
expression = product, { ("+" | "-"), product } ;
product = unary, { ("*" | "/"), unary } ;
unary = ("+" | "-"), unary | primary ;
primary = number | identifier | "(", expression, ")"
        | ("sin" | "cos"), "(", expression, ")" ;
identifier = lower_letter, { lower_letter | digit | "_" } ;
(* Identifier length 1..32; sin/cos/true/false are reserved IDs.
   number: /(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/
   color: /#[0-9a-fA-F]{6}\b/
   string: JSON double-quoted string without literal CR/LF.
   Whitespace and // line comments are ignored. *)

(* A position2 field accepts an XY array or a file-local junction identifier.
   road/street require exactly one points or via field. A route_path block may
   contain named stop anchors; ordinary path blocks accept point/let/repeat only. *)
(* site.kind=airport identifies a connected terminal destination. It adds no
   runway, aircraft, routes or flight controller implicitly. *)

(* furnish/flock are top-level data commands, not loops or executable scripts.
   furnish targets streets XOR sites after module linking; sites require count.
   place.phase_s shifts a declared route clock; all bounds live in the contract. *)

(* daylight is a single optional world-owner declaration. lamp is object-root only;
   material.night is an optional color. All three are bounded data, not scripts. *)

(* weather is a single optional world-owner declaration with cycle_s,
   rain_start_s, rain_end_s and wet_grip numeric fields. repair.dry is an optional
   boolean, requires weather and guards new starts only. See contract bounds. *)

(* voxels is an object/visual command with a voxel_ops block. Its block accepts
   fill/cut/let/repeat. fill/cut use integer half-open from/to cell bounds and
   optional shape=box|ellipsoid. grid and optional chunks are numeric triples;
   semantic validation enforces cell, work, surface and fracture limits. *)

(* Object DSL v2 visual size axes: .1..128; v1 .5..128. Beam endpoint length >= .5. Semantic bounds are enforced after expansion. *)

(* voxel_world is a singleton top-level world-owner construction policy with
   object_cell, ground_cell and height_step numeric fields. See contract bounds.
   It changes all linked render geometry, not physical contact ownership. *)

(* component.params and component.materials declare separate numeric/material
   formals, at most eight unique names combined. use.args and use.materials bind
   exact positional lists. Material actuals resolve in the caller; callees see
   globals and their own explicit bindings, never implicit caller locals. *)

(* place/furnish motion accepts bounded walk(...) or roam(...) constructors.
   place requires role=ambient and fixed at; motion excludes pose/route/behavior.
   These are data interpreted by the engine, not scripts. See population bounds. *)

(* One economy() block per linked playable world. Its block permits good, account,
   market, station, work, milestone, meal, shift, social, ration, rest, delivery and repair. A market block contains lot declarations. Actor references
   resolve after linking; goods/work/market references belong to the economy.
   Work permits either input/take with a semicolon or an optional recipe block of
   1..4 ingredient(good=ref,take=n) statements, no ingredient IDs. Exactly one
   form, unique input goods, no empty block, no input equal to output. All inputs,
   refund capacities, wage and output room reserve atomically.
   Integer money, stock and conserved transfers are engine-owned, never callbacks. *)

(* place.parked is a boolean on explicit controllable fixed placements.
   furnish.role=controllable emits dormant parking. asset.control adapts an
   existing seat on an isolated validated copy; registry resolution is unchanged. *)

(* repair requires kind=symbol or kinds=[symbol,...], exactly one; a nonempty
   unique list selects measure.kind categories. delivery.price is optional per-unit
   supplier payment, default zero; destination escrows invoice and wage. Repair uses declared convex work grounds; account.repair
   is a bounded engine policy. No generated controller code. *)


(* repair.grounds is an optional list of 1..7 unique surface or placed-interior IDs, excluding on.
   The primary plus extra convex grounds share 4096 local samples. Extra grounds
   use the accepted pedestrian network, with 8192 derived nodes, 32768 directed
   links and 128 saved waypoints. Source/saves never contain graph/controller code. *)


(* world.damage_pool is an optional boolean, default false. True keeps static
   break/topple props instanced, with <=128 pooled template data records and
   <=4096 total placements. Active assemblies/cache templates <=24; active pieces
   and cached fragment meshes <=128. Legacy resident limits remain unchanged.
   A topple without authored fragments compiles one stable rigid fragment.
   Whole impacts accept at most one centered base contact; lamps may use pooled
   whole-object damage and disable their light pool until restored. *)

(* repair.streets optionally lists 1..32 unique existing streets with sidewalks
   >=8 units wide. verge is 0..32, default 24, and requires streets. Matching
   measured-kind contacts near those sidewalks gain bounded dry work approaches,
   clipped away from riding surfaces, the circuit and water. There is no generated
   paving or unpainted-road shortcut. Per service: <=512 street targets and <=2048
   access pieces; existing graph, local-sample and saved-path limits remain. *)

(* Planting constraints: repair.regrow_s is 30..86400 seconds and requires
   kind=tree with centered whole-topple prop targets. seed_scale is 0.1..0.5,
   default .15, only with regrow_s. Growing plants plus planting commitments <=32.
   account.repairs is 1..4 unique refs, exclusive with repair and work; priority
   selects available work, one active commitment. Touching grounds use portals. *)

(* surface.finish is paint|terrain, default paint. Paint requires color; terrain
   forbids it and retains the underlying terrain and cosmetic ground plants.
   Both keep the existing geometry, reservation and walking bounds.
   Optional surface.walkable=true adds convex clear pieces to pedestrian pavement;
   full-width joins to existing pavement, dry/bridge-supported, no rail/runway
   overlap or bridge side entries. Omitted/false remains ground finish only.
   Optional site.label is 1..80 nonblank plain-text characters naming the place
   independently of its reused object. Neither field creates actors or behavior. *)


(* account.deliveries is 1..4 unique ordered delivery refs, compatible with repair
   duties and exclusive with work/player ownership. Delivery on is the receiving
   convex work ground; grounds adds 1..7 unique convex areas excluding on. Couriers
   need stationary non-vendor homes in on and receiving market reach. Supplier
   approaches may use accepted pavement. Validate full walking return trips.
   Pickup intent holds a shared slot without reserving goods or funds; collection
   rechecks player transactions. One cargo reservation, handoff and wage per trip.
   Prepared topology and saved paths retain existing work-navigation bounds. *)

(* contact requires exactly one radius or size=[width,depth]; heading_deg is
   rectangle-only. Circles retain existing bounds; rectangles are upright static
   structures. interior is object-root with a block of 1..4 named portal records.
   part.cutaway and voxels.cutaway tag retained roof/front/back/left/right shell sections. A placed
   interior's object ID may be used in repair/delivery grounds. Existing source,
   geometry and navigation bounds remain unchanged. One ground floor only. *)

(* milestone is economy-local, with label, kind=work|delivery|repair, task and count.
   Optional work.requires and interact-only on.requires reference a milestone.
   account.works is an ordered 1..4 unique job list, exclusive with work and other
   automatic work duties. Only actual completion increments personal history;
   no authored counters, rewards, scripts or controller callbacks. *)

(* meal(good,markets,on,grounds?,eat_s,seats?) and account.meal own bounded walking food trips.
   8 plans, 1..4 ordered markets, eat_s 1..12; food and priced lots required.
   Same finite transactions, pedestrian bounds, paused program and persistent return. *)

(* Object-root seat id(at,approach,heading_deg) describes a static furniture slot.
   1..4 per object, 512 per world; sitting surface 3..9 world units above the
   floor, dry clear 6..40-unit transfer. Shared player/NPC occupancy is saved.
   meal.seats names 1..4 furniture placements; seated meals need humanoid bones. *)

(* market.hours is an optional numeric pair [open_hour,close_hour], daily half-open
   service with midnight wrap. Requires world daylight; simulation time owns
   transactions independently of the visual sky. See the command contract. *)

(* shift(market,rest,on,grounds?,lead_s?) plus account.shift owns physical daily
   staff attendance. Reuses explicit market.hours, stationary person NPC programs,
   body-sized connected pavement and bounded convex grounds. Finish committed
   work, walk out, rest, return early; service waits for actual counter arrival.
   See dream/shifts.md and examples/staff-shifts.dream. *)

(* social(good,seats,on,grounds?,eat_s,cooldown_s?,max_fullness?) and account.social
   connect a stationary complete person NPC to a shared seated meal. Two owned
   portions and an adjacent slot are reserved, then consumed once on completion.
   Interrupted meals refund once; the NPC walks home. Interact-only shared_meals
   gates dialogue using this person's actual completed meal history. Bounds and
   consent rules live in the command contract; no scripts or arbitrary rewards. *)

(* market.owner is an optional economy account reference; sale is an optional
   integer base price 1..1000000, requiring a non-player initial owner. Acquisition
   pays base plus available company cash to that personal seller once. Saved
   ownership permits local conserved deposits/withdrawals, protects commitments
   and does not change actor roles. See examples/business-ownership.dream. *)

(* sport permits an optional block with exactly team home and team away.
   A team is a semicolon statement, role=npc, exactly object or objects.
   team_size counts the home player. members reuses stationary NPC identities;
   roster shares one squad across grounds. keeper/keeper_object are football-only.
   net_depth describes the target-local triangular side/back net. Tactics,
   possession, scoring and input are bounded engine rules, never statements/code. *)

(* Complete worlds: one world; connected streets may omit road/checkpoint.
   An optional circuit requires one road and 2..64 checkpoints. *)

(* station binds a static prop placement: object ref, local XZ at, local XYZ hands,
   on ground and optional grounds. work.station requires matching equipment and
   capacity=1. Two-unit standing reach and one shared claim across recipes;
   NPCs use existing physical work journeys, never authored scripts. See the
   generated command contract for all geometric and navigation bounds. *)
