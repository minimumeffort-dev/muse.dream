dream 1;

// A small vocabulary, shared across seven unrelated silhouettes.
material wood = grain #966c48 #b48c60;
material dark = toon #303c43;
material metal = toon #6f9295;
material cream = toon #eadcbb;
material skin = toon #c58e68;
material jacket = toon #477a86;
material leaf = toon #567b44;
material shell = grain #78844c #a4a261;
material gold = toon #e2ac43;
material crust = grain #b97136 #e2ac62;
material stone = grain #8b928d #737e7c;
material moss = toon #65774b;
material red = toon #ba5d47;

component post(h) {
  part leg box wood at [0, h / 2, 0] size [4, h, 4];
}
component wheel(r) {
  part tire cylinder dark at [0, 0, 0] size [r * 2, 4, r * 2] rotate [90, 0, 0];
  part hub cylinder metal at [0, 0, 2.2] size [r, 1, r] rotate [90, 0, 0];
}
component loaf(length) {
  part bread capsule crust at [0, 6, 0] size [12, length, 12] rotate [0, 0, 90] deform (73, .06);
  repeat cut 3 {
    part score capsule cream at [(cut - 1) * length / 5, 11.7, 0] size [1.4, 6, .8] rotate [90, 0, -25];
  }
}
component blossom() {
  repeat petal 6 {
    let a = petal * 60;
    part petal capsule gold at [cos(a) * 8, sin(a) * 8, 0] size [5, 13, 3] rotate [0, 0, a - 90];
  }
  part seeds sphere crust at [0, 0, 1] size [10, 10, 5];
}

object "Orchard cart" {
  body knockable radius 28 height 44 friction 3;
  repeat side 2 {
    let z = (side * 2 - 1) * 20;
    use wheel(9) at [0, 9, z] rotate [0, side * 180, 0];
    repeat rail 3 {
      part rail box wood at [0, 21 + rail * 6, z] size [44, 4, 3];
    }
    beam handle box wood from [17, 18, z] to [42, 25, z * .75] width 3 depth 3;
  }
  part axle cylinder metal at [0, 9, 0] size [3, 45, 3] rotate [90, 0, 0];
  part bed box wood at [0, 18, 0] size [44, 4, 42];
  repeat end 2 {
    part end box wood at [end * 40 - 20, 29, 0] size [3, 18, 40];
  }
  repeat apple 3 {
    part apple sphere red at [(apple - 1) * 11, 26, 0] size [12, 13, 12] deform (apple * 21 + 4, .09);
    part stem cylinder wood at [(apple - 1) * 11, 33, 0] size [1.2, 3, 1.2];
  }
}

object "Field naturalist" {
  body decor radius 11 height 78;
  repeat side 2 {
    let x = side * 8 - 4;
    part trouser capsule dark at [x, 13, 0] size [6, 23, 7];
    part boot box wood at [x, 3, 2] size [7, 6, 12];
  }
  part coat capsule jacket at [0, 32, 0] size [20, 28, 13];
  part belt box wood at [0, 23, 0] size [20, 3, 14];
  part neck capsule skin at [0, 46, 0] size [6, 8, 6];
  part head sphere skin at [0, 54, 0] size [17, 19, 16];
  part brim cylinder wood at [0, 62, 0] size [29, 2, 25];
  part hat capsule cream at [0, 65, 0] size [18, 10, 17];
  part hatband cylinder wood at [0, 63.5, 0] size [18.5, 3, 17.5];
  part bag box wood at [0, 33, -9] size [17, 21, 8];
  repeat eye 2 {
    part eye sphere dark at [eye * 6 - 3, 55, 7.5] size [2, 2.5, 1.5];
    part binocular cylinder dark at [eye * 7 - 3.5, 32, 10] size [6, 10, 6] rotate [90, 0, 0];
  }
  joint left_shoulder at [-11, 41, 0] rotate [0, 0, -12] {
    beam sleeve capsule jacket from [0, 0, 0] to [0, -15, 0] width 6 depth 6;
    part hand sphere skin at [0, -18, 0] size [6, 7, 6];
  }
  joint right_shoulder at [11, 41, 0] rotate [0, 0, 150] {
    beam sleeve capsule jacket from [0, 0, 0] to [0, -15, 0] width 6 depth 6;
    joint elbow at [0, -15, 0] rotate [0, 0, 20] swing z (22, 2.2, 0) {
      beam forearm capsule skin from [0, 0, 0] to [0, -12, 0] width 5 depth 5;
      part hand sphere skin at [0, -14, 0] size [6, 7, 5];
    }
  }
}

object "Meadow tortoise" {
  body knockable radius 19 height 28 friction 4;
  repeat side 2 {
    repeat end 2 {
      part foot capsule leaf at [end * 20 - 10, 4, side * 24 - 12] size [10, 8, 9] rotate [0, 0, end * 30 - 15];
    }
  }
  part belly sphere cream at [0, 9, 0] size [34, 12, 28];
  part shell sphere shell at [0, 14, 0] size [38, 25, 32] deform (87, .06);
  repeat plate 3 {
    part scute icosphere moss at [(plate - 1) * 10, 25, 0] size [9, 4, 11];
  }
  part tail cone leaf at [-22, 9.5, 0] size [5, 10, 5] rotate [0, 0, 90];
  joint neck at [15, 13, 0] swing y (12, .7, 0) {
    part head capsule leaf at [8, 0, 0] size [10, 18, 11] rotate [0, 0, 90];
    repeat eye 2 {
      part eye sphere dark at [12, 3, eye * 9 - 4.5] size [2.3, 3, 2];
    }
  }
}

object "Bakery basket" {
  ground surface;
  body knockable radius 18 height 26 friction 3;
  part base cylinder wood at [0, 3, 0] size [34, 6, 29];
  repeat ring 3 {
    part rim torus wood at [0, 6 + ring * 3, 0] size [37, 32, 4] rotate [90, 0, 0];
  }
  repeat rib 8 {
    let a = rib * 45;
    beam rib box wood from [cos(a) * 13, 3, sin(a) * 10] to [cos(a) * 17, 10, sin(a) * 14] width 2 depth 2;
  }
  use loaf(30) at [0, 8, -5] rotate [0, 15, 0] scale .8;
  use loaf(28) at [0, 9, 6] rotate [0, -15, 0] scale .8;
}

object "Wild sunflowers" {
  body decor radius 20 height 74;
  repeat flower 3 {
    let h = 40 + flower * 12;
    group at [(flower - 1) * 17, 0, flower * 5 - 5] rotate [0, flower * 35 - 25, 0] {
      beam stem cylinder leaf from [0, 0, 0] to [0, h, 0] width 2 depth 2;
      part leaf capsule leaf at [-5, h * .45, 0] size [5, 15, 2] rotate [0, 0, 55];
      part leaf capsule leaf at [5, h * .65, 0] size [5, 15, 2] rotate [0, 0, -55];
      joint flower at [0, h, 0] swing z (5, 1.1, flower * 60) {
        use blossom();
      }
    }
  }
}

object "Trail cairn" {
  body solid radius 22 height 56;
  repeat layer 4 {
    let width = 40 - layer * 8;
    part rock icosphere stone at [layer - 2, 7 + layer * 10, 0] size [width, 14, width * .8] rotate [0, layer * 37, 0] deform (381 + layer * 87, .23);
  }
  part moss icosphere moss at [-9, 14, 3] size [18, 4, 17] deform (85, .18);
}

object "Wayside bench" {
  body solid radius 28 height 47;
  foundation [60, 42] #68765a;
  repeat side 2 {
    let x = side * 44 - 22;
    use post(22) at [x, 0, -12];
    use post(22) at [x, 0, 12];
    beam brace box metal from [x, 5, -13] to [x, 20, 13] width 2 depth 2;
    beam back_post box wood from [x, 0, -12] to [x, 45, -18] width 4 depth 4;
  }
  repeat slat 4 {
    part seat box wood at [0, 24, -12 + slat * 8] size [60, 4, 6];
  }
  repeat slat 2 {
    part back box wood at [0, 34 + slat * 9, -16 - slat] size [60, 6, 3] rotate [-8, 0, 0];
  }
}
