dream 1;
material teal = toon #448b87;
material red = toon #af5040;
material cream = toon #e6d6b0;
material dark = toon #2c3840;
material steel = toon #a6b7b3;
material glass = toon #83bbc5;
material wood = grain #926745 #b88f60;
material stone = grain #8a928d #737e7c;
material moss = toon #6d8050;
material gold = toon #d5a253;
material skin = toon #c68d65;

component rail_wheel(x,z) {
  part tire cylinder dark at [x,8,z] size [16,4,16] rotate [90,0,0] roll 8;
  part hub cylinder steel at [x,8,z+2] size [7,1,7] rotate [90,0,0];
}
component bicycle_wheel(x) {
  part tire torus dark at [x,10,0] size [20,20,3] roll z 10;
  part rim torus steel at [x,10,0] size [16,16,1] roll z 10;
  repeat spoke 3 {
    part spoke box steel at [x,10,0] size [16,1,1] rotate [0,0,spoke*60] roll z 10;
  }
}
component opening_door() {
  joint door at [36,2,-13] open y (105,100) {
    part panel box teal at [0,18,12] size [3,36,24];
    part window box glass at [2,23,12] size [1,15,17];
    part handle sphere gold at [3,15,21] size [2,2,2];
  }
}

object "Meadow locomotive" {
  body solid radius 30 height 51;
  rideable at [-19,18,0];
  emit steam at [23,51,0] rate 6;
  repeat side 2 {
    repeat axle 3 { use rail_wheel((axle-1)*23,side*24-12); }
    beam rod box steel from [-24,8,side*30-15] to [24,8,side*30-15] width 2 depth 2;
  }
  part chassis box dark at [0,14,0] size [74,7,28];
  part boiler cylinder teal at [10,25,0] size [22,43,22] rotate [0,0,90];
  part nose cylinder steel at [33,25,0] size [20,2,20] rotate [0,0,90];
  part lamp sphere gold at [35,28,0] size [4,5,5];
  part chimney cylinder dark at [23,41,0] size [7,19,7];
  part chimney_cap cylinder dark at [23,49,0] size [10,3,10];
  part cab_back box red at [-32,30,0] size [3,30,28];
  repeat side 2 {
    part cab_side box red at [-22,23,side*26-13] size [23,14,3];
    part cab_post box red at [-11,36,side*26-13] size [3,15,3];
  }
  part roof box dark at [-22,46,0] size [32,4,35];
}

object "Passenger carriage" {
  body solid radius 30 height 50;
  repeat side 2 {
    repeat axle 2 { use rail_wheel(axle*40-20,side*24-12); }
    repeat window 3 {
      part window box glass at [(window-1)*20,32,side*28-14] size [13,13,1];
    }
    part stripe box cream at [0,22,side*28-14] size [69,4,1];
  }
  part chassis box dark at [0,14,0] size [78,5,27];
  part cabin box red at [0,29,0] size [70,27,28];
  part roof capsule cream at [0,44,0] size [7,76,33] rotate [0,0,90];
  repeat end 2 { part coupling box dark at [end*84-42,13,0] size [14,3,4]; }
}

object "Cloudhopper plane" {
  body solid radius 29 height 32;
  rideable at [-9,19,0];
  part fuselage capsule cream at [0,17,0] size [20,69,19] rotate [0,0,90];
  part wings box teal at [3,17,0] size [22,3,92];
  part tailplane box teal at [-29,18,0] size [15,2,34];
  part fin box red at [-27,27,0] size [13,18,3];
  part cockpit sphere glass at [-9,25,0] size [22,12,14];
  part nose cylinder red at [33,17,0] size [16,6,16] rotate [0,0,90];
  part propeller box dark at [37,17,0] size [2,36,3] spin x 160;
  part spinner sphere steel at [39,17,0] size [6,6,6];
  repeat side 2 {
    beam strut cylinder steel from [8,14,side*10-5] to [8,5,side*22-11] width 2 depth 2;
    part wheel cylinder dark at [8,5,side*24-12] size [10,4,10] rotate [90,0,0] roll 5;
  }
  part tail_wheel sphere dark at [-29,6,0] size [5,5,5];
}

object "Willow launch" {
  body solid radius 26 height 38;
  rideable at [18,12,0];
  part hull sphere teal at [0,4,0] size [69,16,31];
  part deck box wood at [0,10,0] size [54,4,24];
  part cabin box cream at [-7,20,0] size [25,18,22];
  part roof box red at [-7,30,0] size [31,4,28];
  part windshield box glass at [6,23,0] size [1,10,17];
  repeat side 2 {
    part window box glass at [-7,23,side*23-11.5] size [16,10,1];
    beam rail cylinder steel from [10,17,side*23-11.5] to [27,17,side*16-8] width 1 depth 1;
    repeat post 2 { part post cylinder steel at [12+post*13,14,side*21-10.5] size [1,7,1]; }
  }
  part seat box red at [17,13,0] size [12,4,13];
  part mast cylinder wood at [-23,26,0] size [2,30,2];
  part pennant box red at [-17,36,0] size [12,8,1];
}

object "Meadow bicycle" {
  body solid radius 20 height 39;
  rideable at [-3,26,0];
  use bicycle_wheel(-19);
  use bicycle_wheel(19);
  beam rear_frame cylinder teal from [-19,10,0] to [-3,12,0] width 2 depth 2;
  beam rear_stay cylinder teal from [-19,10,0] to [-6,25,0] width 2 depth 2;
  beam seat_tube cylinder teal from [-3,12,0] to [-6,25,0] width 2 depth 2;
  beam top_tube cylinder teal from [-6,25,0] to [12,27,0] width 2 depth 2;
  beam down_tube cylinder teal from [-3,12,0] to [12,27,0] width 2 depth 2;
  beam fork cylinder steel from [12,30,0] to [19,10,0] width 2 depth 2;
  part saddle capsule dark at [-6,28,0] size [6,12,4] rotate [0,0,90];
  beam handlebar cylinder dark from [12,32,-8] to [12,32,8] width 2 depth 2;
  part crank cylinder steel at [-3,12,0] size [5,5,5] rotate [90,0,0] roll 10;
}

object "Maple skateboard" {
  body solid radius 14 height 9;
  rideable at [0,8,0];
  part deck capsule wood at [0,7,0] size [3,43,12] rotate [0,0,90];
  part grip capsule dark at [0,8.4,0] size [1,36,10] rotate [0,0,90];
  repeat axle 2 {
    part truck box steel at [axle*26-13,4,0] size [4,3,14];
    repeat side 2 { part wheel cylinder gold at [axle*26-13,3,side*14-7] size [6,3,6] rotate [90,0,0] roll 3; }
  }
}

object "Meadow station" {
  body solid radius 30 height 66;
  emit steam at [-20,78,-15] rate 2;
  contact at [-32,0,-20] radius 8 height 50;
  contact at [-32,0,0] radius 8 height 50;
  contact at [-32,0,20] radius 8 height 50;
  contact at [-18,0,-27] radius 9 height 50;
  contact at [18,0,-27] radius 9 height 50;
  contact at [-18,0,27] radius 9 height 50;
  contact at [18,0,27] radius 9 height 50;
  contact at [0,48,0] radius 39 height 16;
  part rear box cream at [-32,25,0] size [10,50,60];
  repeat side 2 {
    part wall box cream at [0,25,side*54-27] size [72,50,7];
    part window box glass at [0,30,side*62-31] size [22,18,1];
    beam sill box wood from [-13,19,side*64-32] to [13,19,side*64-32] width 3 depth 3;
    part front_post box wood at [35,24,side*45-22.5] size [5,48,15];
  }
  part lintel box wood at [35,44,0] size [5,10,38];
  part roof pyramid red at [0,57,0] size [88,24,76];
  part chimney box stone at [-20,65,-15] size [10,22,10];
  part platform box stone at [48,1,0] size [28,2,72];
  use opening_door();
  part clock sphere cream at [38,46,0] size [2,10,10];
  part clock_hand box dark at [39,47,0] size [1,5,1];
}

object "Lakeside boathouse" {
  body solid radius 30 height 56;
  contact at [-32,0,-20] radius 8 height 42;
  contact at [-32,0,0] radius 8 height 42;
  contact at [-32,0,20] radius 8 height 42;
  contact at [-18,0,-27] radius 9 height 42;
  contact at [18,0,-27] radius 9 height 42;
  contact at [-18,0,27] radius 9 height 42;
  contact at [18,0,27] radius 9 height 42;
  contact at [0,42,0] radius 39 height 12;
  part rear box wood at [-30,21,0] size [8,42,62];
  repeat side 2 { part wall box wood at [0,21,side*55-27.5] size [70,42,6]; }
  part roof pyramid teal at [0,48,0] size [84,20,78];
  part lintel box cream at [35,40,0] size [5,8,52];
  use opening_door();
  part lifering torus red at [38,27,23] size [2,12,12] rotate [0,90,0];
}

object "Mossy passage" {
  body solid radius 30 height 80;
  contact at [-32,0,-54] radius 14 height 64;
  contact at [0,0,-54] radius 14 height 64;
  contact at [32,0,-54] radius 14 height 64;
  contact at [-32,0,54] radius 14 height 64;
  contact at [0,0,54] radius 14 height 64;
  contact at [32,0,54] radius 14 height 64;
  contact at [0,64,-28] radius 38 height 14;
  contact at [0,64,28] radius 38 height 14;
  repeat side 2 {
    part wall box stone at [0,32,side*108-54] size [96,64,26];
    repeat course 3 {
      part seam box dark at [0,16+course*18,side*81-40.5] size [95,1,1];
    }
  }
  part roof box stone at [0,70,0] size [96,14,128];
  part moss icosphere moss at [0,79,0] size [99,12,124] deform (85,.1);
  repeat side 2 {
    part keystone box cream at [side*94-47,67,0] size [5,15,18];
    repeat pillar 2 {
      part cap box cream at [side*94-47,58,pillar*106-53] size [6,9,30];
    }
  }
}

object "Traveler" {
  body decor radius 8 height 42;
  part torso capsule teal at [0,10,0] size [12,20,14];
  part head sphere skin at [0,26,0] size [13,14,13];
  part hair sphere dark at [-1,31,0] size [14,7,14];
  part nose sphere skin at [7,26,0] size [3,3,3];
  repeat side 2 {
    let z=side*10-5;
    part eye sphere dark at [6,28,z*.6] size [2,2,2];
    beam sleeve capsule teal from [0,15,z] to [6,6,z] width 4 depth 4;
    beam forearm capsule skin from [6,6,z] to [13,4,z] width 3 depth 3;
    beam thigh capsule dark from [0,0,z*.6] to [10,-5,z*.6] width 5 depth 5;
    beam shin capsule dark from [10,-5,z*.6] to [13,-14,z*.6] width 4 depth 4;
    part shoe box cream at [15,-14,z*.6] size [8,4,5];
  }
}

route orchard_rail rail loop speed 72 wait 4 {
  repeat i 24 {
    let a=-90+i*15;
    point [1300+cos(a)*260,1960+sin(a)*170];
  }
}
route meadow_cycle path loop speed 35 wait 6 {
  point [1065,1425]; point [1100,1460]; point [1080,1520];
  point [1020,1530]; point [980,1490]; point [1000,1430];
}
route village_skate path loop speed 45 wait 2 {
  point [810,1595]; point [760,1650]; point [700,1600]; point [730,1555];
}
route lake_trip water loop speed 40 wait 5 {
  repeat i 20 { let a=180+i*18; point [2900+cos(a)*65,2410+sin(a)*90]; }
}
route cloud_trip air loop speed 115 altitude 180 wait 6 {
  point [1580,1690]; point [1800,1690]; point [2250,1900]; point [2400,2400];
  point [2080,2700]; point [1570,2600]; point [1400,2150];
}
watercourse willow_river level 0 depth 8 bank 32 color #237e8c flow [0,24] {
  point [1930,1050,320]; point [1970,1260,140]; point [1980,1480,150];
  point [1920,1740,150]; point [1830,2010,420];
}
place meadow_train "Meadow locomotive" on orchard_rail scale 1.1;
place meadow_coach "Passenger carriage" on orchard_rail offset 94 scale 1.1;
place meadow_plane "Cloudhopper plane" on cloud_trip scale 1.1;
place lake_boat "Willow launch" on lake_trip scale 1.1;
place village_bike "Meadow bicycle" on meadow_cycle scale 1.2;
place village_skateboard "Maple skateboard" on village_skate scale 1.3;
place meadow_station "Meadow station" at [1470,1660] scale 1.3 heading 90;
place lake_boathouse "Lakeside boathouse" at [2680,2370] scale 1.3;
place rail_passage "Mossy passage" at [1560,1960] scale 1.5 heading 90;
