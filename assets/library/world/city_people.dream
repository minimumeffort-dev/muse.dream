 measure(kind=person,axis=y,meters=1.72);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[1,0,0],materials=[home_kit,skin_warm,skin_warm,dark,white]);
 mount head(bone=spine){use hair(component=ponytail,materials=[hair]);use band(component=headband,materials=[white]);}
