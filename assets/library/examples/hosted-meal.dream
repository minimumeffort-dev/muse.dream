dream 2;
material teal(style=toon,colors=[#297f88,#24616b]);
material skin(style=toon,colors=[#c59774,#a97655]);
material dark(style=toon,colors=[#303d48,#222c36]);
material cream(style=toon,colors=[#eee8d9,#c9c0ae]);
material wood(style=toon,colors=[#96714d,#6e503a]);
material dark_wood(style=wood,colors=[#53412e,#413325]);
material steel(style=toon,colors=[#737d7e,#49545b]);
object slatted_bench(label="Slatted park bench"){
  measure(kind=bench,axis=x,meters=1.8);
  body(interaction=solid,radius=28,height=31);
  seat left(at=[-13,18,12],approach=[-13,48],heading_deg=90);
  seat right(at=[13,18,12],approach=[13,48],heading_deg=90);
  impact(mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
  repeat slats(index=i,count=4){
    fragment plank(){voxels seat(material=wood,at=[0,16,-12+i*8],size=[60,4,6],grid=[30,2,3]){fill board(from=[0,0,0],to=[30,2,3]);}}
  }
  repeat supports(index=i,count=2){
    fragment frame(){
      voxels leg_front(material=dark_wood,at=[i*44-22,6.5,12],size=[5,13,6],grid=[2,6,3]){fill board(from=[0,0,0],to=[2,6,3]);}
      voxels leg_back(material=dark_wood,at=[i*44-22,15,-13],size=[5,30,6],grid=[2,15,3]){fill board(from=[0,0,0],to=[2,15,3]);}
      voxels brace(material=dark_wood,at=[i*44-22,12,0],size=[6,4,29],grid=[3,2,14]){fill board(from=[0,0,0],to=[3,2,14]);}
      voxels armrest(material=wood,at=[i*44-22,24,0],size=[5,3,29],grid=[2,2,14]){fill board(from=[0,0,0],to=[2,2,14]);}
      voxels arm_support(material=dark_wood,at=[i*44-22,20,12],size=[3,8,3],grid=[2,4,2]){fill board(from=[0,0,0],to=[2,4,2]);}
    }
  }
  fragment back(){
    voxels upper(material=wood,at=[0,27,-16],size=[60,6,4],grid=[30,3,2]){fill board(from=[0,0,0],to=[30,3,2]);}
    voxels lower(material=wood,at=[0,21,-16],size=[60,6,4],grid=[30,3,2]){fill board(from=[0,0,0],to=[30,3,2]);}
      repeat bolts(index=b,count=2){part bolt(shape=sphere,material=steel,at=[b*44-22,27,-13.7],size=[1,1,1]);}
  }
}
