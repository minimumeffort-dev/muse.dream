dream 2;
material brick(style=grain,colors=[#b17459,#985c48]);
material redbrick(style=grain,colors=[#9e6053,#bd8170]);
material plaster(style=toon,colors=[#ddd1b9,#c5b69a]);
material blue(style=toon,colors=[#9aadaf,#758e98]);
material ochre(style=toon,colors=[#d4b378,#b9955f]);
material glass(style=toon,colors=[#6c929d,#42616f]);
material roof(style=toon,colors=[#535b64,#3b4753]);
material tile(style=toon,colors=[#aa6b50,#864d3e]);
material trim(style=toon,colors=[#e5decd,#c5bfae]);
material wood(style=grain,colors=[#805c40,#aa815a]);
material dark(style=toon,colors=[#35464c,#28363e]);
material green(style=toon,colors=[#5e7c73,#405d55]);
material sign(style=toon,colors=[#e4b948,#c79435]);
material airport_glass(style=toon,colors=[#7ba5b2,#456a7c],night=#e6bd83);
object car(label="Sketch car"){
 measure(kind=car,axis=x,meters=3.5);
 body(interaction=solid,radius=11,height=14);
 part chassis(shape=box,material=brick,at=[0,5,0],size=[35,10,17]);
 part cab(shape=box,material=glass,at=[-4,12,0],size=[14,8,15]);
}
object shelter(label="Bus shelter"){
 measure(kind=custom,axis=y,meters=2.5);
 body(interaction=decor,radius=4,height=25);
 part roof(shape=box,material=roof,at=[0,24,0],size=[28,2,10]);
 repeat posts(index=p,count=2){part post(shape=box,material=trim,at=[p*24-12,12,0],size=[1,24,1]);}
}
object bus(label="Neighborhood bus"){
 measure(kind=bus,axis=x,meters=7.2);
 body(interaction=solid,radius=14,height=24);
 contact shell_0(at=[-25,0,0],radius=11,height=24);
 contact shell_1(at=[-15,0,0],radius=11,height=24);
 contact shell_2(at=[-5,0,0],radius=11,height=24);
 contact shell_3(at=[5,0,0],radius=11,height=24);
 contact shell_4(at=[15,0,0],radius=11,height=24);
 contact shell_5(at=[25,0,0],radius=11,height=24);
 part shell(shape=box,material=blue,at=[0,12,0],size=[72,24,22]);
 part windows(shape=box,material=glass,at=[0,17,-11.2],size=[60,8,.5]);
 part roof(shape=box,material=trim,at=[0,23,0],size=[70,2,22]);
}
object east_medical_center(label="Eastbank medical center"){
 measure(kind=building,axis=y,meters=9);
 body(interaction=solid,radius=30,height=30);
 foundation(size=[66,44],color=#a6aaa0);
 contact cell_0(at=[-24,0,-10],radius=13,height=28);
 contact cell_1(at=[-8,0,-10],radius=13,height=28);
 contact cell_2(at=[8,0,-10],radius=13,height=28);
 contact cell_3(at=[24,0,-10],radius=13,height=28);
 contact cell_4(at=[-24,0,10],radius=13,height=28);
 contact cell_5(at=[-8,0,10],radius=13,height=28);
 contact cell_6(at=[8,0,10],radius=13,height=28);
 contact cell_7(at=[24,0,10],radius=13,height=28);
 part walls(shape=box,material=plaster,at=[0,14,0],size=[64,28,40]);
 part roof(shape=box,material=green,at=[0,29,0],size=[66,2,44]);
 part entry_block(shape=box,material=blue,at=[-18,9,-23],size=[22,18,10]);
 part entry_roof(shape=box,material=roof,at=[-18,18.5,-23],size=[24,1,12]);
 part doors(shape=box,material=glass,at=[-18,5,-28.2],size=[9,10,.6]);
 part entry_step(shape=box,material=trim,at=[-18,.25,-29],size=[14,.5,4]);
 repeat bays(index=i,count=4){
  part upstairs(shape=box,material=glass,at=[i*15-22.5,22,-20.1],size=[11,6,.5]);
  part rear(shape=box,material=glass,at=[i*15-22.5,14,20.1],size=[11,7,.5]);
 }
 part ground_window(shape=box,material=glass,at=[14,10,-20.1],size=[20,7,.5]);
 part cross_back(shape=box,material=green,at=[-18,14,-28.3],size=[7,5,.6]);
 part cross_vertical(shape=box,material=trim,at=[-18,14,-28.7],size=[1,3,.5]);
 part cross_horizontal(shape=box,material=trim,at=[-18,14,-28.7],size=[3,1,.5]);
}
