dream 2;
material home_brick(style=brick,colors=[#a96f55,#bcb1a0]);
material home_plaster(style=toon,colors=[#ddd1b9,#c5b69a]);
material home_glass(style=toon,colors=[#6c929d,#42616f],night=#edc590);
material home_roof(style=toon,colors=[#535b64,#3b4753]);
material home_trim(style=toon,colors=[#e5decd,#c5bfae]);
material home_wood(style=wood,colors=[#805c40,#aa815a]);
material home_dark(style=toon,colors=[#35464c,#28363e]);
material home_floorboards(style=wood,colors=[#c4aa83,#9b805d]);
material home_cushion(style=toon,colors=[#70887a,#50695e]);
material home_warm_light(style=toon,colors=[#f2d6a0,#e2c48c],night=#f6ce84);
object commuter_home(label="Commuter's terrace"){
 measure(kind=building,axis=y,meters=9);
 body(interaction=solid,radius=9.5,height=23);
 foundation(size=[19.4,34.8],color=#9e9d8c);
 lamp(at=[0,8.3,0],radius=20,color=#ffd69a);
 interior(at=[0,.5,0],size=[18,8,32]){portal front(side=front,offset=0,width=3,height=6);}
 contact c_floor(at=[0,0,0],size=[18,32],height=.5);
 contact c_left(at=[-9.25,0,0],size=[.5,32.8],height=8.5);
 contact c_right(at=[9.25,0,0],size=[.5,32.8],height=8.5);
 contact c_back(at=[0,0,16.15],size=[19,.5],height=8.5);
 contact c_front_left(at=[-5.5,0,-16.4],size=[8,.5],height=8.5);
 contact c_front_right(at=[5.5,0,-16.4],size=[8,.5],height=8.5);
 contact c_lintel(at=[0,6.5,-16.4],size=[3,.5],height=2);
 contact c_upper(at=[0,8.5,0],size=[19,32.8],height=14.5);
 part floor(shape=box,material=home_floorboards,at=[0,.25,0],size=[18,.5,32]);
 part left(shape=box,material=home_plaster,at=[-9.25,4.25,0],size=[.5,8.5,32.8],cutaway=left);
 part right(shape=box,material=home_plaster,at=[9.25,4.25,0],size=[.5,8.5,32.8],cutaway=right);
 part back(shape=box,material=home_plaster,at=[0,4.25,16.15],size=[19,8.5,.5],cutaway=back);
 part front_left(shape=box,material=home_brick,at=[-5.5,4.25,-16.4],size=[8,8.5,.5],cutaway=front);
 part front_right(shape=box,material=home_brick,at=[5.5,4.25,-16.4],size=[8,8.5,.5],cutaway=front);
 part lintel(shape=box,material=home_brick,at=[0,7.5,-16.4],size=[3,2,.5],cutaway=front);
 part ceiling(shape=box,material=home_trim,at=[0,8.7,0],size=[19,.4,32.8],cutaway=roof);
 part upper(shape=box,material=home_brick,at=[0,13.5,0],size=[19,9,32.8],cutaway=roof);
 part roof(shape=prism,material=home_roof,at=[0,20.5,0],size=[19.2,5,34.3],outline=[[0,0],[.5,1],[1,0],[.98,0],[.5,.88],[.02,0]],cutaway=roof);
 part attic(shape=prism,material=home_brick,at=[0,20.2,0],size=[19,4.4,32.8],outline=[[0,0],[1,0],[.5,1]],cutaway=roof);
 part eaves(shape=box,material=home_trim,at=[0,17.75,0],size=[19.2,.5,34.3],cutaway=roof);
 repeat bays(index=b,count=2){
  part lower_glass(shape=box,material=home_glass,at=[b*10-5,4.5,-16.7],size=[3.4,4.5,.12],cutaway=front);
  voxels lower_frame(material=home_trim,at=[b*10-5,4.5,-16.8],size=[3.8,4.9,.16],grid=[16,20,1],cutaway=front){fill frame(from=[0,0,0],to=[16,20,1]);cut aperture(from=[2,2,0],to=[14,18,1]);fill mullion(from=[7,2,0],to=[8,18,1]);}
  part upper_glass(shape=box,material=home_glass,at=[b*10-5,13.5,-16.5],size=[3.4,4.5,.12],cutaway=roof);
  voxels upper_frame(material=home_trim,at=[b*10-5,13.5,-16.6],size=[3.8,4.9,.16],grid=[16,20,1],cutaway=roof){fill frame(from=[0,0,0],to=[16,20,1]);cut aperture(from=[2,2,0],to=[14,18,1]);fill mullion(from=[7,2,0],to=[8,18,1]);}
 }
 part rear_glass(shape=box,material=home_glass,at=[0,13.5,16.5],size=[7,4.5,.12],cutaway=roof);
 voxels rear_frame(material=home_trim,at=[0,13.5,16.6],size=[7.5,4.9,.16],grid=[24,20,1],cutaway=roof){fill frame(from=[0,0,0],to=[24,20,1]);cut aperture(from=[2,2,0],to=[22,18,1]);fill mullion(from=[11,2,0],to=[12,18,1]);}
 part left_glass(shape=box,material=home_glass,at=[-9.5,4.8,5.4],size=[.12,4,5],cutaway=left);
 voxels left_frame(material=home_trim,at=[-9.65,4.8,5.4],size=[.16,4.5,5.5],grid=[1,20,20],cutaway=left){fill surround(from=[0,0,0],to=[1,20,20]);cut aperture(from=[0,2,2],to=[1,18,18]);}
 part right_glass(shape=box,material=home_glass,at=[9.5,4.8,5.4],size=[.12,4,5],cutaway=right);
 voxels right_frame(material=home_trim,at=[9.65,4.8,5.4],size=[.16,4.5,5.5],grid=[1,20,20],cutaway=right){fill surround(from=[0,0,0],to=[1,20,20]);cut aperture(from=[0,2,2],to=[1,18,18]);}
 part step(shape=box,material=home_trim,at=[0,.25,-17.4],size=[6,.5,2.4]);
 part open_door(shape=box,material=home_dark,at=[-1.65,3.5,-14.9],size=[.16,6,3],cutaway=front);
 voxels door_frame(material=home_trim,at=[0,3.5,-16.76],size=[3.8,6.8,.18],grid=[20,30,1],cutaway=front){fill surround(from=[0,0,0],to=[20,30,1]);cut aperture(from=[2,0,0],to=[18,27,1]);}
 part pendant(shape=box,material=home_warm_light,at=[0,8.35,0],size=[3,.3,2],cutaway=roof);
 voxels chimney(material=home_brick,at=[6,20.2,6.9],size=[2.4,4.4,2.8],grid=[12,16,12],cutaway=roof){fill shaft(from=[2,0,2],to=[10,14,10]);fill crown(from=[0,14,0],to=[12,16,12]);cut flue(from=[4,14,4],to=[8,16,8]);}
}
