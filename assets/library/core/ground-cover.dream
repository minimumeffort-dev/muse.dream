dream 2;
material grass(style=toon,colors=[#557d4a,#557d4a]);
material stem(style=toon,colors=[#456749,#456749]);
material petal(style=toon,colors=[#ffffff,#ffffff]);
material pollen(style=toon,colors=[#d9aa45,#d9aa45]);
component rooted_grass(params=[height,width]){
 part blade(shape=prism,material=grass,at=[width/2,height/2,0],size=[width,height,.14],outline=[[0,0],[.55,.3],[1,1],[.33,.72]]);
}
component grass_cluster(){
 repeat blades(index=b,count=3){use blade(component=rooted_grass,args=[4.5-b*.7,1.4-b*.2],rot_deg=[0,b*137,0]);}
}
component meadow_flower(){
 part stalk(shape=prism,material=stem,at=[0,3.2,0],size=[.22,6.4,.18],outline=[[0,0],[1,0],[1,1],[0,1]]);
 repeat leaves(index=l,count=2){group side(rot_deg=[0,l*180,0]){part leaf(shape=prism,material=grass,at=[cos(25)*.6,2.2+l+sin(25)*.6,0],size=[1.2,.8,.12],rot_deg=[0,0,25],outline=[[0,.5],[1,1],[.55,0]]);}}
 part petals(shape=prism,material=petal,at=[0,6.4,0],size=[3.6,3.6,.14],rot_deg=[90,0,0],outline=[[0.92058489,0.4472136],[1,0.61803399],[0.84026032,0.70714935],[0.59888544,0.59032195],[0.62996788,0.86779849],[0.5,1],[0.37003212,0.86779849],[0.40111456,0.59032195],[0.15973968,0.70714935],[0,0.61803399],[0.07941511,0.4472136],[0.34,0.39255107],[0.15973968,0.18727784],[0.19098301,0],[0.37003212,0.02662871],[0.5,0.27032195],[0.62996788,0.02662871],[0.80901699,0],[0.84026032,0.18727784],[0.66,0.39255107]]);
 part center(shape=prism,material=pollen,at=[0,6.45,0],size=[1,1,.3],rot_deg=[90,0,0],outline=[[.25,0],[.75,0],[1,.5],[.75,1],[.25,1],[0,.5]]);
}
object grass_sprig(label="Ground-cover grass"){
 measure(kind=custom,axis=y,meters=.45);
 body(interaction=decor,radius=4,height=5);
 use grass(component=grass_cluster);
}
object meadow_bloom(label="Ground-cover flower"){
 measure(kind=custom,axis=y,meters=.66);
 body(interaction=decor,radius=4,height=7);
 use flower(component=meadow_flower);
}
object planted_pair(label="Ground-cover pairing"){
 measure(kind=custom,axis=y,meters=.66);
 body(interaction=decor,radius=4,height=7);
 use grass(component=grass_cluster);
 use flower(component=meadow_flower);
}
