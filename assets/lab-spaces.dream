dream 2;
material wall(style=toon,colors=[#d5d0bd,#b6b3a5]);
material steel(style=toon,colors=[#617a85,#465c68]);
material dark(style=toon,colors=[#35434b,#29343b]);
material floor(style=toon,colors=[#b8b4a4,#a4a393]);
material wood(style=wood,colors=[#aa8055,#c29b6b]);
material paper(style=toon,colors=[#eee6ce,#d6cbb0]);
material red(style=toon,colors=[#b7654b,#94503b]);
material blue(style=toon,colors=[#527c96,#365d77]);
material green(style=toon,colors=[#4b7160,#375446]);
material carton(style=toon,colors=[#c9975f,#af7c49]);
material tape(style=toon,colors=[#e5ca8c,#c9ad73]);
component rack(params=[]){
  repeat posts(index=p,count=2){part upright(shape=box,material=steel,at=[p*20-10,10,0],size=[1,20,7]);}
  repeat levels(index=l,count=3){
    part shelf(shape=box,material=wood,at=[0,l*7+2,0],size=[22,1,8]);
    repeat boxes(index=b,count=3){part box(shape=box,material=carton,at=[b*6-6,l*7+4.5,0],size=[5,4,6]);}
  }
}
component bookshelf(params=[]){
  voxels frame(material=wood,at=[0,8,0],size=[15,16,5],grid=[30,32,4]){
    fill left(from=[0,0,0],to=[1,32,4]);fill right(from=[29,0,0],to=[30,32,4]);
    repeat levels(index=l,count=3){fill shelf(from=[0,l*10,0],to=[30,l*10+1,4]);}
  }
  voxels books(material=blue,at=[0,8,0],size=[15,16,5],grid=[30,32,4]){
    repeat levels(index=l,count=3){repeat books(index=b,count=5){fill book(from=[b*5+3,l*10+1,1],to=[b*5+6,l*10+8,3]);}}
  }
  voxels spines(material=red,at=[0,8,0],size=[15,16,5],grid=[30,32,4]){
    repeat levels(index=l,count=3){fill end_book(from=[26,l*10+1,1],to=[28,l*10+8,3]);}
  }
}
component desk(params=[]){
  part top(shape=box,material=wood,at=[0,5,0],size=[7,.7,5]);
  voxels legs(material=dark,at=[0,2.5,2],size=[7,5,8],grid=[14,10,16]){
    repeat sides(index=s,count=2){
      fill desk_front(from=[s*10+1,0,1],to=[s*10+2,10,2]);
      fill desk_back(from=[s*10+1,0,7],to=[s*10+2,10,8]);
      fill chair(from=[s*6+3,0,10],to=[s*6+4,5,15]);
    }
  }
  part seat(shape=box,material=blue,at=[0,2.8,4.2],size=[4,.6,3.5]);
  part back(shape=box,material=blue,at=[0,4.8,5.7],size=[4,3.5,.5]);
}
object warehouse(label="Receiving warehouse"){
  measure(kind=building,axis=y,meters=7);
  body(interaction=decor,radius=25,height=28);
  part slab(shape=box,material=floor,at=[0,.5,0],size=[50,1,34]);
  part left(shape=box,material=wall,at=[-24,12,0],size=[2,24,32]);
  part right(shape=box,material=wall,at=[24,12,0],size=[2,24,32]);
  part rear(shape=box,material=wall,at=[0,12,15],size=[46,24,2]);
  part roof(shape=box,material=steel,at=[0,25,0],size=[52,2,36]);
  repeat piers(index=p,count=2){part pier(shape=box,material=wall,at=[p*38-19,12,-15],size=[10,24,2]);}
  part lintel(shape=box,material=wall,at=[0,22,-15],size=[28,4,2]);
  repeat shutter(index=s,count=3){part slat(shape=box,material=steel,at=[0,s*1.5+18,-15.2],size=[28,1.2,.7]);}
  part dock(shape=box,material=floor,at=[0,.8,-20],size=[30,1.6,8]);
  repeat guards(index=g,count=2){part guard(shape=cylinder,material=red,at=[g*28-14,2.5,-22],size=[1,5,1]);}
  use stock(component=rack,at=[0,0,9]);
}
object stockroom(label="Stockroom racks"){
  measure(kind=building,axis=y,meters=3.5);
  body(interaction=decor,radius=25,height=22);
  part slab(shape=box,material=floor,at=[0,.3,0],size=[52,.6,30]);
  part rear(shape=box,material=wall,at=[0,11,14],size=[52,22,1]);
  repeat racks(index=r,count=2){use shelves(component=rack,at=[r*26-13,0,9]);}
  repeat rails(index=s,count=2){part side(shape=box,material=steel,at=[s*51-25.5,1.5,-1],size=[1,3,28]);}
}
object library(label="Learning library"){
  measure(kind=building,axis=y,meters=4);
  body(interaction=decor,radius=22,height=22);
  part slab(shape=box,material=floor,at=[0,.3,0],size=[48,.6,32]);
  part rear(shape=box,material=wall,at=[0,11,15],size=[48,22,1]);
  repeat ends(index=e,count=2){part wall(shape=box,material=wall,at=[e*47-23.5,6,0],size=[1,12,30]);}
  repeat shelves(index=s,count=3){use books(component=bookshelf,at=[s*15-15,0,10]);}
  part counter(shape=box,material=wood,at=[0,4,-7],size=[24,8,5]);
  part books(shape=box,material=red,at=[-6,8.6,-7],size=[5,1.2,3]);
  part pages(shape=box,material=paper,at=[-6,8.6,-7.1],size=[4.7,.8,3]);
}
object classroom(label="Classroom"){
  measure(kind=building,axis=y,meters=3.5);
  body(interaction=decor,radius=23,height=21);
  part floor(shape=box,material=floor,at=[0,.3,0],size=[50,.6,38]);
  part rear(shape=box,material=wall,at=[0,10,18.5],size=[50,20,1]);
  part board_frame(shape=box,material=wood,at=[0,12,17.7],size=[25,10,.8]);
  part board(shape=box,material=green,at=[0,12,17.2],size=[23,8,.3]);
  repeat rows(index=r,count=2){repeat columns(index=c,count=3){use desk(component=desk,at=[c*13-13,.6,r*11-8],rot_deg=[0,180,0]);}}
}
object parcel(label="Stock carton"){
  measure(kind=custom,axis=x,meters=.45);body(interaction=decor,radius=5,height=8);
  part box(shape=box,material=carton,at=[0,4,0],size=[10,8,8]);
  part tape(shape=box,material=tape,at=[0,4.05,0],size=[2,8.2,8.2]);
}
object book(label="Lesson pack"){
  measure(kind=custom,axis=x,meters=.32);body(interaction=decor,radius=5,height=4);
  part cover(shape=box,material=blue,at=[0,1,0],size=[10,2,7]);
  part pages(shape=box,material=paper,at=[.15,1,-.15],size=[9.7,1.4,6.7]);
  part spine(shape=box,material=blue,at=[-4.8,1,0],size=[.4,2,7]);
}
