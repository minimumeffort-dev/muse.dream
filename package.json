{
  "name": "muse-dream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playable worlds described in Dream 2. Paper-to-world mock prototype with Three.js.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dream": "node scripts/dream.mjs",
    "docs:build": "node scripts/docs.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "^0.170.0",
    "marked": "15.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
