{
  "name": "dreams-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node render-workspace.mjs && vite --config vite.config.ts",
    "build": "node render-workspace.mjs && tsc --noEmit -p tsconfig.json && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "docs:build": "node scripts/docs.mjs",
    "agent:host": "node scripts/agent-host.mjs",
    "agent:mock": "node scripts/mock-agent.mjs"
  },
  "dependencies": {
    "three": "0.170.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.170.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7",
    "marked": "15.0.12"
  }
}
