dream 2;
material teal(style=toon,colors=[#448b87,#448b87]);
material red(style=toon,colors=[#af5040,#af5040]);
material cream(style=toon,colors=[#e6d6b0,#e6d6b0]);
material dark(style=toon,colors=[#2c3840,#2c3840]);
material steel(style=toon,colors=[#a6b7b3,#a6b7b3]);
material glass(style=toon,colors=[#83bbc5,#83bbc5]);
material wood(style=wood,colors=[#926745,#b88f60]);
material stone(style=grain,colors=[#8a928d,#737e7c]);
material moss(style=toon,colors=[#6d8050,#6d8050]);
material gold(style=toon,colors=[#d5a253,#d5a253]);
material skin(style=toon,colors=[#c68d65,#c68d65]);
component rail_wheel(params=[x,z]){
  part tire(shape=cylinder,material=dark,at=[x,8,z],size=[16,4,16],rot_deg=[90,0,0],motion=roll(axis=y,radius=8));
  part hub(shape=cylinder,material=steel,at=[x,8,z+2],size=[7,1,7],rot_deg=[90,0,0]);
}
component bicycle_wheel(params=[x]){
  part tire(shape=torus,material=dark,at=[x,10,0],size=[20,20,3],rot_deg=[0,180,0],motion=roll(axis=z,radius=10));
  part rim(shape=torus,material=steel,at=[x,10,0],size=[16,16,1],rot_deg=[0,180,0],motion=roll(axis=z,radius=10));
  part axle(shape=cylinder,material=steel,at=[x,10,0],size=[2.5,5.5,2.5],rot_deg=[-90,0,0],motion=roll(axis=y,radius=10));
  repeat spokes(index=i,count=2){part spoke(shape=box,material=steel,at=[x,10,0],size=[16,.5,.5],rot_deg=[0,180,i*90],motion=roll(axis=z,radius=10));}
}
component opening_door(params=[]){
  joint door(at=[36,2,-13],motion=open(axis=y,deg=105,radius=100)){
    part panel(shape=box,material=teal,at=[0,18,12],size=[3,36,24]);
    part window(shape=box,material=glass,at=[2,23,12],size=[1,15,17]);
    part handle(shape=sphere,material=gold,at=[3,15,21],size=[2,2,2]);
  }
}
object meadow_locomotive(label="Meadow locomotive"){
  measure(kind=train,axis=x,meters=10);
  body(interaction=solid,radius=22,height=51);
  rideable(at=[-19,18,0]);
  emit(kind=steam,at=[23,51,0],rate_s=6);
  repeat repeat_side(index=side,count=2){
    repeat repeat_axle(index=axle,count=3){
      use rail_wheel(component=rail_wheel,args=[(axle-1)*23,side*24-12]);
    }
    beam rod(shape=box,material=steel,from=[-24,8,side*30-15],to=[24,8,side*30-15],width=2,depth=2);
  }
  part chassis(shape=box,material=dark,at=[0,14,0],size=[74,7,28]);
  part boiler(shape=cylinder,material=teal,at=[10,25,0],size=[22,43,22],rot_deg=[0,0,90]);
  part nose(shape=cylinder,material=steel,at=[33,25,0],size=[20,2,20],rot_deg=[0,0,90]);
  part lamp(shape=sphere,material=gold,at=[35,28,0],size=[4,5,5]);
  part chimney(shape=cylinder,material=dark,at=[23,41,0],size=[7,19,7]);
  part chimney_cap(shape=cylinder,material=dark,at=[23,49,0],size=[10,3,10]);
  part cab_back(shape=box,material=red,at=[-32,30,0],size=[3,30,28]);
  repeat repeat_side_2(index=side,count=2){
    part cab_side(shape=box,material=red,at=[-22,23,side*26-13],size=[23,14,3]);
    part cab_post(shape=box,material=red,at=[-11,36,side*26-13],size=[3,15,3]);
  }
  part roof(shape=box,material=dark,at=[-22,46,0],size=[32,4,35]);
  repeat boiler_bands(index=b,count=2){part band(shape=torus,material=steel,at=[b*20+1,25,0],size=[23,23,1.5],rot_deg=[0,90,0]);}
  repeat cab_glass(index=s,count=2){part window(shape=box,material=glass,at=[-22,36,s*26-13],size=[16,11,.5]);}
  part chimney_foot(shape=cylinder,material=dark,at=[23,33,0],size=[11,3,11]);
  part smokebox_door(shape=cylinder,material=dark,at=[34.3,25,0],size=[16,.6,16],rot_deg=[0,0,90]);
}
object passenger_carriage(label="Passenger carriage"){
  measure(kind=train,axis=x,meters=8);
  body(interaction=solid,radius=30,height=50);
  repeat repeat_side(index=side,count=2){
    repeat repeat_axle(index=axle,count=2){
      use rail_wheel(component=rail_wheel,args=[axle*40-20,side*24-12]);
    }
    repeat repeat_window(index=window,count=3){
      part window(shape=box,material=glass,at=[(window-1)*20,32,side*28-14],size=[13,13,1]);
      part divider(shape=box,material=cream,at=[(window-1)*20,32,side*29-14.5],size=[.7,13,.5]);
    }
    part stripe(shape=box,material=cream,at=[0,22,side*28-14],size=[69,4,1]);
  }
  part chassis(shape=box,material=dark,at=[0,14,0],size=[78,5,27]);
  part cabin(shape=box,material=red,at=[0,29,0],size=[70,27,28]);
  part roof(shape=capsule,material=cream,at=[0,44,0],size=[7,76,33],rot_deg=[0,0,90]);
  repeat repeat_end(index=end,count=2){
    part coupling(shape=box,material=dark,at=[end*84-42,13,0],size=[14,3,4]);
  }
  repeat ends(index=e,count=2){part end_door(shape=box,material=wood,at=[e*71-35.5,28,0],size=[.5,22,10]);}
  repeat vents(index=v,count=2){part vent(shape=box,material=steel,at=[v*34-17,46.5,0],size=[5,1,8]);}
}
object cloudhopper_plane(label="Cloudhopper plane"){
  measure(kind=plane,axis=z,meters=10.8);
  body(interaction=solid,radius=29,height=29);
  rideable(at=[1,19,0],control=plane);
  part fuselage(shape=cylinder,material=cream,at=[-1,14,0],size=[14,66,17],rot_deg=[0,0,90],taper=.22);
  part cabin(shape=box,material=cream,at=[1,19,0],size=[27,13,17]);
  part windshield(shape=box,material=glass,at=[16.2,22,0],size=[1,8,14],rot_deg=[0,0,20]);
  part wing_center(shape=box,material=cream,at=[4,26,0],size=[22,2.8,14]);
  part cowling(shape=cylinder,material=red,at=[31,14,0],size=[15.5,10,18.5],rot_deg=[0,0,90]);
  part propeller(shape=box,material=dark,at=[37,14,0],size=[1.5,25,2],motion=spin(axis=x,deg_s=160));
  part spinner(shape=capsule,material=steel,at=[39,14,0],size=[5,7,5],rot_deg=[0,0,90]);
  part tailplane(shape=capsule,material=teal,at=[-31,16,0],size=[12,32,2],rot_deg=[90,0,0]);
  part fin(shape=cylinder,material=red,at=[-30,21,0],size=[14,13,2],taper=.4);
  part tail_wheel(shape=sphere,material=dark,at=[-31,2.5,0],size=[5,5,5]);
  beam tail_strut(shape=cylinder,material=steel,from=[-29,13,0],to=[-31,3,0],width=1.2,depth=1.2);
  repeat sides(index=s,count=2){
    let sign(value=s*2-1);
    part cabin_window(shape=box,material=glass,at=[1,22,sign*8.6],size=[20,7,.8]);
    part window_post(shape=box,material=cream,at=[2,22,sign*9],size=[1,7,1]);
    // Elliptical wing sections narrow together. The red cap replaces the outer
    // section; it never shares the wing's exposed top or bottom faces.
    part wing(shape=cylinder,material=teal,at=[4,26,sign*22.5],size=[22,33,2.8],rot_deg=[sign*90,0,0],taper=.67);
    part wing_tip(shape=cylinder,material=red,at=[4,26,sign*42.5],size=[22*.67,7,2.8*.67],rot_deg=[sign*90,0,0],taper=.58/.67);
    beam wing_brace(shape=cylinder,material=steel,from=[7,15,sign*5],to=[5,26,sign*28],width=1.3,depth=1.3);
    beam gear(shape=cylinder,material=steel,from=[10,11,sign*5],to=[10,4.5,sign*12],width=1.5,depth=1.5);
    part wheel(shape=cylinder,material=dark,at=[10,4.5,sign*12],size=[9,4,9],rot_deg=[90,0,0],motion=roll(axis=y,radius=4.5));
    part wheel_hub(shape=cylinder,material=steel,at=[10,4.5,sign*14.3],size=[4,.6,4],rot_deg=[90,0,0],motion=roll(axis=y,radius=4.5));
    part navigation_light(shape=sphere,material=gold,at=[4,26.95,sign*44.5],size=[1.4,1.2,1.4]);
    beam exhaust(shape=cylinder,material=dark,from=[28,9,sign*5],to=[26,7,sign*8],width=1.3,depth=1.3);
  }
}
object willow_launch(label="Willow launch"){
  measure(kind=boat,axis=x,meters=6);
  body(interaction=solid,radius=26,height=38);
  rideable(at=[-5,16.1,0],control=boat);
  part keel(shape=prism,material=teal,at=[2,2,0],size=[65,12,11],outline=[[0,.3],[.1,0],[.75,.05],[1,.8],[1,1],[0,1]]);
  part hull(shape=prism,material=teal,at=[2,7,0],size=[65,31,8],rot_deg=[90,0,0],outline=[[0,.08],[.65,0],[.85,.12],[1,.5],[.85,.88],[.65,1],[0,.92]]);
  part deck(shape=prism,material=wood,at=[2,10.8,0],size=[61,27,1.5],rot_deg=[90,0,0],outline=[[0,.08],[.65,0],[.85,.12],[1,.5],[.85,.88],[.65,1],[0,.92]]);
  part gunwale(shape=prism,material=cream,at=[2,11.2,0],size=[65,31,1],rot_deg=[90,0,0],outline=[[0,.08],[.65,0],[.85,.12],[1,.5],[.85,.88],[.65,1],[0,.92],[0,.85],[.62,.92],[.8,.82],[.94,.5],[.8,.18],[.62,.08],[0,.15]]);
  part wheelhouse(shape=prism,material=cream,at=[-7,22,0],size=[25,22,22],outline=[[0,0],[1,0],[1,.2],[.8,1],[0,1]]);
  part roof(shape=prism,material=red,at=[-8.5,34,0],size=[31,3,26],outline=[[0,0],[1,0],[.95,.8],[.1,1],[0,.7]]);
  part windscreen(shape=box,material=glass,at=[2.95,25,0],size=[.7,14,17],rot_deg=[0,0,16]);
  repeat sides(index=s,count=2){
    let side(value=s*2-1);
    repeat windows(index=w,count=2){part pane(shape=prism,material=glass,at=[-14+w*11,25,side*11.1],size=[8.5,9,.5],outline=[[0,0],[1,0],[.85,1],[0,1]]);}
    part cabin_pillar(shape=box,material=wood,at=[-8.7,25,side*11.2],size=[.7,10,.5]);
    part lifering(shape=torus,material=red,at=[-16,16,side*11.5],size=[7,7,1.2]);
    beam bow_rail(shape=cylinder,material=steel,from=[9,16.5,side*12],to=[29,16.5,side*5],width=.7,depth=.7);
    repeat posts(index=p,count=2){beam stanchion(shape=cylinder,material=steel,from=[10+p*17,11.5,side*(11.65-p*5.95)],to=[10+p*17,16.5,side*(11.65-p*5.95)],width=.6,depth=.6);}
  }
  part aft_bench(shape=box,material=red,at=[-25,13,0],size=[8,3,20]);
  part helm_console(shape=box,material=cream,at=[2,14.5,0],size=[4,9,9]);
  part helm_wheel(shape=torus,material=steel,at=[-.3,17.5,0],size=[5,5,.7],rot_deg=[0,90,0]);
  part mast(shape=cylinder,material=wood,at=[-23,26,0],size=[1.2,30,1.2]);
  part pennant(shape=prism,material=red,at=[-17,36,0],size=[12,8,.5],outline=[[0,0],[1,.5],[0,1]]);
  voxels cleats(material=steel,at=[0,12,0],size=[50,1,5],grid=[32,1,5]){fill aft(from=[0,0,0],to=[2,1,5]);fill bow(from=[30,0,0],to=[32,1,5]);}
  voxels helm_seat(material=red,at=[-7,15.6,0],size=[8,12,9],grid=[16,24,18]){
    fill pedestal(from=[7,0,7],to=[9,12,11]);fill cushion(from=[0,12,0],to=[16,13,18]);fill backrest(from=[0,12,0],to=[3,24,18]);
  }
  part outboard(shape=box,material=dark,at=[-32.5,9,0],size=[4,5,5]);
  beam drive_leg(shape=cylinder,material=steel,from=[-32,7,0],to=[-33,-1,0],width=1,depth=1);
  repeat blades(index=b,count=2){part propeller(shape=box,material=steel,at=[-33,-1,0],size=[.6,4,.8],rot_deg=[b*90+45,0,0]);}
}
object meadow_bicycle(label="Meadow bicycle"){
  measure(kind=bicycle,axis=x,meters=1.8);
  body(interaction=solid,radius=20,height=39);
  rideable(at=[-6,28.5,0],control=bicycle);
  use rear_wheel(component=bicycle_wheel,args=[-19]);
  use front_wheel(component=bicycle_wheel,args=[19]);
  beam seat_tube(shape=cylinder,material=teal,from=[-3,12,0],to=[-6,25,0],width=1.5,depth=1.5);
  beam step_through(shape=cylinder,material=teal,from=[-3,12,0],to=[12,27,0],width=1.8,depth=1.8);
  repeat sides(index=s,count=2){
    let side(value=s*2-1);
    beam seat_stay(shape=cylinder,material=teal,from=[-19,10,side*2.5],to=[-6,25,side*.5],width=1.1,depth=1.1);
    beam chain_stay(shape=cylinder,material=teal,from=[-19,10,side*2.5],to=[-3,12,side],width=1.2,depth=1.2);
    beam fork_blade(shape=cylinder,material=steel,from=[12,27,side*2.4],to=[19,10,side*2.4],width=1.3,depth=1.3);
  }
  beam fork_crown(shape=cylinder,material=steel,from=[12,27,-2.4],to=[12,27,2.4],width=1.8,depth=1.8);
  beam steering_stem(shape=cylinder,material=steel,from=[12,27,0],to=[12,32,0],width=1.5,depth=1.5);
  beam handlebar(shape=capsule,material=dark,from=[12,32,-9],to=[12,32,9],width=1.6,depth=1.6);
  beam seat_post(shape=cylinder,material=steel,from=[-6,24.5,0],to=[-6,28,0],width=1.2,depth=1.2);
  part saddle(shape=capsule,material=dark,at=[-6,28.5,0],size=[4,12,7],rot_deg=[0,0,90]);
  beam chain_top(shape=box,material=dark,from=[-19,11.3,2.8],to=[-3,14.5,2.8],width=.5,depth=.5);
  beam chain_bottom(shape=box,material=dark,from=[-19,8.7,2.8],to=[-3,9.5,2.8],width=.5,depth=.5);
  part crank_axle(shape=cylinder,material=steel,at=[-3,12,0],size=[2,6.4,2],rot_deg=[-90,0,0]);
  part rear_cog(shape=cylinder,material=steel,at=[-19,10,2.8],size=[2.6,.6,2.6],rot_deg=[-90,0,0]);
  joint crank(at=[-3,12,0],rot_deg=[0,180,0],motion=roll(axis=z,radius=18)){
    part chainring(shape=cylinder,material=steel,at=[0,0,-2.8],size=[5,.8,5],rot_deg=[90,0,0]);
    repeat pedals(index=s,count=2){
      let side(value=s*2-1);
      beam arm(shape=box,material=steel,from=[0,0,side*2.8],to=[side*3,side*3,side*2.8],width=.8,depth=.8);
      part pedal(shape=box,material=dark,at=[side*3,side*3,side*4],size=[4,1.2,3]);
    }
  }
}
object maple_skateboard(label="Maple skateboard"){
  measure(kind=skateboard,axis=x,meters=0.82);
  body(interaction=solid,radius=14,height=9);
  rideable(at=[0,8,0],control=skateboard);
  part deck(shape=capsule,material=wood,at=[0,7,0],size=[3,43,12],rot_deg=[0,0,90]);
  part grip(shape=capsule,material=dark,at=[0,8.4,0],size=[1,36,10],rot_deg=[0,0,90]);
  repeat repeat_axle(index=axle,count=2){
    part truck(shape=box,material=steel,at=[axle*26-13,4,0],size=[4,3,14]);
    repeat repeat_side(index=side,count=2){
      part wheel(shape=cylinder,material=gold,at=[axle*26-13,3,side*14-7],size=[6,3,6],rot_deg=[90,0,0],motion=roll(axis=y,radius=3));
    }
  }
  repeat ends(index=e,count=2){
    let sign(value=e*2-1);
    part kick(shape=capsule,material=wood,at=[sign*17.8,8.5,0],size=[2,7,11],rot_deg=[0,0,sign*78]);
    part kingpin(shape=cylinder,material=steel,at=[sign*13,5,0],size=[2,3,2]);
    repeat sides(index=s,count=2){
      part hub(shape=cylinder,material=steel,at=[sign*13,3,s*17-8.5],size=[3,.5,3],rot_deg=[90,0,0],motion=roll(axis=y,radius=3));
      part bolt(shape=cylinder,material=steel,at=[sign*13,8.7,s*6-3],size=[1,.5,1]);
    }
  }
}
object meadow_station_2(label="Meadow station"){
  measure(kind=building,axis=y,meters=7);
  body(interaction=solid,radius=30,height=66);
  emit(kind=steam,at=[-20,78,-15],rate_s=2);
  contact contact(at=[-32,0,-20],radius=8,height=50);
  contact contact_2(at=[-32,0,0],radius=8,height=50);
  contact contact_3(at=[-32,0,20],radius=8,height=50);
  contact contact_4(at=[-18,0,-27],radius=9,height=50);
  contact contact_5(at=[18,0,-27],radius=9,height=50);
  contact contact_6(at=[-18,0,27],radius=9,height=50);
  contact contact_7(at=[18,0,27],radius=9,height=50);
  contact contact_8(at=[0,48,0],radius=39,height=16);
  part rear(shape=box,material=cream,at=[-32,25,0],size=[10,50,60]);
  repeat repeat_side(index=side,count=2){
    part wall(shape=box,material=cream,at=[0,25,side*54-27],size=[72,50,7]);
    part window(shape=box,material=glass,at=[0,30,side*62-31],size=[22,18,1]);
    beam sill(shape=box,material=wood,from=[-13,19,side*64-32],to=[13,19,side*64-32],width=3,depth=3);
    part front_post(shape=box,material=wood,at=[35,24,side*45-22.5],size=[5,48,15]);
  }
  part lintel(shape=box,material=wood,at=[35,44,0],size=[5,10,38]);
  part roof(shape=pyramid,material=red,at=[0,57,0],size=[88,24,76]);
  part chimney(shape=box,material=stone,at=[-20,65,-15],size=[10,22,10]);
  part platform(shape=box,material=stone,at=[48,1,0],size=[28,2,72]);
  use opening_door(component=opening_door,args=[]);
  part clock(shape=sphere,material=cream,at=[38,46,0],size=[2,10,10]);
  part clock_hand(shape=box,material=dark,at=[39,47,0],size=[1,5,1]);
  repeat sides(index=s,count=2){
    let sign(value=s*2-1);
    part window_upright(shape=box,material=cream,at=[0,30,sign*31.7],size=[1,18,.6]);
    part window_cross(shape=box,material=cream,at=[0,30,sign*31.7],size=[22,1,.6]);
    part drainpipe(shape=cylinder,material=dark,at=[-28,23,sign*31.5],size=[1.5,46,1.5]);
    part eave(shape=box,material=wood,at=[0,45,sign*33],size=[82,3,3]);
  }
  part clock_hour(shape=box,material=dark,at=[39,46,1.5],size=[.5,.7,4]);
}
object lakeside_boathouse(label="Lakeside boathouse"){
  measure(kind=building,axis=y,meters=6);
  body(interaction=solid,radius=30,height=56);
  contact contact(at=[-32,0,-20],radius=8,height=42);
  contact contact_2(at=[-32,0,0],radius=8,height=42);
  contact contact_3(at=[-32,0,20],radius=8,height=42);
  contact contact_4(at=[-18,0,-27],radius=9,height=42);
  contact contact_5(at=[18,0,-27],radius=9,height=42);
  contact contact_6(at=[-18,0,27],radius=9,height=42);
  contact contact_7(at=[18,0,27],radius=9,height=42);
  contact contact_8(at=[0,42,0],radius=39,height=12);
  part rear(shape=box,material=wood,at=[-30,21,0],size=[8,42,62]);
  repeat repeat_side(index=side,count=2){
    part wall(shape=box,material=wood,at=[0,21,side*55-27.5],size=[70,42,6]);
  }
  part roof(shape=pyramid,material=teal,at=[0,48,0],size=[84,20,78]);
  part lintel(shape=box,material=cream,at=[35,40,0],size=[5,8,52]);
  use opening_door(component=opening_door,args=[]);
  part lifering(shape=torus,material=red,at=[38,27,23],size=[12,12,2],rot_deg=[0,90,0]);
  repeat sides(index=s,count=2){
    repeat siding(index=b,count=4){part batten(shape=box,material=cream,at=[b*17-25.5,21,s*62-31],size=[1,38,1]);}
    part eave(shape=box,material=wood,at=[0,38.5,s*66-33],size=[80,3,3]);
  }
  part door_lamp(shape=sphere,material=gold,at=[38,41,-16],size=[4,5,4]);
}
object mossy_passage(label="Mossy passage"){
  measure(kind=building,axis=y,meters=10);
  body(interaction=solid,radius=30,height=80);
  contact contact(at=[-32,0,-54],radius=14,height=64);
  contact contact_2(at=[0,0,-54],radius=14,height=64);
  contact contact_3(at=[32,0,-54],radius=14,height=64);
  contact contact_4(at=[-32,0,54],radius=14,height=64);
  contact contact_5(at=[0,0,54],radius=14,height=64);
  contact contact_6(at=[32,0,54],radius=14,height=64);
  contact contact_7(at=[0,64,-28],radius=38,height=14);
  contact contact_8(at=[0,64,28],radius=38,height=14);
  repeat repeat_side(index=side,count=2){
    part wall(shape=box,material=stone,at=[0,32,side*108-54],size=[96,64,26]);
    repeat repeat_course(index=course,count=3){
      part seam(shape=box,material=dark,at=[0,16+course*18,side*81-40.5],size=[95,1,1]);
    }
  }
  part roof(shape=box,material=stone,at=[0,70,0],size=[96,14,128]);
  part moss(shape=icosphere,material=moss,at=[0,79,0],size=[99,12,124],deform=deform(seed=85,amount=0.1));
  repeat repeat_side_2(index=side,count=2){
    part keystone(shape=box,material=cream,at=[side*94-47,67,0],size=[5,15,18]);
    repeat repeat_pillar(index=pillar,count=2){
      part cap(shape=box,material=cream,at=[side*94-47,58,pillar*106-53],size=[6,9,30]);
    }
  }
  repeat sides(index=s,count=2){
    part footing(shape=box,material=stone,at=[0,3,s*108-54],size=[96,6,27]);
    part key_course(shape=box,material=cream,at=[s*96-48,71,0],size=[2,8,22]);
    repeat ivy(index=i,count=2){part ivy(shape=icosphere,material=moss,at=[s*96-48,66,i*84-42],size=[3,6,13],deform=deform(seed=62+i*9+s,amount=.17));}
  }
}
let seated_head_unit(value=1.75*50.5/(1.25*57.20000076293945));
object traveler(label="Traveler"){
 measure(kind=custom,axis=y,meters=1.25);
 body(interaction=decor,radius=8,height=42);
 part torso(shape=box,material=teal,at=[0,10,0],size=[10.5,20,12]);
 part hips(shape=box,material=dark,at=[0,-.5,0],size=[8,4,11.6]);
 group head_frame(at=[0,34.5-seated_head_unit*31.20000076293945,0],scale=seated_head_unit){
  use face(component=person_face,materials=[skin]);
  use hair(component=hair_cut,args=[0],materials=[dark]);
 }
 repeat sides(index=s,count=2){
  let sign(value=s*2-1);
  part collar(shape=box,material=white,at=[5.3,17,sign*1.8],size=[.25,1.2,1.6]);
  beam sleeve(shape=box,material=teal,from=[0,15,sign*5.2],to=[6,6,sign*5.2],width=3.8,depth=3.6);
  beam forearm(shape=box,material=skin,from=[6,6,sign*5.2],to=[13,4,sign*5.2],width=3.2,depth=3.4);
  part elbow(shape=box,material=skin,at=[6,6,sign*5.2],size=[3.8,3.8,3.6]);
  voxels hand(material=skin,at=[13,4,sign*5.2],size=[3.8,3,2.8],grid=[4,4,3]){
   fill palm(from=[0,0,0],to=[3,4,3]);fill thumb(from=[3,0,0],to=[4,2,3]);
  }
  beam thigh(shape=box,material=dark,from=[0,0,sign*3],to=[10,-5,sign*3],width=4.2,depth=4.4);
  beam shin(shape=box,material=dark,from=[10,-5,sign*3],to=[13,-14,sign*3],width=3.8,depth=4);
  part knee(shape=box,material=dark,at=[10,-5,sign*3],size=[4.4,4.4,4.4]);
  part shoe(shape=prism,material=dark,at=[15,-14,sign*3],size=[8,4,5],outline=[[0,0],[1,0],[1,.55],[.7,1],[.1,1],[0,.8]]);
  part sole(shape=box,material=cream,at=[15,-15.7,sign*3],size=[8,.6,5]);
 }
 part backpack(shape=box,material=dark,at=[-7,10,0],size=[6,12,11]);
}

material white(style=toon,colors=[#e9e5d7,#c9ccc7]);
component person_face(params=[],materials=[complexion]){
 part neck(shape=box,material=complexion,at=[0,19,0],size=[3.6,4.2,3.8]);
 part head(shape=box,material=complexion,at=[0,25.4,0],size=[9.2,9.2,8.8]);
 part nose(shape=box,material=complexion,at=[5,24.5,0],size=[1,1.4,1.4]);
 part mouth(shape=box,material=dark,at=[4.65,22.8,0],size=[.2,.35,1.1]);
 repeat eyes(index=s,count=2){part eye(shape=box,material=dark,at=[4.65,26.1,s*4-2],size=[.2,1,.9]);}
}
component civic_person(params=[athletic,long_sleeves,bag],materials=[top,complexion,handwear,trousers,shoes]){
 joint pelvis(bone=root,at=[0,25,0]){
  part hips(shape=box,material=top,at=[0,-.5,0],size=[7.8,4,11.6]);

  joint chest(bone=spine,at=[0,1,0]){
   part torso(shape=box,material=top,at=[0,8.5,0],size=[8.3,18,12]);
   use face(component=person_face,materials=[complexion]);
   repeat collars(index=s,count=2){part collar(shape=box,material=white,at=[4.22,16.8,s*3-1.5],size=[.25,1.2,1.3]);}
   repeat uniform(index=u,count=athletic){part stripe(shape=box,material=white,at=[4.22,12.5,0],size=[.25,1,10.4]);}

   repeat backpack(index=b,count=bag){
    part pack(shape=box,material=dark,at=[-5.25,8,0],size=[3.4,11,8.8]);
    repeat straps(index=s,count=2){
     voxels strap(material=dark,at=[0,10.3,s*7.6-3.8],size=[9.1,14.6,1.4],grid=[10,16,2]){
      fill front(from=[9,0,0],to=[10,16,2]);
      fill back(from=[0,0,0],to=[1,16,2]);
      fill shoulder(from=[1,15,0],to=[9,16,2]);
     }
    }
   }
   repeat details(index=d,count=1-athletic){
    part pocket_seam(shape=box,material=dark,at=[4.2,11,-3.2],size=[.2,.35,2.8]);
   }
   joint left_arm(bone=left_shoulder,at=[0,16.4,7.2]){
    part sleeve(shape=box,material=top,at=[0,-4.5,0],size=[3.8,10.5,4]);
    joint left_forearm(bone=left_elbow,at=[0,-9.5,0]){
     repeat bare(index=a,count=1-long_sleeves){part forearm(shape=box,material=complexion,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     repeat covered(index=a,count=long_sleeves){part forearm(shape=box,material=top,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     voxels hand(material=handwear,at=[.4,-9.9,0],size=[3.6,4.5,2.7],grid=[4,5,3]){
      fill palm(from=[0,0,0],to=[3,5,3]);
      fill thumb(from=[3,2,0],to=[4,4,2]);
     }
    }
   }
   joint right_arm(bone=right_shoulder,at=[0,16.4,-7.2]){
    part sleeve(shape=box,material=top,at=[0,-4.5,0],size=[3.8,10.5,4]);
    joint right_forearm(bone=right_elbow,at=[0,-9.5,0]){
     repeat bare(index=a,count=1-long_sleeves){part forearm(shape=box,material=complexion,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     repeat covered(index=a,count=long_sleeves){part forearm(shape=box,material=top,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     voxels hand(material=handwear,at=[.4,-9.9,0],size=[3.6,4.5,2.7],grid=[4,5,3]){
      fill palm(from=[0,0,0],to=[3,5,3]);
      fill thumb(from=[3,2,0],to=[4,4,2]);
     }
    }
   }
  }
  joint left_leg(bone=left_hip,at=[0,0,3.3]){
   repeat trousers(index=t,count=1-athletic){part thigh(shape=box,material=trousers,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat bare(index=t,count=athletic){part thigh(shape=box,material=complexion,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat uniform(index=u,count=athletic){part shorts(shape=box,material=top,at=[0,-3.1,0],size=[5.4,8.2,5.5]);}
   joint left_shin(bone=left_knee,at=[0,-11.5,0]){
    repeat trousers(index=t,count=1-athletic){part calf(shape=box,material=trousers,at=[0,-5,0],size=[3.8,10.6,4]);}
    repeat bare(index=t,count=athletic){part calf(shape=box,material=complexion,at=[0,-5,0],size=[3.8,10.6,4]);}
    joint left_foot(bone=left_ankle,at=[0,-10.5,0]){
     repeat uniform(index=u,count=athletic){part sock(shape=box,material=white,at=[0,3,0],size=[4.2,6,4.5]);}
     part shoe(shape=prism,material=shoes,at=[1.4,-1.2,0],size=[7.3,2.9,4.4],outline=[[0,.18],[.12,0],[.78,0],[1,.2],[1,.5],[.87,.72],[.45,.75],[.4,1],[.05,1],[0,.7]]);
     part sole(shape=box,material=white,at=[1.5,-2.7,0],size=[7.6,.6,4.6]);
    }
   }
  }
  joint right_leg(bone=right_hip,at=[0,0,-3.3]){
   repeat trousers(index=t,count=1-athletic){part thigh(shape=box,material=trousers,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat bare(index=t,count=athletic){part thigh(shape=box,material=complexion,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat uniform(index=u,count=athletic){part shorts(shape=box,material=top,at=[0,-3.1,0],size=[5.4,8.2,5.5]);}
   joint right_shin(bone=right_knee,at=[0,-11.5,0]){
    repeat trousers(index=t,count=1-athletic){part calf(shape=box,material=trousers,at=[0,-5,0],size=[3.8,10.6,4]);}
    repeat bare(index=t,count=athletic){part calf(shape=box,material=complexion,at=[0,-5,0],size=[3.8,10.6,4]);}
    joint right_foot(bone=right_ankle,at=[0,-10.5,0]){
     repeat uniform(index=u,count=athletic){part sock(shape=box,material=white,at=[0,3,0],size=[4.2,6,4.5]);}
     part shoe(shape=prism,material=shoes,at=[1.4,-1.2,0],size=[7.3,2.9,4.4],outline=[[0,.18],[.12,0],[.78,0],[1,.2],[1,.5],[.87,.72],[.45,.75],[.4,1],[.05,1],[0,.7]]);
     part sole(shape=box,material=white,at=[1.5,-2.7,0],size=[7.6,.6,4.6]);
    }
   }
  }
 }
}

component hair_cut(params=[long_hair],materials=[tone]){
 voxels hair(material=tone,at=[-.3,25.1,0],size=[10.2,12.2,10],grid=[10,12,10]){
  fill crown(from=[0,10,0],to=[10,12,10]);
  fill back(from=[0,4-long_hair*4,0],to=[2,10,10]);
  fill left(from=[2,5-long_hair*5,0],to=[8,10,1]);
  fill right(from=[2,5-long_hair*5,9],to=[8,10,10]);
  fill fringe_left(from=[8,9,0],to=[10,10,4]);
  fill fringe_right(from=[8,9,6],to=[10,10,10]);
 }
}
object walker(label="Explorer"){
 measure(kind=person,axis=y,meters=1.75);
 body(interaction=decor,radius=8,height=57);
 use anatomy(component=civic_person,args=[0,0,1],materials=[teal,skin,skin,dark,dark]);
 mount head(bone=spine){use hair(component=hair_cut,args=[0],materials=[dark]);}
}
route orchard_rail(kind=rail,mode=loop,speed=72,wait_s=4){
  repeat repeat_i(index=i,count=24){
    let a(value=-90+i*15);
    point(at=[1300+cos(a)*260,1960+sin(a)*170]);
  }
}
route meadow_cycle(kind=path,mode=loop,speed=35,wait_s=10,width=40,surface=cycle){
  repeat arc(index=i,count=32){
    let a(value=240+i*360/32);
    point(at=[1165+cos(a)*225,1615+sin(a)*120]);
    point(at=[1165+cos(a+360/64)*225,1615+sin(a+360/64)*120]);
  }
}
route village_skate(kind=path,mode=loop,speed=45,wait_s=6,width=54,surface=paved){
  repeat arc(index=i,count=32){
    let a(value=270+i*360/32);
    point(at=[2250+cos(a)*200,2350+sin(a)*140]);
    point(at=[2250+cos(a+360/64)*200,2350+sin(a+360/64)*140]);
  }
}
route lake_trip(kind=water,mode=loop,speed=40,wait_s=5){
  repeat repeat_i(index=i,count=20){
    let a(value=180+i*18);
    point(at=[2900+cos(a)*65,2410+sin(a)*90]);
  }
}
route cloud_trip(kind=air,mode=loop,speed=115,altitude=180,wait_s=6){
  point(at=[1580,1690]);
  point(at=[1800,1690]);
  point(at=[2250,1900]);
  point(at=[2400,2400]);
  point(at=[2080,2700]);
  point(at=[1570,2600]);
  point(at=[1400,2150]);
}
watercourse willow_river(level=0,depth=8,bank=32,color=#237e8c,flow=[0,24]){
  point(at=[1930,1050,320]);
  point(at=[1970,1260,140]);
  point(at=[1980,1480,150]);
  point(at=[1920,1740,150]);
  point(at=[1830,2010,420]);
}
place meadow_train(object=meadow_locomotive,route=orchard_rail,scale=1);
place meadow_coach(object=passenger_carriage,route=orchard_rail,offset=94,scale=1);
place meadow_plane(object=cloudhopper_plane,route=cloud_trip,scale=1);
place lake_boat(object=willow_launch,route=lake_trip,scale=1);
place village_bike(object=meadow_bicycle,route=meadow_cycle,scale=1);
place village_skateboard(object=maple_skateboard,route=village_skate,scale=1);
place meadow_station(object=meadow_station_2,at=[1470,1660],scale=1,heading_deg=90);
place lake_boathouse(object=lakeside_boathouse,at=[2680,2370],scale=1);
place rail_passage(object=mossy_passage,at=[1560,1960],scale=1,heading_deg=90);
