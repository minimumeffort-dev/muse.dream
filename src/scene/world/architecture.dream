  part step(shape=box,material=trim,at=[0,0.25,-13.5],size=[7,0.5,3.5]);
  use drain_0(component=drainage,args=[24,15,24,-1]);
  use drain_2(component=drainage,args=[24,15,24,1]);
  part porch_canopy(shape=prism,material=green,at=[0,7.9,-13.5],size=[8,1.2,3.5],outline=[[0,0],[1,0],[1,.5],[0,1]]);
  part porch_post_l(shape=box,material=wood,at=[-3.3,4,-14.7],size=[0.8,8,0.8]);
  part porch_post_r(shape=box,material=wood,at=[3.3,4,-14.7],size=[0.8,8,0.8]);
}

