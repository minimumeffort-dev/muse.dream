dream 2;
material brick(style=brick,colors=[#a96f55,#bcb1a0]);
material redbrick(style=brick,colors=[#995b4c,#b9ae9e]);
material plaster(style=toon,colors=[#ddd1b9,#c5b69a]);
material blue(style=toon,colors=[#9aadaf,#758e98]);
material ochre(style=toon,colors=[#d4b378,#b9955f]);
material glass(style=toon,colors=[#6c929d,#42616f],night=#f2bf7e);
material roof(style=toon,colors=[#535b64,#3b4753]);
material tile(style=toon,colors=[#aa6b50,#864d3e]);
material trim(style=toon,colors=[#e5decd,#c5bfae]);
material wood(style=wood,colors=[#805c40,#aa815a]);
material dark(style=toon,colors=[#35464c,#28363e]);
material green(style=toon,colors=[#5e7c73,#405d55]);
material sign(style=toon,colors=[#e4b948,#c79435]);
component sash(params=[w,h]){
  part glazing(shape=box,material=glass,at=[0,0,0],size=[w*.79,h*.84,.12]);
  voxels joinery(material=trim,at=[0,0,.08],size=[w,h,.12],grid=[16,20,1]){
    fill frame(from=[0,0,0],to=[16,20,1]);
    cut aperture(from=[2,2,0],to=[14,18,1]);
    fill mullion(from=[7,2,0],to=[8,18,1]);
    fill transom(from=[2,10,0],to=[14,11,1]);
  }
}
component curtain_bay(params=[w,h]){
  part glazing(shape=box,material=glass,at=[0,0,0],size=[w*.98,h*.94,.12]);
  voxels frame(material=trim,at=[0,0,.08],size=[w,h,.12],grid=[32,20,1]){
    fill frame(from=[0,0,0],to=[32,20,1]);
    repeat panes(index=i,count=4){cut pane(from=[i*8+1,2,0],to=[i*8+7,18,1]);}
  }
}
component rear_stack(params=[w,h,n,step]){
  voxels glazing(material=glass,at=[0,h/2,0],size=[w,h,.12],grid=[16,step*n,1]){repeat floors(index=f,count=n){fill pane(from=[2,f*step+2,0],to=[14,f*step+6,1]);}}
  voxels joinery(material=trim,at=[0,h/2,.08],size=[w,h,.12],grid=[16,step*n,1]){repeat floors(index=f,count=n){fill surround(from=[0,f*step+1,0],to=[16,f*step+7,1]);cut aperture(from=[2,f*step+2,0],to=[14,f*step+6,1]);fill mullion(from=[7,f*step+2,0],to=[8,f*step+6,1]);}}
}
component drainage(params=[w,h,d,side]){
  beam gutter(shape=cylinder,material=dark,from=[-w/2,h,side*(d/2+.6)],to=[w/2,h,side*(d/2+.6)],width=.22,depth=.22);
  part leader(shape=prism,material=dark,at=[w/2-.5,(h+.5)/2,side*(d/2+.37)],size=[.74,h-.5,.18],rot_deg=[0,-90*side,0],outline=[[0,0],[.24,0],[.24,.94],[1,.985],[1,1],[.76,1],[0,.95]]);
}
component entry(params=[]){
  voxels frame(material=trim,at=[0,3.35,.04],size=[4.5,6.7,.18],grid=[20,30,1]){
    fill surround(from=[0,0,0],to=[20,30,1]);cut opening(from=[2,0,0],to=[18,27,1]);
  }
  voxels door(material=dark,at=[0,3,0],size=[3.5,6,.12],grid=[14,24,2]){
    fill slab(from=[0,0,0],to=[14,24,2]);
    repeat panels(index=i,count=2){cut inset(from=[2,i*10+2,1],to=[12,i*10+10,2]);}
  }
}
object brick_terrace(label="Brick terrace"){
  measure(kind=building,axis=y,meters=9);
  body(interaction=solid,radius=9.5,height=23);
  foundation(size=[19.4,25.4],color=#9e9d8c);
  contact cell_0_0(at=[-4.750000,0,-9.375000],radius=5.685783,height=18.0);
  contact cell_0_1(at=[-4.750000,0,-3.125000],radius=5.685783,height=18.0);
  contact cell_0_2(at=[-4.750000,0,3.125000],radius=5.685783,height=18.0);
  contact cell_0_3(at=[-4.750000,0,9.375000],radius=5.685783,height=18.0);
  contact cell_1_0(at=[4.750000,0,-9.375000],radius=5.685783,height=18.0);
  contact cell_1_1(at=[4.750000,0,-3.125000],radius=5.685783,height=18.0);
  contact cell_1_2(at=[4.750000,0,3.125000],radius=5.685783,height=18.0);
  contact cell_1_3(at=[4.750000,0,9.375000],radius=5.685783,height=18.0);
  voxels walls(material=brick,at=[0,9,0],size=[19,18,25],grid=[19,18,25]){
    fill shell(from=[0,0,0],to=[19,18,25]);
  }
  part roof(shape=prism,material=roof,at=[0,20.5,0],size=[19.2,5,26.5],outline=[[0,0],[.5,1],[1,0],[.98,0],[.5,.88],[.02,0]]);
  part eaves(shape=box,material=trim,at=[0,17.75,0],size=[19.2,0.5,26.5]);
  part attic(shape=prism,material=brick,at=[0,20.2,0],size=[19,4.4,25],outline=[[0,0],[1,0],[.5,1]]);
  repeat floors(index=f,count=2){
    repeat bays(index=b,count=2){
      use window(component=sash,args=[3.8,4.95],at=[(b*2-1)*4.94,(f+.55)*9,-12.52],rot_deg=[0,180,0]);
    }
  }
  repeat rear(index=b,count=2){use window(component=sash,args=[3.8,4.95],at=[(b*2-1)*4.94,13.95,12.52]);}
  use rear_ground(component=sash,args=[3.8,4.95],at=[0,4.95,12.52]);
  repeat sides(index=s,count=2){use window(component=sash,args=[4,4.95],at=[(s*2-1)*9.52,13.95,0],rot_deg=[0,s*180-90,0]);}
  use entrance(component=entry,at=[0,0,-12.52],rot_deg=[0,180,0]);
  part step(shape=box,material=trim,at=[0,0.25,-14],size=[7,0.5,3.5]);
  part plinth(shape=box,material=trim,at=[0,0.5,0],size=[19.1,1,25.1]);
  use drain_0(component=drainage,args=[19,18,25,-1]);
  use drain_2(component=drainage,args=[19,18,25,1]);
  voxels chimney(material=brick,at=[6.08,20.2,3.5],size=[2.4,4.4,2.8],grid=[12,16,12]){fill shaft(from=[2,0,2],to=[10,14,10]);fill crown(from=[0,14,0],to=[12,16,12]);cut flue(from=[4,14,4],to=[8,16,8]);}
  beam ridge(shape=cylinder,material=roof,from=[0,22.7,-13.1],to=[0,22.7,13.1],width=0.6,depth=0.6);
}

