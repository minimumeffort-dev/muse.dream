  use front_drain(component=drainage,args=[42,35,32,-1]);
  part chimney(shape=box,material=brick,at=[11.76,38.2,3.2],size=[2.5,6.4,3]);
}

object corner_apartments(label="Corner apartments"){
  measure(kind=building,axis=y,meters=14);
  body(interaction=solid,radius=18.5,height=35);
  foundation(size=[37.4,30.4],color=#9e9d8c);
  contact cell_0_0(at=[-13.875000,0,-7.500000],radius=8.811392,height=27.0);
  contact cell_0_1(at=[-13.875000,0,7.500000],radius=8.811392,height=27.0);
  contact cell_1_0(at=[-4.625000,0,-7.500000],radius=8.811392,height=27.0);
