  part step(shape=box,material=trim,at=[0,0.25,-15],size=[7,0.5,3.5]);
  part plinth(shape=box,material=trim,at=[0,0.5,0],size=[21.1,1,27.1]);
  use drain_0(component=drainage,args=[21,19,27,-1]);
  use drain_2(component=drainage,args=[21,19,27,1]);
  voxels chimney(material=brick,at=[6.72,21.6,3.78],size=[2.4,5.2,2.8],grid=[12,16,12]){fill shaft(from=[2,0,2],to=[10,14,10]);fill crown(from=[0,14,0],to=[12,16,12]);cut flue(from=[4,14,4],to=[8,16,8]);}
