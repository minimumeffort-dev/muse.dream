object market_stall(label="Produce stall"){
 measure(kind=custom,axis=y,meters=2.65);
 body(interaction=solid,radius=12,height=27);
 part counter(shape=box,material=wood,at=[0,9,0],size=[32,2,18]);
 repeat posts(index=p,count=2){
  repeat sides(index=s,count=2){
   part leg(shape=box,material=wood,at=[p*28-14,4,s*14-7],size=[2,8,2]);
   part support(shape=box,material=wood,at=[p*28-14,16.5,s*14-7],size=[1,15,1]);
  }
 }
 part canopy(shape=pyramid,material=green,at=[0,25,0],size=[36,3,22]);
 repeat bread(index=b,count=3){part loaf(shape=icosphere,material=ochre,at=[b*9-9,11,0],size=[7,3,5]);}
 part front_board(shape=box,material=sign,at=[0,22,-7.5],size=[23,2,1]);
}
