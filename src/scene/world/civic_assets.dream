object east_medical_center(label="Eastbank medical center"){
 measure(kind=building,axis=y,meters=9);
 body(interaction=solid,radius=30,height=30);
 foundation(size=[66,44],color=#a6aaa0);
 contact cell_0(at=[-24,0,-10],radius=13,height=28);
 contact cell_1(at=[-8,0,-10],radius=13,height=28);
 contact cell_2(at=[8,0,-10],radius=13,height=28);
 contact cell_3(at=[24,0,-10],radius=13,height=28);
 contact cell_4(at=[-24,0,10],radius=13,height=28);
 contact cell_5(at=[-8,0,10],radius=13,height=28);
 contact cell_6(at=[8,0,10],radius=13,height=28);
 contact cell_7(at=[24,0,10],radius=13,height=28);
 part walls(shape=box,material=plaster,at=[0,14,0],size=[64,28,40]);
 part roof(shape=box,material=green,at=[0,29,0],size=[66,2,44]);
 part entry_block(shape=box,material=blue,at=[-18,9,-23],size=[22,18,10]);
 part entry_roof(shape=box,material=roof,at=[-18,18.5,-23],size=[24,1,12]);
 part doors(shape=box,material=glass,at=[-18,5,-28.2],size=[9,10,.6]);
 part entry_step(shape=box,material=trim,at=[-18,.25,-29],size=[14,.5,4]);
 repeat bays(index=i,count=4){
  part upstairs(shape=box,material=glass,at=[i*15-22.5,22,-20.1],size=[11,6,.5]);
  part rear(shape=box,material=glass,at=[i*15-22.5,14,20.1],size=[11,7,.5]);
 }
 part ground_window(shape=box,material=glass,at=[14,10,-20.1],size=[20,7,.5]);
 part cross_back(shape=box,material=green,at=[-18,14,-28.3],size=[7,5,.6]);
 part cross_vertical(shape=box,material=trim,at=[-18,14,-28.7],size=[1,3,.5]);
 part cross_horizontal(shape=box,material=trim,at=[-18,14,-28.7],size=[3,1,.5]);
}
