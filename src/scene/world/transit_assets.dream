dream 2;
material brick(style=grain,colors=[#b17459,#985c48]);
material redbrick(style=grain,colors=[#9e6053,#bd8170]);
material plaster(style=toon,colors=[#ddd1b9,#c5b69a]);
material blue(style=toon,colors=[#9aadaf,#758e98]);
material ochre(style=toon,colors=[#d4b378,#b9955f]);
material glass(style=toon,colors=[#6c929d,#42616f]);
material roof(style=toon,colors=[#535b64,#3b4753]);
material tile(style=toon,colors=[#aa6b50,#864d3e]);
material trim(style=toon,colors=[#e5decd,#c5bfae]);
material wood(style=grain,colors=[#805c40,#aa815a]);
material dark(style=toon,colors=[#35464c,#28363e]);
material green(style=toon,colors=[#5e7c73,#405d55]);
material sign(style=toon,colors=[#e4b948,#c79435]);
object city_bus(label="City bus"){
 measure(kind=bus,axis=x,meters=9.4);
 body(interaction=solid,radius=15,height=17);
 rideable(at=[0,12,0]);
 contact shell_0(at=[-17,0,0],radius=7,height=17);
 contact shell_1(at=[-12.1429,0,0],radius=7,height=17);
 contact shell_2(at=[-7.2857,0,0],radius=7,height=17);
 contact shell_3(at=[-2.4286,0,0],radius=7,height=17);
 contact shell_4(at=[2.4286,0,0],radius=7,height=17);
 contact shell_5(at=[7.2857,0,0],radius=7,height=17);
 contact shell_6(at=[12.1429,0,0],radius=7,height=17);
 contact shell_7(at=[17,0,0],radius=7,height=17);
  part body(shape=box,material=ochre,at=[0,8,0],size=[46,12,13]);
  part roof(shape=box,material=trim,at=[0,15.5,0],size=[45,3,12]);
  part window_left(shape=box,material=glass,at=[0,10.5,-6.6],size=[39,5,0.5]);
  part window_right(shape=box,material=glass,at=[0,10.5,6.6],size=[39,5,0.5]);
  part pillar_0_m(shape=box,material=trim,at=[-11.75,10.5,-6.6],size=[1,5,0.5]);
  part pillar_0_p(shape=box,material=trim,at=[-11.75,10.5,6.6],size=[1,5,0.5]);
  part pillar_1_m(shape=box,material=trim,at=[0,10.5,-6.6],size=[1,5,0.5]);
  part pillar_1_p(shape=box,material=trim,at=[0,10.5,6.6],size=[1,5,0.5]);
  part pillar_2_m(shape=box,material=trim,at=[11.75,10.5,-6.6],size=[1,5,0.5]);
  part pillar_2_p(shape=box,material=trim,at=[11.75,10.5,6.6],size=[1,5,0.5]);
  part windscreen(shape=box,material=glass,at=[23.1,10.5,0],size=[0.5,5,11]);
  part rear_glass(shape=box,material=glass,at=[-23.1,10.5,0],size=[0.5,5,11]);
  part wheel_0_m(shape=cylinder,material=dark,at=[-15.98,3,-6.4],size=[6,1.5,6],rot_deg=[90,0,0],motion=roll(axis=y,radius=3));
  part wheel_0_p(shape=cylinder,material=dark,at=[-15.98,3,6.4],size=[6,1.5,6],rot_deg=[90,0,0],motion=roll(axis=y,radius=3));
  part wheel_1_m(shape=cylinder,material=dark,at=[15.98,3,-6.4],size=[6,1.5,6],rot_deg=[90,0,0],motion=roll(axis=y,radius=3));
  part wheel_1_p(shape=cylinder,material=dark,at=[15.98,3,6.4],size=[6,1.5,6],rot_deg=[90,0,0],motion=roll(axis=y,radius=3));
  part headlight_m(shape=box,material=sign,at=[23.1,5,-4],size=[0.5,2,2]);
  part headlight_p(shape=box,material=sign,at=[23.1,5,4],size=[0.5,2,2]);
}
object city_tram(label="City tram"){
