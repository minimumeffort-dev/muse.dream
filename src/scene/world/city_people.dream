dream 2;
material white(style=toon,colors=[#e9e5d7,#c9ccc7]);
material steel(style=toon,colors=[#6f8187,#4b626d]);
material net(style=toon,colors=[#b8c7b9,#8ca99c]);
material orange(style=toon,colors=[#d28a42,#ab622d]);
material skin(style=toon,colors=[#c59774,#a97655]);
material hair(style=toon,colors=[#4e4037,#362e29]);
material blue(style=toon,colors=[#537eaa,#3c5f87]);
material red(style=toon,colors=[#b96a60,#944f50]);
material dark(style=toon,colors=[#3c4c59,#283844]);
material yellow(style=toon,colors=[#e2bd5d,#b4913f]);
component person(params=[]){
  part shorts(shape=box,material=dark,at=[0,7,0],size=[5,2,3.5]);
  part head(shape=sphere,material=skin,at=[0,15,0],size=[3.5,4,3.5]);
  part hair(shape=icosphere,material=hair,at=[0,16.5,0],size=[3.7,1.7,3.6]);
  repeat eyes(index=e,count=2){
    part eye(shape=sphere,material=dark,at=[e*1.4-.7,15.3,1.6],size=[.5,.5,.5]);
  }
  part nose(shape=sphere,material=skin,at=[0,14.8,1.9],size=[.7,.8,.7]);
}

material uniform_commuter(style=toon,colors=[#756f94,#ded5bf]);
object commuter(label="Commuter"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=4,height=18);
  group facing(rot_deg=[0,90,0]){
    use torso(component=person);
    part uniform(shape=capsule,material=uniform_commuter,at=[0,10,0],size=[5,6,3.5]);
    joint leg_0(at=[-1.5,7,0],motion=swing(axis=x,deg=17,hz=0.6,phase_deg=0)){
      part shin(shape=capsule,material=skin,at=[0,-3,0],size=[1.7,6,1.7]);
      part shoe(shape=box,material=white,at=[0,-6,1],size=[2,1.5,3.5]);
    }
    joint arm_0(at=[-3,12,0],motion=swing(axis=x,deg=15,hz=0.6,phase_deg=90)){
      part sleeve(shape=capsule,material=uniform_commuter,at=[0,-1,0],size=[2,3,2]);
      part hand(shape=capsule,material=skin,at=[0,-3.5,0],size=[1.5,3.5,1.5]);
    }
    joint leg_1(at=[1.5,7,0],motion=swing(axis=x,deg=17,hz=0.6,phase_deg=180)){
      part shin(shape=capsule,material=skin,at=[0,-3,0],size=[1.7,6,1.7]);
      part shoe(shape=box,material=white,at=[0,-6,1],size=[2,1.5,3.5]);
    }
    joint arm_1(at=[3,12,0],motion=swing(axis=x,deg=15,hz=0.6,phase_deg=-90)){
      part sleeve(shape=capsule,material=uniform_commuter,at=[0,-1,0],size=[2,3,2]);
      part hand(shape=capsule,material=skin,at=[0,-3.5,0],size=[1.5,3.5,1.5]);
    }
  }
}
