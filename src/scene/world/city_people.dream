dream 2;
material shirt(style=toon,colors=[#6f7f9a,#4f607b]);
material skin(style=toon,colors=[#c59774,#a97655]);
material hair(style=toon,colors=[#4e4037,#362e29]);
material dark(style=toon,colors=[#303b46,#202b36]);
material white(style=toon,colors=[#e9e5d7,#c9ccc7]);
component person_face(params=[],materials=[complexion]){
 part neck(shape=box,material=complexion,at=[0,19,0],size=[3.6,4.2,3.8]);
 part head(shape=box,material=complexion,at=[0,25.4,0],size=[9.2,9.2,8.8]);
 part nose(shape=box,material=complexion,at=[5,24.5,0],size=[1,1.4,1.4]);
 part mouth(shape=box,material=dark,at=[4.65,22.8,0],size=[.2,.35,1.1]);
 repeat eyes(index=s,count=2){part eye(shape=box,material=dark,at=[4.65,26.1,s*4-2],size=[.2,1,.9]);}
}
component civic_person(params=[athletic,long_sleeves,bag],materials=[top,complexion,handwear,trousers,shoes]){
 joint pelvis(bone=root,at=[0,25,0]){
  part hips(shape=box,material=top,at=[0,-.5,0],size=[7.8,4,11.6]);

  joint chest(bone=spine,at=[0,1,0]){
   part torso(shape=box,material=top,at=[0,8.5,0],size=[8.3,18,12]);
   use face(component=person_face,materials=[complexion]);
   repeat collars(index=s,count=2){part collar(shape=box,material=white,at=[4.22,16.8,s*3-1.5],size=[.25,1.2,1.3]);}
   repeat uniform(index=u,count=athletic){part stripe(shape=box,material=white,at=[4.22,12.5,0],size=[.25,1,10.4]);}

   repeat backpack(index=b,count=bag){
    part pack(shape=box,material=dark,at=[-5.25,8,0],size=[3.4,11,8.8]);
    repeat straps(index=s,count=2){
     voxels strap(material=dark,at=[0,10.3,s*7.6-3.8],size=[9.1,14.6,1.4],grid=[10,16,2]){
      fill front(from=[9,0,0],to=[10,16,2]);
      fill back(from=[0,0,0],to=[1,16,2]);
      fill shoulder(from=[1,15,0],to=[9,16,2]);
     }
    }
   }
   repeat details(index=d,count=1-athletic){
    part pocket_seam(shape=box,material=dark,at=[4.2,11,-3.2],size=[.2,.35,2.8]);
   }
   joint left_arm(bone=left_shoulder,at=[0,16.4,7.2]){
    part sleeve(shape=box,material=top,at=[0,-4.5,0],size=[3.8,10.5,4]);
    joint left_forearm(bone=left_elbow,at=[0,-9.5,0]){
     repeat bare(index=a,count=1-long_sleeves){part forearm(shape=box,material=complexion,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     repeat covered(index=a,count=long_sleeves){part forearm(shape=box,material=top,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     voxels hand(material=handwear,at=[.4,-9.9,0],size=[3.6,4.5,2.7],grid=[4,5,3]){
      fill palm(from=[0,0,0],to=[3,5,3]);
      fill thumb(from=[3,2,0],to=[4,4,2]);
     }
    }
   }
   joint right_arm(bone=right_shoulder,at=[0,16.4,-7.2]){
    part sleeve(shape=box,material=top,at=[0,-4.5,0],size=[3.8,10.5,4]);
    joint right_forearm(bone=right_elbow,at=[0,-9.5,0]){
     repeat bare(index=a,count=1-long_sleeves){part forearm(shape=box,material=complexion,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     repeat covered(index=a,count=long_sleeves){part forearm(shape=box,material=top,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     voxels hand(material=handwear,at=[.4,-9.9,0],size=[3.6,4.5,2.7],grid=[4,5,3]){
      fill palm(from=[0,0,0],to=[3,5,3]);
      fill thumb(from=[3,2,0],to=[4,4,2]);
     }
    }
   }
  }
  joint left_leg(bone=left_hip,at=[0,0,3.3]){
   repeat trousers(index=t,count=1-athletic){part thigh(shape=box,material=trousers,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat bare(index=t,count=athletic){part thigh(shape=box,material=complexion,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat uniform(index=u,count=athletic){part shorts(shape=box,material=top,at=[0,-3.1,0],size=[5.4,8.2,5.5]);}
   joint left_shin(bone=left_knee,at=[0,-11.5,0]){
    repeat trousers(index=t,count=1-athletic){part calf(shape=box,material=trousers,at=[0,-5,0],size=[3.8,10.6,4]);}
    repeat bare(index=t,count=athletic){part calf(shape=box,material=complexion,at=[0,-5,0],size=[3.8,10.6,4]);}
    joint left_foot(bone=left_ankle,at=[0,-10.5,0]){
     repeat uniform(index=u,count=athletic){part sock(shape=box,material=white,at=[0,3,0],size=[4.2,6,4.5]);}
     part shoe(shape=prism,material=shoes,at=[1.4,-1.2,0],size=[7.3,2.9,4.4],outline=[[0,.18],[.12,0],[.78,0],[1,.2],[1,.5],[.87,.72],[.45,.75],[.4,1],[.05,1],[0,.7]]);
     part sole(shape=box,material=white,at=[1.5,-2.7,0],size=[7.6,.6,4.6]);
    }
   }
  }
  joint right_leg(bone=right_hip,at=[0,0,-3.3]){
   repeat trousers(index=t,count=1-athletic){part thigh(shape=box,material=trousers,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat bare(index=t,count=athletic){part thigh(shape=box,material=complexion,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat uniform(index=u,count=athletic){part shorts(shape=box,material=top,at=[0,-3.1,0],size=[5.4,8.2,5.5]);}
   joint right_shin(bone=right_knee,at=[0,-11.5,0]){
    repeat trousers(index=t,count=1-athletic){part calf(shape=box,material=trousers,at=[0,-5,0],size=[3.8,10.6,4]);}
    repeat bare(index=t,count=athletic){part calf(shape=box,material=complexion,at=[0,-5,0],size=[3.8,10.6,4]);}
    joint right_foot(bone=right_ankle,at=[0,-10.5,0]){
     repeat uniform(index=u,count=athletic){part sock(shape=box,material=white,at=[0,3,0],size=[4.2,6,4.5]);}
     part shoe(shape=prism,material=shoes,at=[1.4,-1.2,0],size=[7.3,2.9,4.4],outline=[[0,.18],[.12,0],[.78,0],[1,.2],[1,.5],[.87,.72],[.45,.75],[.4,1],[.05,1],[0,.7]]);
     part sole(shape=box,material=white,at=[1.5,-2.7,0],size=[7.6,.6,4.6]);
    }
   }
  }
 }
}

component hair_cut(params=[long_hair],materials=[tone]){
 voxels hair(material=tone,at=[-.3,25.1,0],size=[10.2,12.2,10],grid=[10,12,10]){
  fill crown(from=[0,10,0],to=[10,12,10]);
  fill back(from=[0,4-long_hair*4,0],to=[2,10,10]);
  fill left(from=[2,5-long_hair*5,0],to=[8,10,1]);
  fill right(from=[2,5-long_hair*5,9],to=[8,10,10]);
  fill fringe_left(from=[8,9,0],to=[10,10,4]);
  fill fringe_right(from=[8,9,6],to=[10,10,10]);
 }
}
component curls(params=[],materials=[tone]){
 voxels hair(material=tone,at=[-.3,25.1,0],size=[10.2,12.2,10],grid=[10,12,10]){
  fill crown(from=[1,8,1],to=[9,12,9]);
  fill left(from=[1,6,0],to=[8,11,2]);
  fill right(from=[1,6,8],to=[8,11,10]);
  fill back(from=[0,4,1],to=[3,11,9]);
  fill fringe(from=[8,8,1],to=[10,11,9]);
  cut corner_a(from=[1,11,1],to=[3,12,3]);
  cut corner_b(from=[7,11,1],to=[9,12,3]);
  cut corner_c(from=[1,11,7],to=[3,12,9]);
  cut corner_d(from=[7,11,7],to=[9,12,9]);
 }
}
component beard(params=[],materials=[tone]){
 voxels hair(material=tone,at=[4.55,22.2,0],size=[1.4,3.7,8.4],grid=[2,4,8]){
  fill chin(from=[0,0,0],to=[2,3,8]);
  fill left(from=[0,3,0],to=[2,4,2]);
  fill right(from=[0,3,6],to=[2,4,8]);
  cut mouth(from=[1,2,3],to=[2,3,5]);
 }
}
component moustache(params=[],materials=[tone]){
 voxels hair(material=tone,at=[4.9,23.7,0],size=[.8,1.2,4.8],grid=[2,2,6]){
  fill moustache(from=[0,0,0],to=[2,2,6]);
  cut notch(from=[1,0,2],to=[2,1,4]);
 }
}
component glasses(params=[]){
 voxels frame(material=dark,at=[2.2,26.1,0],size=[5.7,2.2,9.6],grid=[6,4,12]){
  fill front(from=[5,0,0],to=[6,4,12]);
  cut left(from=[5,1,1],to=[6,3,5]);
  cut right(from=[5,1,7],to=[6,3,11]);
  fill left_arm(from=[0,1,0],to=[5,2,1]);
  fill right_arm(from=[0,1,11],to=[5,2,12]);
 }
}
component cap(params=[],materials=[tone]){
 voxels hat(material=tone,at=[.3,29.3,0],size=[11.4,3.8,10.4],grid=[12,4,12]){
  fill band(from=[0,0,0],to=[11,2,12]);
  fill crown(from=[0,2,0],to=[11,4,12]);
  fill peak(from=[11,0,0],to=[12,1,12]);
 }
}
component sun_hat(params=[],materials=[tone]){
 voxels hat(material=tone,at=[0,29.3,0],size=[12,3.8,12],grid=[12,4,12]){
  fill brim(from=[0,0,0],to=[12,1,12]);
  fill crown(from=[1,1,1],to=[11,4,11]);
 }
}
component chef_hat(params=[]){
 voxels hat(material=white,at=[0,28.9,0],size=[10.4,4.6,10.4],grid=[10,5,10]){
  fill band(from=[1,0,1],to=[9,2,9]);
  fill crown(from=[0,2,0],to=[10,5,10]);
 }
}
component lab_coat(params=[],materials=[fabric]){
 part hem(shape=prism,material=fabric,at=[-.2,-1.5,0],size=[12.4,9,8.6],rot_deg=[0,90,0],outline=[[0,0],[.46,0],[.5,.18],[.54,0],[1,0],[.92,1],[.08,1]]);
 voxels buttons(material=dark,at=[4.25,8,0],size=[.4,21,.7],grid=[1,21,1]){
  fill lower(from=[0,2,0],to=[1,3,1]);fill middle(from=[0,7,0],to=[1,8,1]);
  fill upper(from=[0,12,0],to=[1,13,1]);fill collar(from=[0,17,0],to=[1,18,1]);
 }
 part lapel(shape=prism,material=teal,at=[4.25,15.5,0],size=[6,7,.4],rot_deg=[0,90,0],outline=[[0,1],[.16,1],[.5,.16],[.84,1],[1,1],[.5,0]]);
}
component stethoscope(params=[]){
 voxels tube(material=dark,at=[4.25,14.1,0],size=[.4,5.4,4],grid=[1,16,12]){
  fill left(from=[0,1,0],to=[1,16,1]);fill right(from=[0,1,11],to=[1,16,12]);
  fill bend(from=[0,0,0],to=[1,2,12]);
 }
 part chestpiece(shape=cylinder,material=dark,at=[4.5,11.9,1.8],size=[1.2,.35,1.2],rot_deg=[0,0,90]);
}
component apron(params=[],materials=[fabric]){
 part bib(shape=box,material=fabric,at=[4.25,4,0],size=[.3,20,10.5]);
 repeat straps(index=s,count=2){
  let side(value=s*2-1);
  beam strap(shape=box,material=fabric,from=[4.25,14,side*3],to=[4.25,18.2,side*2],width=.45,depth=.45);
 }
}
component skirt(params=[],materials=[fabric]){
 part skirt(shape=prism,material=fabric,at=[0,-4,0],size=[13.2,12,11],rot_deg=[0,90,0],outline=[[0,0],[1,0],[.96,1],[.04,1]]);
}
component tie(params=[],materials=[fabric]){
 part tie(shape=prism,material=fabric,at=[4.25,13,0],size=[2,7,.3],rot_deg=[0,90,0],outline=[[.3,1],[.7,1],[1,.12],[.5,0],[0,.12]]);
}
component book(params=[],materials=[cover]){
 part book(shape=box,material=cover,at=[1.2,-7.4,2.1],size=[3.6,6,1.6]);
}

component ponytail(params=[],materials=[tone]){
 voxels hair(material=tone,at=[-1.6,25.1,0],size=[13,12.2,10],grid=[12,12,10]){
  fill crown(from=[4,10,0],to=[12,12,10]);
  fill back(from=[4,5,0],to=[6,10,10]);
  fill left(from=[6,5,0],to=[10,10,1]);
  fill right(from=[6,5,9],to=[10,10,10]);
  fill fringe(from=[10,9,0],to=[12,10,10]);
  fill knot(from=[2,7,3],to=[4,10,7]);
  fill tail(from=[0,0,3],to=[3,7,7]);
 }
}
component hoodie(params=[],materials=[fabric]){
 voxels hood(material=fabric,at=[-2.5,17.5,0],size=[8,7,10],grid=[8,7,10]){
  fill back(from=[0,0,0],to=[2,7,10]);
  fill left(from=[2,0,0],to=[8,7,2]);
  fill right(from=[2,0,8],to=[8,7,10]);
  fill base(from=[2,0,2],to=[8,2,8]);
 }
}
component tote(params=[],materials=[fabric]){
 voxels bag(material=fabric,at=[.3,-14.9,-2.8],size=[4,10,5],grid=[4,10,5]){
  fill body(from=[0,0,0],to=[4,6,5]);
  fill handle(from=[0,6,0],to=[4,10,5]);
  cut opening(from=[0,6,1],to=[4,9,4]);
 }
}
component headband(params=[],materials=[fabric]){
 voxels band(material=fabric,at=[0,28.3,0],size=[9.8,1,9.4],grid=[10,1,10]){
  fill ring(from=[0,0,0],to=[10,1,10]);cut center(from=[1,0,1],to=[9,1,9]);
 }
}

component knee_pad(params=[]){part pad(shape=box,material=dark,at=[1.95,-.2,0],size=[.5,3,3.4]);}

material scrub(style=toon,colors=[#e3e5de,#bfc7c4]);
material teal(style=toon,colors=[#297f88,#24616b]);
material deep_skin(style=toon,colors=[#925e45,#714631]);
material hair_gray(style=toon,colors=[#96938d,#72716c]);
material hair_black(style=toon,colors=[#30302d,#21211e]);
material rust(style=toon,colors=[#b96440,#884832]);
material straw(style=toon,colors=[#d7b974,#ac935a]);
material skin_warm(style=toon,colors=[#d5ad86,#ab805b]);
material uniform_commuter(style=toon,colors=[#756f94,#ded5bf]);
material uniform_teacher(style=toon,colors=[#83966c,#667750]);
material coat_lilac(style=toon,colors=[#9481ae,#70658b]);
material coat_cream(style=toon,colors=[#d8c591,#b2a174]);
material home_kit(style=toon,colors=[#4f9593,#286c72]);
material away_kit(style=toon,colors=[#d47d43,#a94e37]);
material yellow(style=toon,colors=[#e2bd5d,#b4913f]);
object commuter(label="Commuter"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,1,1],materials=[uniform_commuter,skin,skin,dark,dark]);
 mount head(bone=spine){use hair(component=hair_cut,args=[0],materials=[hair_black]);use glasses(component=glasses);use tie(component=tie,materials=[rust]);}
}
object health_worker(label="Health worker"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,1,0],materials=[scrub,skin,skin,dark,white]);
 mount head(bone=spine){use hair(component=hair_cut,args=[0],materials=[hair_black],scale=.96);use tools(component=stethoscope);use hat(component=cap,materials=[white]);}
 mount coat(bone=root){use coat(component=lab_coat,materials=[scrub]);}
}
object market_vendor(label="Market vendor"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,1,0],materials=[scrub,deep_skin,deep_skin,dark,dark]);
 mount head(bone=spine){use hair(component=hair_cut,args=[0],materials=[hair_black],scale=.96);use moustache(component=moustache,materials=[hair_black]);use hat(component=chef_hat);}
 mount clothing(bone=root){use apron(component=apron,materials=[rust]);}
}
object teacher(label="Teacher"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,1,0],materials=[uniform_teacher,skin_warm,skin_warm,dark,dark]);
 mount head(bone=spine){use hair(component=ponytail,materials=[hair_black]);use glasses(component=glasses);}
 mount clothing(bone=root){use skirt(component=skirt,materials=[dark]);}
 mount book(bone=left_elbow){use book(component=book,materials=[rust]);}
}
object river_shopper(label="River shopper"){
 measure(kind=person,axis=y,meters=1.75);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,0,0],materials=[rust,deep_skin,deep_skin,dark,dark]);
 mount head(bone=spine){use hair(component=hair_cut,args=[1],materials=[hair_black]);}
 mount clothing(bone=root){use skirt(component=skirt,materials=[teal]);}
 mount bag(bone=right_elbow){use tote(component=tote,materials=[straw]);}
}
object campus_student(label="Campus student"){
 measure(kind=person,axis=y,meters=1.65);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,0,1],materials=[coat_lilac,skin_warm,skin_warm,dark,white]);
 mount head(bone=spine){use hair(component=hair_cut,args=[1],materials=[hair_black]);use glasses(component=glasses);}
}
object park_neighbor(label="Park neighbor"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,1,0],materials=[teal,deep_skin,deep_skin,dark,dark]);
 mount head(bone=spine){use beard(component=beard,materials=[hair_gray]);use hat(component=sun_hat,materials=[straw]);}
}
object city_resident(label="City resident"){
 measure(kind=person,axis=y,meters=1.85);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[0,1,0],materials=[coat_cream,skin,skin,dark,white]);
 mount head(bone=spine){use hair(component=curls,materials=[hair_black]);use hood(component=hoodie,materials=[coat_cream]);}
}
object home_athlete(label="Home athlete"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[1,0,0],materials=[home_kit,deep_skin,deep_skin,dark,dark]);
 mount head(bone=spine){use hair(component=curls,materials=[hair_black]);use band(component=headband,materials=[white]);}
}
object home_athlete_warm(label="Home athlete"){
 measure(kind=person,axis=y,meters=1.72);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[1,0,0],materials=[home_kit,skin_warm,skin_warm,dark,white]);
 mount head(bone=spine){use hair(component=ponytail,materials=[hair]);use band(component=headband,materials=[white]);}
}
object away_athlete(label="Away athlete"){
 measure(kind=person,axis=y,meters=1.84);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[1,0,0],materials=[away_kit,skin_warm,skin_warm,dark,dark]);
 mount head(bone=spine){use hair(component=hair_cut,args=[0],materials=[hair_black]);use moustache(component=moustache,materials=[hair_black]);}
}
object keeper_athlete(label="Goalkeeper"){
 measure(kind=person,axis=y,meters=1.86);
 body(interaction=decor,radius=13,height=57,clearance=13.729530217745982);
 use anatomy(component=civic_person,args=[1,1,0],materials=[yellow,skin_warm,white,dark,dark]);
 mount head(bone=spine){use hair(component=hair_cut,args=[0],materials=[hair_black]);}
 mount left_pad(bone=left_knee){use pad(component=knee_pad);}
 mount right_pad(bone=right_knee){use pad(component=knee_pad);}
}
