material skin_deep(style=toon,colors=[#925e45,#714631]);
material skin_warm(style=toon,colors=[#d5ad86,#ab805b]);
material hair_gray(style=toon,colors=[#98938a,#6f706b]);
material hair_black(style=toon,colors=[#2d3137,#1e252b]);
material coat_rust(style=toon,colors=[#b56546,#864c39]);
material coat_teal(style=toon,colors=[#548b86,#396966]);
material coat_lilac(style=toon,colors=[#9481ae,#70658b]);
material coat_cream(style=toon,colors=[#d8c591,#b2a174]);
object river_shopper(label="River shopper"){
 measure(kind=person,axis=y,meters=1.75);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,materials=[coat_rust,skin_deep,hair_black]);
}
object campus_student(label="Campus student"){
 measure(kind=person,axis=y,meters=1.65);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,materials=[coat_lilac,skin_warm,hair_black]);
}
object park_neighbor(label="Park neighbor"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,materials=[coat_teal,skin_deep,hair_gray]);
}
object city_resident(label="City resident"){
 measure(kind=person,axis=y,meters=1.85);
 body(interaction=decor,radius=13,height=57);
 use anatomy(component=civic_person,materials=[coat_cream,skin,hair_black]);
}
