dream 2;
material white(style=toon,colors=[#e9e5d7,#c9ccc7]);
material steel(style=toon,colors=[#6f8187,#4b626d]);
material net(style=toon,colors=[#b8c7b9,#8ca99c]);
material orange(style=toon,colors=[#d28a42,#ab622d]);
material skin(style=toon,colors=[#c59774,#a97655]);
material hair(style=toon,colors=[#4e4037,#362e29]);
material blue(style=toon,colors=[#537eaa,#3c5f87]);
material red(style=toon,colors=[#b96a60,#944f50]);
material dark(style=toon,colors=[#3c4c59,#283844]);
material yellow(style=toon,colors=[#e2bd5d,#b4913f]);
component civic_person(materials=[shirt,complexion,hair_tone]){
  joint pelvis(bone=root,at=[0,25,0]){
    part belt(shape=box,material=dark,at=[0,0,0],size=[12,3,15]);
    joint chest(bone=spine,at=[0,1,0]){
      part torso(shape=capsule,material=shirt,at=[0,8,0],size=[12,19,16]);
      part head(shape=sphere,material=complexion,at=[0,24,0],size=[12,12,12]);
      part hair(shape=sphere,material=hair_tone,at=[-.7,28,0],size=[12.8,6.4,13]);
      part nose(shape=sphere,material=complexion,at=[6,23,0],size=[3,3,3]);
      repeat eyes(index=s,count=2){
        part eye(shape=sphere,material=dark,at=[5.3,25.5,s*7-3.5],size=[1.5,1.5,1.5]);
        part ear(shape=sphere,material=complexion,at=[-.5,24,s*12-6],size=[2.5,3,2]);
      }
      joint left_arm(bone=left_shoulder,at=[0,17,9]){
        part sleeve(shape=capsule,material=shirt,at=[0,-4.5,0],size=[5,10.5,5]);
        joint left_forearm(bone=left_elbow,at=[0,-9.5,0]){
          part elbow(shape=sphere,material=complexion,at=[0,0,0],size=[4.2,4.2,4.2]);
          part forearm(shape=capsule,material=complexion,at=[0,-4.5,0],size=[4,10,4]);
          part hand(shape=box,material=complexion,at=[.5,-10,0],size=[4.5,4,3.5]);
        }
      }
      joint right_arm(bone=right_shoulder,at=[0,17,-9]){
        part sleeve(shape=capsule,material=shirt,at=[0,-4.5,0],size=[5,10.5,5]);
        joint right_forearm(bone=right_elbow,at=[0,-9.5,0]){
          part elbow(shape=sphere,material=complexion,at=[0,0,0],size=[4.2,4.2,4.2]);
          part forearm(shape=capsule,material=complexion,at=[0,-4.5,0],size=[4,10,4]);
          part hand(shape=box,material=complexion,at=[.5,-10,0],size=[4.5,4,3.5]);
        }
      }
    }
    joint left_leg(bone=left_hip,at=[0,0,4]){
      part thigh(shape=capsule,material=dark,at=[0,-5.5,0],size=[5.7,12,5.7]);
      joint left_shin(bone=left_knee,at=[0,-11.5,0]){
        part knee(shape=sphere,material=dark,at=[0,0,0],size=[5,5,5]);
        part calf(shape=capsule,material=dark,at=[0,-5.2,0],size=[5,11,5]);
        joint left_foot(bone=left_ankle,at=[0,-10.5,0]){
          part shoe(shape=box,material=white,at=[2.3,-1,0],size=[9,4,6.2]);
        }
      }
    }
    joint right_leg(bone=right_hip,at=[0,0,-4]){
      part thigh(shape=capsule,material=dark,at=[0,-5.5,0],size=[5.7,12,5.7]);
      joint right_shin(bone=right_knee,at=[0,-11.5,0]){
        part knee(shape=sphere,material=dark,at=[0,0,0],size=[5,5,5]);
        part calf(shape=capsule,material=dark,at=[0,-5.2,0],size=[5,11,5]);
        joint right_foot(bone=right_ankle,at=[0,-10.5,0]){
          part shoe(shape=box,material=white,at=[2.3,-1,0],size=[9,4,6.2]);
        }
      }
    }
  }
}
material uniform_commuter(style=toon,colors=[#756f94,#ded5bf]);
object commuter(label="Commuter"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=13,height=57);
  use anatomy(component=civic_person,materials=[uniform_commuter,skin,hair]);
}
material uniform_health_worker(style=toon,colors=[#75a5b2,#ded5bf]);
object health_worker(label="Health worker"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=13,height=57);
  use anatomy(component=civic_person,materials=[uniform_health_worker,skin,hair]);
}
material uniform_market_vendor(style=toon,colors=[#c49154,#ded5bf]);
object market_vendor(label="Market vendor"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=13,height=57);
