  foundation(size=[45.2,39.2],color=#b7b2a1);
  group architecture(scale=0.4){
    part walls(shape=box,material=blue,at=[0,21.5,0],size=[105,43,90]);
    part flat_roof(shape=box,material=cream,at=[0,45,0],size=[113,5,98]);
    part skylight(shape=box,material=glass,at=[15,50,0],size=[35,8,28]);
    part door(shape=box,material=wood,at=[0,12,-46],size=[14,24,2]);
    repeat windows(index=w,count=2){
      part window(shape=box,material=glass,at=[w*48-24,24,-46],size=[22,17,2]);
    }
    part porch(shape=box,material=cream,at=[0,29,-55],size=[32,3,24]);
    repeat posts(index=p,count=2){
      beam post(shape=box,material=wood,from=[p*26-13,0,-63],to=[p*26-13,28,-63],width=2,depth=2);
    }
    repeat rear_windows(index=b,count=2){
