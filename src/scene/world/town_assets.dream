    }
    repeat side_windows(index=b,count=2){
      part window(shape=box,material=glass,at=[(b*2-1)*53.5,24,0],size=[2,17,20]);
    }
  }
}
object street_lamp(label="Street lamp"){
  measure(kind=custom,axis=y,meters=5.2);
  body(interaction=solid,radius=4,height=52);
  beam pole(shape=cylinder,material=dark,from=[0,0,0],to=[0,49,0],width=1.7,depth=1.7);
  beam arm(shape=cylinder,material=dark,from=[0,49,0],to=[8,49,0],width=1.5,depth=1.5);
  part lamp(shape=box,material=cream,at=[8,49,0],size=[8,3,4]);
  part base(shape=cylinder,material=dark,at=[0,2,0],size=[5,4,5]);
}
object park_seat(label="Park seat"){
  measure(kind=bench,axis=x,meters=2);
  body(interaction=solid,radius=8,height=8);
  repeat slats(index=s,count=3){
    part seat(shape=box,material=wood,at=[0,5,s*2-2],size=[20,1.2,1.6]);
  }
  repeat legs(index=l,count=2){
    part leg(shape=box,material=dark,at=[l*14-7,2.5,0],size=[1.5,5,5]);
  }
  part back(shape=box,material=wood,at=[0,9,3],size=[20,5,1.3]);
}
