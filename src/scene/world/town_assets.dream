object garden_bungalow(label="Garden bungalow"){
  measure(kind=building,axis=y,meters=5.2);
  body(interaction=solid,radius=28.5,height=26);
  foundation(size=[49,39],color=#b7b2a1);
  group architecture(scale=0.5){
    part walls(shape=box,material=cream,at=[0,20,0],size=[90,40,70]);
    part roof(shape=pyramid,material=roof,at=[0,52,0],size=[104,24,84]);
    part chimney(shape=box,material=brick,at=[25,44,10],size=[8,22,10]);
    part door(shape=box,material=wood,at=[0,12,-36],size=[14,24,2]);
    repeat windows(index=w,count=2){
      part window(shape=box,material=glass,at=[w*48-24,24,-36],size=[22,17,2]);
    }
    part porch(shape=box,material=cream,at=[0,29,-45],size=[32,3,24]);
    repeat posts(index=p,count=2){
      beam post(shape=box,material=wood,from=[p*26-13,0,-53],to=[p*26-13,28,-53],width=2,depth=2);
    }
    repeat rear_windows(index=b,count=2){
      part window(shape=box,material=glass,at=[b*45-22.5,24,36],size=[18,17,2]);
    }
    repeat side_windows(index=b,count=2){
      part window(shape=box,material=glass,at=[(b*2-1)*46,24,0],size=[2,17,20]);
    }
  }
}
object terrace_home(label="Two-storey home"){
  measure(kind=building,axis=y,meters=8.2);
  body(interaction=solid,radius=27.5,height=41);
  foundation(size=[44,41.5],color=#b7b2a1);
  group architecture(scale=0.5){
    part walls(shape=box,material=brick,at=[0,35,0],size=[80,70,75]);
    part roof(shape=pyramid,material=roof,at=[0,82,0],size=[94,24,89]);
    part chimney(shape=box,material=brick,at=[25,74,10],size=[8,22,10]);
    part door(shape=box,material=wood,at=[0,12,-38.5],size=[14,24,2]);
    repeat windows(index=w,count=2){
      part window(shape=box,material=glass,at=[w*48-24,24,-38.5],size=[22,17,2]);
    }
    part porch(shape=box,material=cream,at=[0,29,-47.5],size=[32,3,24]);
    repeat posts(index=p,count=2){
      beam post(shape=box,material=wood,from=[p*26-13,0,-55.5],to=[p*26-13,28,-55.5],width=2,depth=2);
    }
    repeat upper(index=w,count=2){
      part window(shape=box,material=glass,at=[w*40-20,52,-38.5],size=[18,17,2]);
    }
    repeat rear_windows(index=b,count=2){
      part window(shape=box,material=glass,at=[b*40-20,24,38.5],size=[18,17,2]);
    }
    repeat side_windows(index=b,count=2){
      part window(shape=box,material=glass,at=[(b*2-1)*41,24,0],size=[2,17,20]);
    }
    repeat rear_upper(index=b,count=2){
      part window(shape=box,material=glass,at=[b*40-20,52,38.5],size=[18,17,2]);
    }
    repeat side_upper(index=b,count=2){
      part window(shape=box,material=glass,at=[(b*2-1)*41,52,0],size=[2,17,20]);
    }
  }
}
