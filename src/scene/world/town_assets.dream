dream 2;
material brick(style=grain,colors=[#b87861,#975f50]);
material cream(style=toon,colors=[#e6dac0,#c7bca5]);
material blue(style=toon,colors=[#819aaa,#607b8e]);
material glass(style=toon,colors=[#779ba7,#507583]);
material dark(style=toon,colors=[#46535a,#303e46]);
material wood(style=grain,colors=[#a4825d,#785c43]);
material roof(style=toon,colors=[#7e7775,#615d60]);
material yellow(style=toon,colors=[#e5b457,#b98945]);
object brick_apartments(label="Brick apartments"){
  measure(kind=building,axis=y,meters=13.5);
  body(interaction=solid,radius=16.75,height=33.75);
  foundation(size=[27,24.5],color=#a8a79a);
  group architecture(scale=0.25){
    part walls(shape=box,material=brick,at=[0,67.5,0],size=[100,135,90]);
    part cornice(shape=box,material=cream,at=[0,131,0],size=[106,5,96]);
    part roof(shape=box,material=roof,at=[0,136,0],size=[102,4,92]);
    repeat floors(index=f,count=3){
      repeat bays(index=b,count=3){
        part front_window(shape=box,material=glass,at=[b*25-25,20+f*31.666666666666668,-45.6],size=[16.666666666666668,16,2]);
        part rear_window(shape=box,material=glass,at=[b*25-25,20+f*31.666666666666668,45.6],size=[16.666666666666668,16,2]);
      }
    }
    part entry(shape=box,material=dark,at=[0,13,-46],size=[15,26,2]);
    part awning(shape=box,material=yellow,at=[0,29,-51],size=[42,3,18],rot_deg=[-8,0,0]);
    repeat side_floors(index=f,count=3){
      repeat sides(index=b,count=2){
        part window(shape=box,material=glass,at=[(b*2-1)*51,20+f*31.666666666666668,0],size=[2,16,18]);
      }
    }
  }
}
object corner_shop(label="Corner shop"){
  measure(kind=building,axis=y,meters=7);
  body(interaction=solid,radius=17.5,height=17.5);
  foundation(size=[29.5,23.25],color=#a8a79a);
  group architecture(scale=0.25){
    part walls(shape=box,material=cream,at=[0,35,0],size=[110,70,85]);
    part cornice(shape=box,material=cream,at=[0,66,0],size=[116,5,91]);
    part roof(shape=box,material=roof,at=[0,71,0],size=[112,4,87]);
    repeat floors(index=f,count=2){
      repeat bays(index=b,count=3){
        part front_window(shape=box,material=glass,at=[b*27.5-27.5,20+f*15,-43.1],size=[18.333333333333332,16,2]);
        part rear_window(shape=box,material=glass,at=[b*27.5-27.5,20+f*15,43.1],size=[18.333333333333332,16,2]);
      }
    }
    part entry(shape=box,material=dark,at=[0,13,-43.5],size=[15,26,2]);
    part awning(shape=box,material=yellow,at=[0,29,-48.5],size=[42,3,18],rot_deg=[-8,0,0]);
    repeat side_floors(index=f,count=2){
      repeat sides(index=b,count=2){
        part window(shape=box,material=glass,at=[(b*2-1)*56,20+f*15,0],size=[2,16,18]);
      }
    }
  }
}
