dream 2;
material iron(style=toon,colors=[#35464c,#25363d]);
material stone(style=toon,colors=[#a9a494,#c7bfaa]);
material brass(style=toon,colors=[#9b8051,#c8a86b]);
material lamp_glass(style=glow,colors=[#f4db9c,#ffe9ba],night=#ffd18a);
material leaf(style=toon,colors=[#527348,#77935d]);
material petal(style=toon,colors=[#cf9458,#e0ba73]);
material blue(style=toon,colors=[#6c8497,#879bad]);
material pigeon_gray(style=toon,colors=[#7c8c95,#a4aeb0]);
material throat(style=toon,colors=[#527c70,#536776]);
material red(style=toon,colors=[#ac6b51,#b98362]);
object avenue_lamp(label="Avenue streetlight"){
 lamp(at=[8,39,0],radius=52,color=#ffc581);
 measure(kind=custom,axis=y,meters=5.2);
 body(interaction=solid,radius=4,height=40);
 contact pole_body(at=[0,0,0],radius=1.2,height=40);
 part foot(shape=cylinder,material=stone,at=[0,1,0],size=[4,2,4]);
 beam mast(shape=cylinder,material=iron,from=[0,1,0],to=[0,38,0],width=1.6,depth=1.6,taper=.7);
 beam arm(shape=cylinder,material=iron,from=[0,36,0],to=[7,40,0],width=1.1,depth=1.1);
 part housing(shape=box,material=iron,at=[8,40,0],size=[6,1.5,3]);
 part lens(shape=box,material=lamp_glass,at=[8,39.2,0],size=[4.5,.5,2.3]);
}
object neighborhood_lamp(label="Neighborhood lantern"){
 lamp(at=[0,32,0],radius=36,color=#ffd18a);
 measure(kind=custom,axis=y,meters=3.8);
 body(interaction=solid,radius=4,height=38);
 contact pole_body(at=[0,0,0],radius=1.4,height=38);
 part foot(shape=cylinder,material=stone,at=[0,1,0],size=[4,2,4]);
 beam pole(shape=cylinder,material=iron,from=[0,1,0],to=[0,29,0],width=1.8,depth=1.8,taper=.65);
 part collar(shape=cylinder,material=brass,at=[0,28.5,0],size=[3,1,3]);
 part lantern(shape=box,material=lamp_glass,at=[0,32,0],size=[3,6,3]);
 repeat posts(index=i,count=4){beam frame(shape=box,material=iron,from=[cos(i*90)*1.65,29,sin(i*90)*1.65],to=[cos(i*90)*1.65,35,sin(i*90)*1.65],width=.5,depth=.5);}
 part roof(shape=pyramid,material=iron,at=[0,36.5,0],size=[5,3,5]);
}
object planted_tub(label="Planted street tub"){
 measure(kind=custom,axis=x,meters=1.2);
 body(interaction=solid,radius=5,height=8);
 part tub(shape=cylinder,material=red,at=[0,3,0],size=[11,6,11],taper=.82);
 part soil(shape=cylinder,material=iron,at=[0,6,0],size=[10,.6,10]);
 repeat leaves(index=i,count=6){beam stem(shape=capsule,material=leaf,from=[0,6,0],to=[cos(i*60)*5,10+i/6,sin(i*60)*5],width=2,depth=1);}
 part flower(shape=icosphere,material=petal,at=[0,11,0],size=[3,2,3]);
}
object verge_flowers(label="Mixed verge flowers"){
 measure(kind=custom,axis=x,meters=1.7);
 body(interaction=decor,radius=4,height=8);
 repeat flowers(index=i,count=7){
  let x(value=cos(i*137)*i*.8);
  let z(value=sin(i*137)*i*.7);
  beam stalk(shape=cylinder,material=leaf,from=[x,0,z],to=[x,4+i/2,z],width=.5,depth=.5);
  part bloom(shape=icosphere,material=petal,at=[x,4+i/2,z],size=[2.5,1.2,2.5]);
  beam blade(shape=capsule,material=leaf,from=[x,1,z],to=[x+2,3,z+1],width=1,depth=.5);
 }
}
object city_scooter(label="Electric city scooter"){
 measure(kind=custom,axis=x,meters=1.25);
 body(interaction=solid,radius=4.5,height=14);
 rideable(at=[-1,3,0],control=scooter);
 part deck(shape=box,material=iron,at=[0,2.2,0],size=[11,1,3]);
 beam stem(shape=cylinder,material=blue,from=[4.5,1.8,0],to=[3.5,13,0],width=1,depth=1);
 beam handlebar(shape=cylinder,material=iron,from=[3.5,13,-3.5],to=[3.5,13,3.5],width=.8,depth=.8);
 beam fork(shape=cylinder,material=iron,from=[4.5,1.8,-1],to=[4.5,4,-1],width=.7,depth=.7);
 repeat wheels(index=i,count=2){part tire(shape=cylinder,material=iron,at=[i*10-5,1.5,0],size=[3,1,3],rot_deg=[90,0,0],motion=roll(axis=y,radius=1.5));part hub(shape=cylinder,material=stone,at=[i*10-5,1.5,.55],size=[1.2,.5,1.2],rot_deg=[90,0,0]);}
 part headlight(shape=sphere,material=lamp_glass,at=[4,10.5,0],size=[1.2,1.2,1.2]);
 beam stand(shape=cylinder,material=iron,from=[-1,1.8,0],to=[-1,.4,1.8],width=.5,depth=.5);
}
object city_pigeon(label="City pigeon"){
 measure(kind=custom,axis=z,meters=.72);
 body(interaction=decor,radius=4,height=4);
 part body(shape=icosphere,material=pigeon_gray,at=[0,3,0],size=[5,3,2]);
 part breast(shape=icosphere,material=throat,at=[2,3.5,0],size=[2,2.5,1.8]);
 part head(shape=sphere,material=pigeon_gray,at=[3,5,0],size=[2,2,1.7]);
 beam beak(shape=box,material=iron,from=[3.8,5,0],to=[4.7,4.8,0],width=.6,depth=.6);
 part tail(shape=box,material=iron,at=[-3,3,0],size=[3,.6,2.5],rot_deg=[0,0,-8]);
 part wing_left(shape=box,material=pigeon_gray,at=[-.5,3.8,-3.5],size=[4,.5,7],rot_deg=[0,-12,-3]);
 part wing_right(shape=box,material=pigeon_gray,at=[-.5,3.8,3.5],size=[4,.5,7],rot_deg=[0,12,-3]);
 repeat eyes(index=i,count=2){part eye(shape=sphere,material=iron,at=[3.5,5.2,i*1.4-.7],size=[.5,.5,.5]);}
}
object city_hatchback(label="City hatchback"){
 measure(kind=car,axis=x,meters=3.8);
 body(interaction=solid,radius=11,height=15);
 rideable(at=[-2,12,0]);
 part chassis(shape=box,material=blue,at=[0,5,0],size=[32,6,14]);
 part bonnet(shape=box,material=blue,at=[10,8.2,0],size=[10,2,13]);
 part cabin(shape=box,material=throat,at=[-3,10,0],size=[18,7,12]);
 part roof(shape=box,material=blue,at=[-3,14,0],size=[17,1.5,12.8]);
 repeat pillars(index=i,count=3){repeat sides(index=j,count=2){part pillar(shape=box,material=blue,at=[i*8-11,10,j*12.8-6.4],size=[1,7,.5]);}}
 repeat axles(index=i,count=2){repeat sides(index=j,count=2){part tire(shape=cylinder,material=iron,at=[i*21-10.5,3,j*14-7],size=[6,2,6],rot_deg=[90,0,0],motion=roll(axis=y,radius=3));part hub(shape=cylinder,material=stone,at=[i*21-10.5,3,j*15.8-7.9],size=[3,1,3],rot_deg=[90,0,0]);}}
 repeat lights(index=i,count=2){part light(shape=box,material=lamp_glass,at=[16.2,5.2,i*9-4.5],size=[.5,2,3]);}
 part front_bumper(shape=box,material=iron,at=[16,3.6,0],size=[1,1,13]);
 part rear_bumper(shape=box,material=iron,at=[-16,3.6,0],size=[1,1,13]);
}
object delivery_van(label="Neighborhood delivery van"){
 measure(kind=car,axis=x,meters=4.8);
 body(interaction=solid,radius=13,height=23);
 rideable(at=[10,14,0]);
 part chassis(shape=box,material=iron,at=[0,4,0],size=[40,3,16]);
 part cargo(shape=box,material=stone,at=[-5,14,0],size=[30,19,17]);
 part roof(shape=box,material=stone,at=[-5,24,0],size=[30,1,17]);
 part cab(shape=box,material=blue,at=[13,10,0],size=[13,14,16]);
 part windscreen(shape=box,material=throat,at=[19.6,13,0],size=[.5,6,13]);
 repeat sides(index=j,count=2){part window(shape=box,material=throat,at=[13,13,j*16.5-8.25],size=[10,6,.5]);part cargo_trim(shape=box,material=blue,at=[-5,12,j*17.5-8.75],size=[28,3,.5]);}
 repeat axles(index=i,count=2){repeat sides(index=j,count=2){part tire(shape=cylinder,material=iron,at=[i*27-13.5,3.5,j*17-8.5],size=[7,2,7],rot_deg=[90,0,0],motion=roll(axis=y,radius=3.5));part hub(shape=cylinder,material=stone,at=[i*27-13.5,3.5,j*18.6-9.3],size=[3.5,1,3.5],rot_deg=[90,0,0]);}}
 repeat lights(index=i,count=2){part light(shape=box,material=lamp_glass,at=[19.7,7,i*10-5],size=[.5,2,3]);}
}
