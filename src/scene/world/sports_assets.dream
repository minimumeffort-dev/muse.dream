dream 2;
material white(style=toon,colors=[#e9e5d7,#c9ccc7]);
material steel(style=toon,colors=[#6f8187,#4b626d]);
material net(style=toon,colors=[#b8c7b9,#8ca99c]);
material orange(style=toon,colors=[#d28a42,#ab622d]);
material skin(style=toon,colors=[#c59774,#a97655]);
material hair(style=toon,colors=[#4e4037,#362e29]);
material blue(style=toon,colors=[#537eaa,#3c5f87]);
material red(style=toon,colors=[#b96a60,#944f50]);
material dark(style=toon,colors=[#3c4c59,#283844]);
material yellow(style=cloth,colors=[#e2bd5d,#b4913f]);
object football(label="Football"){
  measure(kind=custom,axis=x,meters=.22);
  body(interaction=knockable,radius=4,height=8,friction=.6);
  impact(mode=bounce(restitution=.62,lift=.15));
  part leather(shape=sphere,material=white,at=[0,4,0],size=[8,8,8]);
  repeat patches(index=p,count=6){
    part patch(shape=icosphere,material=dark,at=[cos(p*60)*3.98,4,sin(p*60)*3.98],size=[.25,2.1,2.1],rot_deg=[0,-p*60,0]);
  }
  part top_patch(shape=icosphere,material=dark,at=[0,7.98,0],size=[2.3,.25,2.3]);
}
object basketball(label="Basketball"){
  measure(kind=custom,axis=x,meters=.24);
  body(interaction=knockable,radius=4,height=8,friction=.5);
  impact(mode=bounce(restitution=.78,lift=.2));
  part leather(shape=sphere,material=orange,at=[0,4,0],size=[8,8,8]);
  part seam_horizontal(shape=torus,material=dark,at=[0,4,0],size=[8.3,8.3,.3],rot_deg=[90,0,0]);
  part seam_vertical(shape=torus,material=dark,at=[0,4,0],size=[8.3,8.3,.3]);
  part seam_cross(shape=torus,material=dark,at=[0,4,0],size=[8.3,8.3,.3],rot_deg=[0,90,0]);
}
object football_goal(label="Football goal"){
  measure(kind=custom,axis=x,meters=7.4);
  body(interaction=decor,radius=4,height=25);
  repeat posts(index=p,count=2){
    beam upright(shape=cylinder,material=white,from=[p*72-36,0,0],to=[p*72-36,24,0],width=1.2,depth=1.2);
    beam support(shape=cylinder,material=steel,from=[p*72-36,24,0],to=[p*72-36,0,18],width=0.8,depth=0.8);
  }
  beam bar(shape=cylinder,material=white,from=[-36,24,0],to=[36,24,0],width=1.2,depth=1.2);
  repeat threads(index=t,count=9){
    beam thread(shape=cylinder,material=net,from=[t*8-32,24,0],to=[t*8-32,0,18],width=0.5,depth=0.5);
  }
  repeat horizontals(index=n,count=3){
    beam thread(shape=cylinder,material=net,from=[-36,n*8,18-n*6],to=[36,n*8,18-n*6],width=0.5,depth=0.5);
  }
  repeat side_mesh(index=s,count=2){
    repeat rows(index=n,count=3){
      beam cord(shape=cylinder,material=net,from=[s*72-36,n*8,0],to=[s*72-36,n*8,18-n*6],width=.5,depth=.5);
    }
    repeat ribs(index=n,count=3){
      beam cord(shape=cylinder,material=net,from=[s*72-36,0,n*6],to=[s*72-36,24-n*8,n*6],width=.5,depth=.5);
    }
  }
}
object basketball_hoop(label="Basketball hoop"){
  measure(kind=custom,axis=y,meters=4);
  body(interaction=solid,radius=4,height=40);
  beam pole(shape=box,material=steel,from=[0,0,0],to=[0,36,0],width=1.5,depth=1.5);
  beam arm(shape=box,material=steel,from=[0,34,0],to=[0,34,9],width=1.5,depth=1.5);
  part board(shape=box,material=white,at=[0,34,9],size=[18,11,1]);
  part square(shape=box,material=steel,at=[0,33,9.7],size=[6,4,0.5]);
  beam rim_mount(shape=box,material=steel,from=[0,30,9.3],to=[0,30,10.25],width=.5,depth=.5);
  repeat rim_segments(index=r,count=16){
    beam rim(shape=cylinder,material=orange,from=[cos(r*22.5)*2.25,30,12+sin(r*22.5)*2.25],to=[cos((r+1)*22.5)*2.25,30,12+sin((r+1)*22.5)*2.25],width=.18,depth=.18);
  }
  repeat cords(index=c,count=6){
    beam net_cord(shape=cylinder,material=net,from=[cos(c*60)*2,30,12+sin(c*60)*2],to=[cos(c*60),25,12+sin(c*60)],width=0.5,depth=0.5);
  }
}
object golf_pin(label="Golf flag"){
  measure(kind=custom,axis=y,meters=2.2);
  body(interaction=decor,radius=4,height=22);
  beam pole(shape=cylinder,material=white,from=[0,0,0],to=[0,22,0],width=0.5,depth=0.5);
  part flag(shape=box,material=yellow,at=[3,19,0],size=[6,4,0.5],motion=sway(deg=4,hz=0.3));
  part cup(shape=cylinder,material=dark,at=[0,0.3,0],size=[2,0.5,2]);
}
component person(params=[]){
  part body(shape=capsule,material=blue,at=[0,10,0],size=[5,6,3.5]);
  part shorts(shape=box,material=dark,at=[0,7,0],size=[5,2,3.5]);
  part head(shape=sphere,material=skin,at=[0,15,0],size=[3.5,4,3.5]);
  part hair(shape=icosphere,material=hair,at=[0,16.5,0],size=[3.7,1.7,3.6]);
  repeat eyes(index=e,count=2){
    part eye(shape=sphere,material=dark,at=[e*1.4-.7,15.3,1.6],size=[.5,.5,.5]);
  }
  part nose(shape=sphere,material=skin,at=[0,14.8,1.9],size=[.7,.8,.7]);
}
let legacy_human_unit(value=57.20000076293945/17.100000381469727);
material deep_skin(style=toon,colors=[#925e45,#714631]);
component civic_person(params=[athletic,long_sleeves,bag],materials=[top,complexion,handwear,trousers,shoes]){
 joint pelvis(bone=root,at=[0,25,0]){
  part hips(shape=box,material=top,at=[0,-.5,0],size=[7.8,4,11.6]);

  joint chest(bone=spine,at=[0,1,0]){
   part torso(shape=box,material=top,at=[0,8.5,0],size=[8.3,18,12]);
   part neck(shape=box,material=complexion,at=[0,19,0],size=[3.6,4.2,3.8]);
   part head(shape=box,material=complexion,at=[0,25.4,0],size=[9.2,9.2,8.8]);

   part nose(shape=box,material=complexion,at=[5,24.5,0],size=[1,1.4,1.4]);
   part mouth(shape=box,material=dark,at=[4.65,22.8,0],size=[.2,.35,1.1]);
   repeat face(index=s,count=2){
    let side(value=s*2-1);
    part eye(shape=box,material=dark,at=[4.65,26.1,side*2],size=[.2,1,.9]);
    part collar(shape=box,material=white,at=[4.22,16.8,side*1.5],size=[.25,1.2,1.3]);
   }
   repeat uniform(index=u,count=athletic){part stripe(shape=box,material=white,at=[4.22,12.5,0],size=[.25,1,10.4]);}

   repeat backpack(index=b,count=bag){
    part pack(shape=box,material=dark,at=[-5.25,8,0],size=[3.4,11,8.8]);
    repeat straps(index=s,count=2){
     voxels strap(material=dark,at=[0,10.3,s*7.6-3.8],size=[9.1,14.6,1.4],grid=[10,16,2]){
      fill front(from=[9,0,0],to=[10,16,2]);
      fill back(from=[0,0,0],to=[1,16,2]);
      fill shoulder(from=[1,15,0],to=[9,16,2]);
     }
    }
   }
   repeat details(index=d,count=1-athletic){
    part pocket_seam(shape=box,material=dark,at=[4.2,11,-3.2],size=[.2,.35,2.8]);
   }
   joint left_arm(bone=left_shoulder,at=[0,16.4,7.2]){
    part sleeve(shape=box,material=top,at=[0,-4.5,0],size=[3.8,10.5,4]);
    joint left_forearm(bone=left_elbow,at=[0,-9.5,0]){
     repeat bare(index=a,count=1-long_sleeves){part forearm(shape=box,material=complexion,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     repeat covered(index=a,count=long_sleeves){part forearm(shape=box,material=top,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     voxels hand(material=handwear,at=[.4,-9.9,0],size=[3.6,4.5,2.7],grid=[4,5,3]){
      fill palm(from=[0,0,0],to=[3,5,3]);
      fill thumb(from=[3,2,0],to=[4,4,2]);
     }
    }
   }
   joint right_arm(bone=right_shoulder,at=[0,16.4,-7.2]){
    part sleeve(shape=box,material=top,at=[0,-4.5,0],size=[3.8,10.5,4]);
    joint right_forearm(bone=right_elbow,at=[0,-9.5,0]){
     repeat bare(index=a,count=1-long_sleeves){part forearm(shape=box,material=complexion,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     repeat covered(index=a,count=long_sleeves){part forearm(shape=box,material=top,at=[0,-4.3,0],size=[3.2,9.6,3.4]);}
     voxels hand(material=handwear,at=[.4,-9.9,0],size=[3.6,4.5,2.7],grid=[4,5,3]){
      fill palm(from=[0,0,0],to=[3,5,3]);
      fill thumb(from=[3,2,0],to=[4,4,2]);
     }
    }
   }
  }
  joint left_leg(bone=left_hip,at=[0,0,3.3]){
   repeat trousers(index=t,count=1-athletic){part thigh(shape=box,material=trousers,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat bare(index=t,count=athletic){part thigh(shape=box,material=complexion,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat uniform(index=u,count=athletic){part shorts(shape=box,material=top,at=[0,-3.1,0],size=[5.4,8.2,5.5]);}
   joint left_shin(bone=left_knee,at=[0,-11.5,0]){
    repeat trousers(index=t,count=1-athletic){part calf(shape=box,material=trousers,at=[0,-5,0],size=[3.8,10.6,4]);}
    repeat bare(index=t,count=athletic){part calf(shape=box,material=complexion,at=[0,-5,0],size=[3.8,10.6,4]);}
    joint left_foot(bone=left_ankle,at=[0,-10.5,0]){
     repeat uniform(index=u,count=athletic){part sock(shape=box,material=white,at=[0,3,0],size=[4.2,6,4.5]);}
     part shoe(shape=prism,material=shoes,at=[1.4,-1.2,0],size=[7.3,2.9,4.4],outline=[[0,.18],[.12,0],[.78,0],[1,.2],[1,.5],[.87,.72],[.45,.75],[.4,1],[.05,1],[0,.7]]);
     part sole(shape=box,material=white,at=[1.5,-2.7,0],size=[7.6,.6,4.6]);
    }
   }
  }
  joint right_leg(bone=right_hip,at=[0,0,-3.3]){
   repeat trousers(index=t,count=1-athletic){part thigh(shape=box,material=trousers,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat bare(index=t,count=athletic){part thigh(shape=box,material=complexion,at=[0,-5.5,0],size=[4.2,11.5,4.4]);}
   repeat uniform(index=u,count=athletic){part shorts(shape=box,material=top,at=[0,-3.1,0],size=[5.4,8.2,5.5]);}
   joint right_shin(bone=right_knee,at=[0,-11.5,0]){
    repeat trousers(index=t,count=1-athletic){part calf(shape=box,material=trousers,at=[0,-5,0],size=[3.8,10.6,4]);}
    repeat bare(index=t,count=athletic){part calf(shape=box,material=complexion,at=[0,-5,0],size=[3.8,10.6,4]);}
    joint right_foot(bone=right_ankle,at=[0,-10.5,0]){
     repeat uniform(index=u,count=athletic){part sock(shape=box,material=white,at=[0,3,0],size=[4.2,6,4.5]);}
     part shoe(shape=prism,material=shoes,at=[1.4,-1.2,0],size=[7.3,2.9,4.4],outline=[[0,.18],[.12,0],[.78,0],[1,.2],[1,.5],[.87,.72],[.45,.75],[.4,1],[.05,1],[0,.7]]);
     part sole(shape=box,material=white,at=[1.5,-2.7,0],size=[7.6,.6,4.6]);
    }
   }
  }
 }
}

component hair_cut(params=[long_hair],materials=[tone]){
 voxels hair(material=tone,at=[-.3,25.1,0],size=[10.2,12.2,10],grid=[10,12,10]){
  fill crown(from=[0,10,0],to=[10,12,10]);
  fill back(from=[0,4-long_hair*4,0],to=[2,10,10]);
  fill left(from=[2,5-long_hair*5,0],to=[8,10,1]);
  fill right(from=[2,5-long_hair*5,9],to=[8,10,10]);
  fill fringe_left(from=[8,9,0],to=[10,10,4]);
  fill fringe_right(from=[8,9,6],to=[10,10,10]);
 }
}
component curls(params=[],materials=[tone]){
 voxels hair(material=tone,at=[-.3,25.1,0],size=[10.2,12.2,10],grid=[10,12,10]){
  fill crown(from=[1,8,1],to=[9,12,9]);
  fill left(from=[1,6,0],to=[8,11,2]);
  fill right(from=[1,6,8],to=[8,11,10]);
  fill back(from=[0,4,1],to=[3,11,9]);
  fill fringe(from=[8,8,1],to=[10,11,9]);
  cut corner_a(from=[1,11,1],to=[3,12,3]);
  cut corner_b(from=[7,11,1],to=[9,12,3]);
  cut corner_c(from=[1,11,7],to=[3,12,9]);
  cut corner_d(from=[7,11,7],to=[9,12,9]);
 }
}
object football_player(label="Football player"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=4*legacy_human_unit,height=18*legacy_human_unit);
 use anatomy(component=civic_person,args=[1,0,0],materials=[blue,skin,skin,dark,white]);
 mount head(bone=spine){use hair(component=hair_cut,args=[0],materials=[hair]);}
}
object basketball_player(label="Basketball player"){
 measure(kind=person,axis=y,meters=1.8);
 body(interaction=decor,radius=4*legacy_human_unit,height=18*legacy_human_unit);
 use anatomy(component=civic_person,args=[1,0,0],materials=[blue,deep_skin,deep_skin,dark,dark]);
 mount head(bone=spine){use hair(component=curls,materials=[hair]);}
}
object town_walker(label="Town pedestrian"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=4,height=18);
  group facing(rot_deg=[0,90,0]){
    use torso(component=person);
    joint leg_0(at=[-1.5,7,0],motion=swing(axis=x,deg=17,hz=0.6,phase_deg=0)){
      part shin(shape=capsule,material=skin,at=[0,-3,0],size=[1.7,6,1.7]);
      part shoe(shape=box,material=white,at=[0,-6,1],size=[2,1.5,3.5]);
    }
    joint arm_0(at=[-3,12,0],motion=swing(axis=x,deg=15,hz=0.6,phase_deg=90)){
      part sleeve(shape=capsule,material=blue,at=[0,-1,0],size=[2,3,2]);
      part hand(shape=capsule,material=skin,at=[0,-3.5,0],size=[1.5,3.5,1.5]);
    }
    joint leg_1(at=[1.5,7,0],motion=swing(axis=x,deg=17,hz=0.6,phase_deg=180)){
      part shin(shape=capsule,material=skin,at=[0,-3,0],size=[1.7,6,1.7]);
      part shoe(shape=box,material=white,at=[0,-6,1],size=[2,1.5,3.5]);
    }
    joint arm_1(at=[3,12,0],motion=swing(axis=x,deg=15,hz=0.6,phase_deg=-90)){
      part sleeve(shape=capsule,material=blue,at=[0,-1,0],size=[2,3,2]);
      part hand(shape=capsule,material=skin,at=[0,-3.5,0],size=[1.5,3.5,1.5]);
    }
  }
}
object park_walker(label="Park walker"){
  measure(kind=person,axis=y,meters=1.8);
  body(interaction=decor,radius=4,height=18);
  group facing(rot_deg=[0,90,0]){
    use torso(component=person);
    joint leg_0(at=[-1.5,7,0],motion=swing(axis=x,deg=17,hz=0.6,phase_deg=0)){
      part shin(shape=capsule,material=skin,at=[0,-3,0],size=[1.7,6,1.7]);
      part shoe(shape=box,material=white,at=[0,-6,1],size=[2,1.5,3.5]);
    }
    joint arm_0(at=[-3,12,0],motion=swing(axis=x,deg=15,hz=0.6,phase_deg=90)){
      part sleeve(shape=capsule,material=blue,at=[0,-1,0],size=[2,3,2]);
      part hand(shape=capsule,material=skin,at=[0,-3.5,0],size=[1.5,3.5,1.5]);
    }
    joint leg_1(at=[1.5,7,0],motion=swing(axis=x,deg=17,hz=0.6,phase_deg=180)){
      part shin(shape=capsule,material=skin,at=[0,-3,0],size=[1.7,6,1.7]);
      part shoe(shape=box,material=white,at=[0,-6,1],size=[2,1.5,3.5]);
    }
    joint arm_1(at=[3,12,0],motion=swing(axis=x,deg=15,hz=0.6,phase_deg=-90)){
      part sleeve(shape=capsule,material=blue,at=[0,-1,0],size=[2,3,2]);
      part hand(shape=capsule,material=skin,at=[0,-3.5,0],size=[1.5,3.5,1.5]);
    }
  }
}
object park_visitor(label="Park visitor"){
  measure(kind=person,axis=y,meters=1.75);
  body(interaction=decor,radius=4,height=18);
  group facing(rot_deg=[0,90,0]){
    use torso(component=person);
    repeat legs(index=l,count=2){
      part leg(shape=capsule,material=dark,at=[l*3-1.5,3.5,0],size=[1.8,7,1.8]);
      part shoe(shape=box,material=white,at=[l*3-1.5,0.7,1],size=[2,1.5,3]);
    }
    repeat arms(index=a,count=2){
      part arm(shape=capsule,material=skin,at=[a*6-3,9.5,0],size=[1.8,6,1.8],rot_deg=[0,0,a*16-8]);
    }
  }
}
