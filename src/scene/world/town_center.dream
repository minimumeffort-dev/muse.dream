dream 2;
behavior town_attention(start=walking){
  state walking(action=patrol){
    on notice(event=near_player,to=watching,radius=65);
  }
  state watching(action=idle,face=player){
    on leave(event=far_player,to=walking,radius=95);
  }
}
behavior square_attention(start=waiting){
  state waiting(action=idle){on notice(event=near_player,to=watching,radius=65);}
  state watching(action=idle,face=player){on leave(event=far_player,to=waiting,radius=95);}
}

