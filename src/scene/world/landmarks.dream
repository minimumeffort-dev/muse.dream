object little_rally_car(label="Little rally car"){
  measure(kind=car,axis=x,meters=3.55);
  body(interaction=solid,radius=11,height=14);
  part shell(shape=prism,material=m11,at=[0.25,5.84,0],size=[34.3,6.92,17.8],outline=[[0,0],[0.08017,0],[0.08017,0.1474],[0.09638,0.44725],[0.14067,0.66676],[0.20117,0.74711],[0.26166,0.66676],[0.30595,0.44725],[0.32216,0.1474],[0.32216,0],[0.66327,0],[0.66327,0.1474],[0.67948,0.44725],[0.72376,0.66676],[0.78426,0.74711],[0.84475,0.66676],[0.88904,0.44725],[0.90525,0.1474],[0.90525,0],[1,0],[1,0.76879],[0.92711,1],[0.06997,1],[0,0.85549]]);
  part cabin(shape=prism,material=glazing,at=[-2,12.05,0],size=[19.6,6.5,14.6],outline=[[0,0],[1,0],[0.71939,1],[0.2398,1]]);
  part roof(shape=box,material=m4,at=[-2.4,15.55,0],size=[10,0.9,15.4]);
  repeat sides(index=s,count=2){
    let side(value=s*2-1);
    beam front_pillar(shape=box,material=m11,from=[7.8,8.8,side*7.35],to=[2.3,15.35,side*7.35],width=.8,depth=.8);
    beam rear_pillar(shape=box,material=m11,from=[-11.8,8.8,side*7.35],to=[-7.1,15.35,side*7.35],width=.8,depth=.8);
    beam mirror(shape=box,material=m11,from=[6.6,10.1,side*7.6],to=[7,10.3,side*10.1],width=1.2,depth=1.2);

    part headlight(shape=box,material=m13,at=[17.55,7,side*5.34],size=[.6,2.2,3.2]);
    part tail_light(shape=box,material=m6,at=[-17.05,7.1,side*5.874],size=[.6,2.5,2.2]);
  }
  part front_bumper(shape=box,material=m1,at=[17.3,3.5,0],size=[1.4,1.5,18]);
  part rear_bumper(shape=box,material=m1,at=[-16.8,3.5,0],size=[1.4,1.5,18]);
  part grille(shape=box,material=m1,at=[17.65,5.1,0],size=[.5,2.1,7]);
  part bonnet_stripe(shape=box,material=m4,at=[10.9,9.5,0],size=[6.4,.5,3]);
  repeat spoiler_posts(index=s,count=2){beam post(shape=cylinder,material=m1,from=[-15.5,8.5,s*10-5],to=[-15.5,13.3,s*10-5],width=.9,depth=.9);}
  part spoiler(shape=box,material=m11,at=[-15.5,13.8,0],size=[4,1.3,20]);
  repeat axles(index=w,count=2){
    part suspension_yoke(shape=box,material=m1,at=[(w*2-1)*10,5.725,0],size=[1.4,4.65,11.8]);
    joint bearing(at=[(w*2-1)*10,3.4,0],rot_deg=[0,180,0],motion=roll(axis=z,radius=3.4)){
      part shaft(shape=cylinder,material=m1,at=[0,0,0],size=[1.1,16.1,1.1],rot_deg=[90,0,0]);
      repeat wheels(index=s,count=2){
        part tire(shape=cylinder,material=m1,at=[0,0,(s*2-1)*7.8],size=[6.8,2.6,6.8],rot_deg=[90,0,0]);
        part hub(shape=cylinder,material=metal,at=[0,0,(s*2-1)*7.8],size=[3.57,2.8,3.57],rot_deg=[90,0,0]);
      }
    }
  }
}
