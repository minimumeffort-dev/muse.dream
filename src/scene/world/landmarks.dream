  part battlement_7(shape=box,material=m0,at=[7,44,8],size=[4,6,4]);
  repeat tower_trim(index=t,count=2){
    repeat tower_row(index=r,count=2){
      part collar(shape=cylinder,material=trim,at=[t*32-16,37,r*28-14],size=[11,3,11]);
    }
  }
  repeat gate_posts(index=s,count=2){part jamb(shape=box,material=trim,at=[s*12-6,9,15],size=[3,18,2]);}
