dream 2;
behavior lake_attention(start=walking){
  state walking(action=patrol){
    on notice(event=near_player,to=watching,radius=65);
  }
  state watching(action=idle,face=player){
    on leave(event=far_player,to=walking,radius=95);
  }
}
behavior park_attention(start=waiting){
  state waiting(action=idle){on notice(event=near_player,to=watching,radius=65);}
  state watching(action=idle,face=player){on leave(event=far_player,to=waiting,radius=95);}
}
behavior sports_routine(start=playing){
  state playing(action=perform){
    on notice(event=near_player,to=watching,radius=55);
    on pause(event=after,to=resting,seconds=8);
  }
  state resting(action=idle){
    on notice(event=near_player,to=watching,radius=55);
    on resume(event=after,to=playing,seconds=3);
  }
  state watching(action=idle,face=player){
    on leave(event=far_player,to=playing,radius=85);
  }
}

