  part rope(shape=cylinder,material=m3,at=[0,22,0],size=[.5,9,.5]);
  part crank(shape=box,material=m3,at=[17,24,0],size=[2,8,2]);
  part crank_grip(shape=cylinder,material=m5,at=[19,20,0],size=[2,5,2],rot_deg=[0,0,90]);
  part coping(shape=torus,material=m4,at=[0,12,0],size=[28,28,3],rot_deg=[90,0,0]);
