object old_apple_tree(label="Old apple tree"){
  measure(kind=tree,axis=y,meters=5.5);
  body(interaction=solid,radius=11,height=37);
  part trunk(shape=cylinder,material=m3,at=[0,10,0],size=[5,20,5]);
  part crown_left(shape=icosphere,material=m1,at=[-8,25,0],size=[23,21,22],motion=sway(deg=1.0313240312354817,hz=0.1432394487827058),deform=deform(seed=25131,amount=.14));
  part crown_right(shape=icosphere,material=m2,at=[8,26,1],size=[25,21,23],motion=sway(deg=1.0313240312354817,hz=0.1432394487827058),deform=deform(seed=25162,amount=.14));
  part apple_0(shape=sphere,material=m9,at=[-13,24,7],size=[3,3,3]);
  part apple_1(shape=sphere,material=m9,at=[6,28,11],size=[3,3,3]);
  part apple_2(shape=sphere,material=m9,at=[15,23,5],size=[3,3,3]);
  part apple_3(shape=sphere,material=m9,at=[-1,19,8],size=[3,3,3]);
  beam left_fork(shape=cylinder,material=m3,from=[0,10,0],to=[-8,24,0],width=3,depth=3);
  beam right_fork(shape=cylinder,material=m3,from=[0,10,0],to=[9,25,1],width=3,depth=3);
  repeat fruit_stems(index=f,count=2){part stem(shape=cylinder,material=m3,at=[f*19-13,26+f*4,7+f*4],size=[.6,2,.6]);}
}

