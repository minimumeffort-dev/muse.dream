  body(interaction=solid,radius=27,height=14);
  ground(mode=surface);
  part slab(shape=icosphere,material=m4,at=[0,5,0],size=[51,14,30],rot_deg=[0,-22.91831180523293,3.437746770784939],deform=deform(seed=637,amount=.18));
  part lichen_patch(shape=icosphere,material=lichen,at=[-4,10,0],size=[18,2,14],deform=deform(seed=61,amount=.21));
}
object standing_deadwood(label="Standing deadwood"){
  measure(kind=tree,axis=y,meters=6);
  body(interaction=solid,radius=9,height=42);
  beam trunk(shape=cylinder,material=m3,from=[0,0,0],to=[.6,41,1.2],width=7,depth=6.4,taper=.38,deform=deform(seed=63,amount=.04));
  beam cut_top(shape=cylinder,material=end_grain,from=[.596,40.8,1.194],to=[.604,41.3,1.209],width=2.1,depth=1.9);
  beam left_branch(shape=cylinder,material=m3,from=[.3,21,.6],to=[-12.7,34.4,2.1],width=2.8,depth=2.5,taper=.4);
  beam left_snap(shape=cylinder,material=end_grain,from=[-12.5,34.19,2.077],to=[-12.85,34.55,2.117],width=.9,depth=.8);
  beam right_branch(shape=cylinder,material=m3,from=[.2,15,.4],to=[11.3,29.5,-4.9],width=2.7,depth=2.4,taper=.4);
  beam right_snap(shape=cylinder,material=end_grain,from=[11.13,29.28,-4.82],to=[11.46,29.71,-4.977],width=.85,depth=.75);
  beam snapped_twig(shape=cylinder,material=m3,from=[0,11,0],to=[-5,16,6],width=2,depth=1.8,taper=.4);
  part root_flare(shape=icosphere,material=m3,at=[0,1.6,0],size=[8.5,3.8,7.8],deform=deform(seed=93,amount=.1));
  beam root_left(shape=cylinder,material=m3,from=[0,4,0],to=[-5,.6,2],width=2.2,depth=2.2,taper=.35);
  beam root_right(shape=cylinder,material=m3,from=[0,4,0],to=[5,.6,-1],width=2.2,depth=2.2,taper=.35);
  beam root_back(shape=cylinder,material=m3,from=[0,4,0],to=[1,.5,-4],width=2.2,depth=2.2,taper=.35);
  part bark_scar(shape=box,material=bark_ridge,at=[1,11,2.6],size=[1.2,7,.6],rot_deg=[-5,10,-4]);
  part base_moss(shape=icosphere,material=lichen,at=[-.8,4.5,3.5],size=[4.5,2,1.5],deform=deform(seed=92,amount=.13));
}
object fallen_log(label="Fallen log"){
  measure(kind=custom,axis=x,meters=3);
  body(interaction=solid,radius=23,height=16);
  ground(mode=surface);
  part log(shape=cylinder,material=m3,at=[0,5.5,0],size=[11,44,11],rot_deg=[0,0,90]);
  repeat ends(index=e,count=2){
    let x(value=e*44.2-22.1);
    part cut(shape=cylinder,material=end_grain,at=[x,5.5,0],size=[9,.6,9],rot_deg=[0,0,90]);
    part ring(shape=torus,material=end_ring,at=[x+(e*2-1)*.28,5.5,0],size=[6.3,6.3,.5],rot_deg=[0,90,0]);
    part pith(shape=cylinder,material=end_ring,at=[x+(e*2-1)*.28,5.5,0],size=[1.2,.5,1.2],rot_deg=[0,0,90]);
  }
  beam broken_branch(shape=capsule,material=m3,from=[-6,7.5,.5],to=[-1.5,13,3],width=2.4,depth=2.4);
  beam branch_snap(shape=cylinder,material=end_grain,from=[-1.8,12.6,2.8],to=[-1.5,13,3],width=1.8,depth=1.8);
  part upper_groove(shape=box,material=bark_mark,at=[-10,10.7,.8],size=[13,.55,.7],rot_deg=[0,-3,0]);
  part front_groove(shape=box,material=bark_mark,at=[2,8.2,4.75],size=[17,.5,.6],rot_deg=[-30,0,2]);
  part back_ridge(shape=box,material=bark_ridge,at=[13,9.8,-3.2],size=[8,.55,.7],rot_deg=[35,0,-5]);
  part knot(shape=torus,material=end_ring,at=[8,7.5,5.1],size=[2.4,2,.6],rot_deg=[-22,0,0]);
  part moss_left(shape=icosphere,material=lichen,at=[-10,10.1,-1],size=[13,1.4,5],deform=deform(seed=117,amount=.13));
  part moss_right(shape=icosphere,material=lichen,at=[13,9.9,-1.5],size=[8,1.6,4],deform=deform(seed=133,amount=.15));
}
object timber_barn(label="Timber barn"){
