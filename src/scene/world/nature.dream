  part stone_6(shape=box,material=m4,at=[-11,6,-2.0206672185931327e-15],size=[9,12,5],rot_deg=[0,-90,0]);
  part stone_7(shape=box,material=m4,at=[-7.778174593052024,6,7.778174593052021],size=[9,12,5],rot_deg=[0,-45,0]);
