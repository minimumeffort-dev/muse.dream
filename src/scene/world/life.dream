dream 2;
asset a_roe_deer(module=fauna,object=roe_deer);
asset a_river_gull(module=fauna,object=river_gull);
asset a_market_vendor(module=city_people,object=market_vendor);
asset a_health_worker(module=city_people,object=health_worker);
asset a_teacher(module=city_people,object=teacher);
asset a_football_player(module=sports_assets,object=football_player);
asset a_basketball_player(module=sports_assets,object=basketball_player);
route woodland_deer(kind=ambient,mode=loop,speed=10){
 point(at=[800,4300]);
 point(at=[1000,4500]);
 point(at=[800,4800]);
 point(at=[600,4600]);
}
route river_birds(kind=ambient,mode=loop,speed=38,altitude=220){
 point(at=[8800,2500]);
 point(at=[9200,4500]);
 point(at=[9500,6500]);
 point(at=[8900,5500]);
}
place woodland_deer_npc(object=a_roe_deer,route=woodland_deer,offset=0,role=npc);
place river_gull_npc(object=a_river_gull,route=river_birds,offset=0,role=npc);
behavior public_life(start=busy){
 state busy(action=perform,face=none){on look(event=near_player,radius=90,to=hello);}
 state hello(action=idle,face=player){on resume(event=far_player,radius=130,to=busy);}
}
place vendor(object=a_market_vendor,at=[6400,4350],role=npc,behavior=public_life);
place doctor(object=a_health_worker,at=[3900,6600],role=npc,behavior=public_life);
place teacher(object=a_teacher,at=[4430,3420],role=npc,behavior=public_life);
place footballer_a(object=a_football_player,at=[10400,4650],role=npc,behavior=public_life);
place footballer_b(object=a_football_player,at=[10740,4760],role=npc,behavior=public_life);
place basketballer_a(object=a_basketball_player,at=[7230,7970],role=npc,behavior=public_life);
place basketballer_b(object=a_basketball_player,at=[7340,7980],role=npc,behavior=public_life);
asset a_commuter(module=city_people,object=commuter);
route market_commute(kind=walk,mode=shuttle,speed=10){
 stop home(at=[6493.348,4064.717],wait_s=6,site=access_oldtown_044);
 point(at=[6493.348,4112]);
 point(at=[6400,4112]);
 point(at=[6400,4288]);
 stop market(at=[6400,4398],wait_s=12,site=access_market_hall);
}
behavior commuter_routine(start=journey){
 state journey(action=patrol,face=none){on greet(event=near_player,radius=45,to=hello);}
 state hello(action=idle,face=player){on resume(event=far_player,radius=70,to=journey);}
}
place market_commuter(object=a_commuter,route=market_commute,role=npc,behavior=commuter_routine);

asset shopper(module=city_people,object=river_shopper);
asset student(module=city_people,object=campus_student);
asset neighbor(module=city_people,object=park_neighbor);
asset resident(module=city_people,object=city_resident);
asset parked_hatchback(module=street_assets,object=city_hatchback);
asset parked_van(module=street_assets,object=delivery_van);
asset parked_sedan(module=landmarks,object=town_car);
furnish center_residents(objects=[shopper,resident,a_commuter],streets=[market_avenue,high_street,civic_walk,north_avenue],spacing=600,setback=0,seed=302,side=left,pose=rest,on=sidewalk,facing=varied,jitter=.3);
furnish neighborhood_residents(objects=[neighbor,resident,student],streets=[garden_collector,garden_crescent,school_street,south_terrace,hospital_street],spacing=600,setback=0,seed=303,pose=rest,on=sidewalk,facing=varied,jitter=.3);
furnish east_residents(objects=[shopper,student,resident],streets=[eastbank,station_avenue,harbor_street,workshop_street,airfield_road],spacing=600,setback=0,seed=304,side=right,pose=rest,on=sidewalk,facing=varied,jitter=.3);
furnish civic_parking(objects=[parked_hatchback,parked_sedan],sites=[access_garden_school,access_south_school,access_hospital,access_offices,access_college],spacing=58,setback=5,count=8,seed=311,grounds=[hospital_apron],paving=#aaa99f);
furnish east_parking(objects=[parked_hatchback,parked_sedan,parked_van],sites=[access_east_medical_center,access_harbor_market,access_airport,access_harbor_workshops],spacing=62,setback=5,count=8,seed=312,grounds=[airport_forecourt,east_medical_apron],paving=#aaa99f);
behavior neighborhood_greeting(start=rest){
 state rest(action=idle,face=none){on hello(event=near_player,radius=80,to=greet);}
 state greet(action=idle,face=player){on resume(event=far_player,radius=120,to=rest);}
}
place market_neighbor(object=neighbor,at=[6460,4380],role=npc,behavior=neighborhood_greeting);
place hospital_visitor(object=shopper,at=[4040,6610],role=npc,behavior=neighborhood_greeting);
place school_student(object=student,at=[4490,3470],role=npc,behavior=neighborhood_greeting);
place station_resident(object=resident,at=[11000,4112],role=npc,behavior=neighborhood_greeting);
include resting_wildlife(module=fauna);
include understory(module=flora);
include woodland_edges(module=nature);
