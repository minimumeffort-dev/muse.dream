dream 2;
asset a_roe_deer(module=fauna,object=roe_deer);
asset a_river_gull(module=fauna,object=river_gull);
asset a_market_vendor(module=city_people,object=market_vendor);
asset a_health_worker(module=city_people,object=health_worker);
asset a_teacher(module=city_people,object=teacher);
asset a_football_player(module=sports_assets,object=football_player);
asset a_basketball_player(module=sports_assets,object=basketball_player);
route woodland_deer(kind=ambient,mode=loop,speed=10){
 point(at=[800,4300]);
 point(at=[1000,4500]);
 point(at=[800,4800]);
 point(at=[600,4600]);
}
route river_birds(kind=ambient,mode=loop,speed=38,altitude=220){
 point(at=[8800,2500]);
 point(at=[9200,4500]);
 point(at=[9500,6500]);
 point(at=[8900,5500]);
}
behavior woodland_attention(start=walking){
 state walking(action=patrol){on notice(event=near_player,radius=90,to=watching);}
 state watching(action=idle,face=player){on resume(event=far_player,radius=130,to=walking);}
}
place woodland_deer_npc(object=a_roe_deer,route=woodland_deer,offset=0,role=npc,behavior=woodland_attention);
place river_gull_npc(object=a_river_gull,route=river_birds,offset=0,role=npc);
behavior public_life(start=busy){
 state busy(action=perform,face=none){on look(event=near_player,radius=90,to=hello);}
 state hello(action=idle,face=player){on resume(event=far_player,radius=130,to=busy);}
}
place vendor(object=a_market_vendor,at=[6455,4475],role=npc,behavior=market_chat);
place doctor(object=a_health_worker,at=[3900,6600],role=npc,behavior=health_chat);
place teacher(object=a_teacher,at=[4436,3420],role=npc,behavior=school_chat);
place footballer_a(object=a_football_player,at=[10400,4650],role=npc,behavior=public_life);
place footballer_b(object=a_football_player,at=[10740,4760],role=npc,behavior=public_life);
place basketballer_a(object=a_basketball_player,at=[7230,7970],role=npc,behavior=public_life);
place basketballer_b(object=a_basketball_player,at=[7340,7980],role=npc,behavior=public_life);
asset a_commuter(module=city_people,object=commuter);
route market_commute(kind=walk,mode=shuttle,speed=10){
 stop home(at=[6493.348,4064.717],wait_s=6,site=access_oldtown_044);
 point(at=[6493.348,4112]);
 point(at=[6400,4112]);
 point(at=[6400,4288]);
 stop market(at=[6400,4398],wait_s=12,site=access_market_hall);
}
behavior commuter_routine(start=journey){
 state journey(action=patrol,face=none){on greet(event=near_player,radius=45,to=hello);}
 state hello(action=idle,face=player){on talk(event=interact,to=chat,radius=45);on resume(event=far_player,radius=70,to=journey);}
 state chat(action=idle,face=player,say="I walk between home and the market. It is a good way to see the neighborhood."){
  on finish(event=after,to=hello,seconds=6);on resume(event=far_player,radius=70,to=journey);
 }
}
place market_commuter(object=a_commuter,route=market_commute,role=npc,behavior=commuter_routine);

asset shopper(module=city_people,object=river_shopper);
asset student(module=city_people,object=campus_student);
asset neighbor(module=city_people,object=park_neighbor);
asset resident(module=city_people,object=city_resident);
asset parked_hatchback(module=street_assets,object=city_hatchback,control=car);
asset parked_van(module=street_assets,object=delivery_van,control=car);
asset parked_sedan(module=landmarks,object=town_car);
furnish center_residents(objects=[shopper,resident,a_commuter],streets=[market_avenue,high_street,civic_walk,north_avenue],spacing=600,setback=0,seed=302,side=left,motion=walk(speed=14,wait_s=1),on=sidewalk,facing=varied,jitter=.3);
furnish neighborhood_residents(objects=[neighbor,resident,student],streets=[garden_collector,garden_crescent,school_street,south_terrace,hospital_street],spacing=600,setback=0,seed=303,motion=walk(speed=14,wait_s=1),on=sidewalk,facing=varied,jitter=.3);
furnish east_residents(objects=[shopper,student,resident],streets=[eastbank,station_avenue,harbor_street,workshop_street,airfield_road],spacing=600,setback=0,seed=304,side=right,motion=walk(speed=14,wait_s=1),on=sidewalk,facing=varied,jitter=.3);
furnish civic_parking(objects=[parked_hatchback,parked_sedan],sites=[access_garden_school,access_south_school,access_hospital,access_offices,access_college],spacing=58,setback=5,count=8,seed=311,grounds=[hospital_apron],paving=#aaa99f,role=controllable);
furnish east_parking(objects=[parked_hatchback,parked_sedan,parked_van],sites=[access_east_medical_center,access_harbor_market,access_airport,access_harbor_workshops],spacing=62,setback=5,count=8,seed=312,grounds=[airport_forecourt,east_medical_apron],paving=#aaa99f,role=controllable);
behavior neighborhood_greeting(start=rest){
 state rest(action=idle,face=none){on hello(event=near_player,radius=80,to=greet);}
 state greet(action=idle,face=player){on resume(event=far_player,radius=120,to=rest);}
}
place market_neighbor(object=neighbor,at=[6480,4475],role=npc,behavior=neighborhood_greeting);
place hospital_visitor(object=shopper,at=[4040,6610],role=npc,behavior=neighborhood_greeting);
place school_student(object=student,at=[4440,3436],role=npc,behavior=neighborhood_greeting);
place station_resident(object=resident,at=[11000,4112],role=npc,behavior=neighborhood_greeting);
include resting_wildlife(module=fauna);
include understory(module=flora);
include woodland_edges(module=nature);

behavior market_chat(start=busy){
 state busy(action=perform){on recognize(event=interact,to=recognized,radius=55,requires=practiced_baker);on talk(event=interact,to=hello,radius=55,familiar=false);on welcome_back(event=interact,to=returning,radius=55,familiar=true);on look(event=near_player,to=watching,radius=90);}
 state watching(action=idle,face=player){on recognize(event=interact,to=recognized,radius=55,requires=practiced_baker);on talk(event=interact,to=hello,radius=55,familiar=false);on welcome_back(event=interact,to=returning,radius=55,familiar=true);on leave(event=far_player,to=busy,radius=130);}
 state hello(action=idle,face=player,say="Hello. Welcome to the market."){
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state returning(action=idle,face=player,say="Good to see you again. Welcome back."){
  on meal_memory(event=interact,to=shared_lunch,radius=55,shared_meals=1);
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state about(action=idle,face=player,say="You can bake bread, pack lunches, assemble repair kits, deliver to the school or help repair the neighborhood."){
  on again(event=interact,to=hello,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state recognized(action=idle,face=player,say="You have baked three batches here. You can take the larger batch now, with more bread and better pay."){
  on meal_memory(event=interact,to=shared_lunch,radius=55,shared_meals=1);
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state shared_lunch(action=idle,face=player,say="Thanks for sharing a meal. You can take the larger bread batch at the bakery now."){
  on friends(event=interact,to=friend,radius=55,shared_meals=3);on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state friend(action=idle,face=player,say="We have shared a few meals now. I look forward to these breaks with you."){
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
}

behavior health_chat(start=busy){
 state busy(action=perform){on talk(event=interact,to=hello,radius=55,familiar=false);on welcome_back(event=interact,to=returning,radius=55,familiar=true);on look(event=near_player,to=watching,radius=90);}
 state watching(action=idle,face=player){on talk(event=interact,to=hello,radius=55,familiar=false);on welcome_back(event=interact,to=returning,radius=55,familiar=true);on leave(event=far_player,to=busy,radius=130);}
 state hello(action=idle,face=player,say="Hello. I am taking a break. How is your day going?"){
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state returning(action=idle,face=player,say="Good to see you again. Welcome back."){
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state about(action=idle,face=player,say="It is good to get outside for a while."){
  on again(event=interact,to=hello,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
}

behavior school_chat(start=busy){
 state busy(action=perform){on recognize(event=interact,to=helped,radius=55,requires=school_helper);on talk(event=interact,to=hello,radius=55,familiar=false);on welcome_back(event=interact,to=returning,radius=55,familiar=true);on look(event=near_player,to=watching,radius=90);}
 state watching(action=idle,face=player){on recognize(event=interact,to=helped,radius=55,requires=school_helper);on talk(event=interact,to=hello,radius=55,familiar=false);on welcome_back(event=interact,to=returning,radius=55,familiar=true);on leave(event=far_player,to=busy,radius=130);}
 state hello(action=idle,face=player,say="Hello. Good to see a new face in the neighborhood."){
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state returning(action=idle,face=player,say="Good to see you again. Welcome back."){
  on meal_memory(event=interact,to=shared_lunch,radius=55,shared_meals=1);
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state about(action=idle,face=player,say="Our canteen takes bread deliveries from the market. The food goes into real stock here."){
  on again(event=interact,to=hello,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state helped(action=idle,face=player,say="Thank you for bringing bread to the school. It is on the canteen shelf, ready for people to buy."){
  on meal_memory(event=interact,to=shared_lunch,radius=55,shared_meals=1);
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state shared_lunch(action=idle,face=player,say="I enjoyed sharing that meal with you. It is good to have company during a break."){
  on friends(event=interact,to=friend,radius=55,shared_meals=3);on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
 state friend(action=idle,face=player,say="We have shared a few meals now. I look forward to these breaks with you."){
  on ask(event=interact,to=about,radius=55);on finish(event=after,to=watching,seconds=6);on leave(event=far_player,to=busy,radius=130);
 }
}

economy(){
 rest home_rest(energy=35,drain_s=.1,recover_s=5,below=25,until=85,shelter=true,seats=[home_upper_settee,home_settee],on=oldtown_044,grounds=[home_entry,market_square,market_hall,home_upper,home_landing]);
 rest player_rest(energy=65,drain_s=.05,recover_s=5,below=25,until=85,seats=[home_settee],on=oldtown_044);
 ration field_snack(good=vegetables,market=market_stall,below=40);
 ration school_snack(good=bread,market=school_canteen,below=40);
 good bread(label="Bread",food=45);
 good flour(label="Flour");
 good timber(label="Repair kit");
 good sapling(label="Tree sapling");
 good vegetables(label="Vegetables",food=20);
 good lunch(label="Packed lunch",food=65);
 good boards(label="Timber boards");
 good fasteners(label="Fasteners");
 account pocket(rest=player_rest,actor=player,credits=20,capacity=8,satiety=48,drain_s=.05);
 account baker(actor=vendor,credits=0,capacity=4,satiety=65,drain_s=.05,shop=true,social=hall_break,shift=bakery_day,works=[assemble_kit,propagate_saplings,pack_lunch,bake]);
 social hall_break(good=bread,seats=[hall_bench],on=market_hall,grounds=[market_square],eat_s=8,cooldown_s=600,markets=[market_stall]);
 social school_break(good=bread,seats=[school_bench,school_common_bench,school_reading_bench,school_rear_bench],on=school_yard,grounds=[school_yard_access,school_yard_return,garden_school,school_doorstep],eat_s=8,cooldown_s=600,markets=[school_canteen]);
 shift bakery_day(market=market_stall,rest=[6360,4490],on=market_hall,grounds=[market_square],lead_s=15);
 shift school_day(market=school_canteen,rest=[4390,3590],on=school_yard,grounds=[school_yard_access,school_yard_return,garden_school,school_doorstep],lead_s=50);
 meal market_break(good=lunch,markets=[market_stall],on=market_hall,grounds=[market_square,oldtown_044,home_entry],eat_s=4,seats=[home_settee,hall_bench]);
 account regular(rest=home_rest,actor=market_commuter,credits=30,capacity=4,satiety=25,drain_s=.05,meal=market_break,works=[large_bake,bake],commute=true,attendance=[6,20],on=oldtown_044,grounds=[home_entry,market_square,market_hall]);
 account school_staff(actor=teacher,credits=30,capacity=4,satiety=28,drain_s=.05,shop=true,social=school_break,shift=school_day);
 account caretaker(ration=field_snack,actor=market_neighbor,credits=0,capacity=4,satiety=65,drain_s=.05,shop=true,repairs=[market_tables,orchard_trees,classroom_furniture,home_furniture],deliveries=[kits_run,saplings_run,flour_run,boards_run]);
 account porter(ration=school_snack,actor=school_student,credits=0,capacity=4,satiety=65,drain_s=.05,shop=true,deliveries=[fasteners_run,school_run]);
 account depot_owner(actor=station_resident,credits=0,capacity=4,satiety=65,drain_s=0);
 market station_supplies(label="Station supplies",actor=station_resident,credits=0,radius=70,hours=[6,22],owner=depot_owner,sale=15){
  lot flour_store(good=flour,quantity=80,limit=80);
  lot depot_kits(good=timber,quantity=32,limit=32);
  lot depot_saplings(good=sapling,quantity=18,limit=18);
  lot depot_boards(good=boards,quantity=16,limit=16);
  lot depot_fasteners(good=fasteners,quantity=16,limit=16);
 }
 market school_canteen(label="School canteen",actor=teacher,credits=60,radius=70,hours=[8,17]){
  lot bread_counter(good=bread,quantity=0,limit=12,price=5);
 }
 market market_stall(label="Market bakery",actor=vendor,credits=100,radius=40,hours=[6,22]){
  lot bread_shelf(good=bread,quantity=8,limit=16,price=5);
  lot flour_sack(good=flour,quantity=30,limit=30);
  lot repair_kits(good=timber,quantity=12,limit=12);
  lot tree_saplings(good=sapling,quantity=6,limit=6);
  lot produce_box(good=vegetables,quantity=8,limit=16,price=2);
  lot lunch_counter(good=lunch,quantity=0,limit=8,price=8);
  lot workshop_boards(good=boards,quantity=8,limit=8);
  lot workshop_fasteners(good=fasteners,quantity=8,limit=8);
 }
 delivery flour_run(label="Bring flour to the bakery",from=station_supplies,to=market_stall,good=flour,quantity=2,pay=4,capacity=1,on=market_hall,grounds=[market_square]);
 delivery school_run(label="Take bread to school",from=market_stall,to=school_canteen,good=bread,quantity=2,pay=5,capacity=1,on=school_yard,grounds=[school_yard_access,school_yard_return,market_hall,market_square]);
 delivery kits_run(label="Bring repair kits to the market",from=station_supplies,to=market_stall,good=timber,quantity=2,pay=4,price=3,capacity=1,on=market_hall,grounds=[market_square]);
 repair market_tables(dry=true,label="Repair city fixtures",market=market_stall,on=market_hall,grounds=[park_seating,station_seating,market_square,school_yard,school_yard_access,school_yard_return,garden_work],streets=[market_avenue,north_avenue,south_avenue,garden_collector,high_street,civic_walk,river_street,copper_street,weavers_street,library_lane,copper_lane,weavers_lane,garden_crescent,garden_lane,school_street,orchard_lane,hospital_street,south_terrace,south_school_lane,park_lane,eastbank,station_avenue,workshop_street,harbor_street,yard_link,east_gardens,lakefront,east_station_road,farm_road,airfield_road,airport_service,airport_connector],verge=24,kinds=[table,custom,bench,lamp],input=timber,take=1,seconds=8,pay=4,effort=5,recover=fasteners,amount=1);
 delivery saplings_run(label="Bring saplings to the market",from=station_supplies,to=market_stall,good=sapling,quantity=2,pay=4,price=2,capacity=1,on=market_hall,grounds=[market_square]);
 repair classroom_furniture(label="Repair school furniture",market=market_stall,on=hall_service,grounds=[garden_school,school_doorstep],kinds=[table,bench],input=timber,take=1,seconds=8,pay=4,effort=5,recover=fasteners,amount=1);
 repair home_furniture(label="Repair home furniture",market=market_stall,on=hall_service,grounds=[oldtown_044,home_upper,home_landing],kinds=[table,bench,custom],input=timber,take=1,seconds=8,pay=4,effort=5,recover=fasteners,amount=1);
 repair orchard_trees(dry=true,label="Replant city trees",market=market_stall,on=hall_service,grounds=[orchard_work,market_square,garden_work,park_seating,station_seating,school_yard,school_yard_access],streets=[market_avenue,north_avenue,south_avenue,garden_collector,high_street,civic_walk,river_street,copper_street,weavers_street,library_lane,copper_lane,weavers_lane,garden_crescent,garden_lane,school_street,orchard_lane,hospital_street,south_terrace,south_school_lane,park_lane,eastbank,station_avenue,workshop_street,harbor_street,yard_link,east_gardens,lakefront,east_station_road,farm_road,airfield_road,airport_service,airport_connector],verge=112,kind=tree,input=sapling,take=1,seconds=10,pay=6,effort=6,regrow_s=180,seed_scale=.15,recover=boards,amount=1);
 work bake(label="Bake bread",market=market_stall,input=flour,take=1,output=bread,make=2,seconds=6,pay=3,effort=12,capacity=1,target=4,equipment=[hall_table_east]);
 milestone practiced_baker(label="Bake bread batches",kind=work,task=bake,count=3);
 milestone bakers_table(label="Share a meal with the baker",kind=shared_meal,task=baker,count=1);
 milestone school_helper(label="Deliver bread to school",kind=delivery,task=school_run,count=1);
 work large_bake(label="Bake a larger batch",market=market_stall,input=flour,take=2,output=bread,make=5,seconds=9,pay=5,effort=16,capacity=1,target=6,requires_any=[practiced_baker,bakers_table],equipment=[hall_table_east]);
 work pack_lunch(label="Pack lunch",market=market_stall,output=lunch,make=1,seconds=5,pay=3,effort=6,capacity=1,target=3,equipment=[hall_table_east]){
  ingredient(good=bread,take=1);
  ingredient(good=vegetables,take=1);
 }
 work assemble_kit(label="Assemble a repair kit",market=market_stall,output=timber,make=1,seconds=7,pay=3,effort=6,capacity=1,target=12){
  ingredient(good=boards,take=1);
  ingredient(good=fasteners,take=1);
 }

 work propagate_saplings(label="Propagate saplings",market=market_stall,input=sapling,take=1,output=sapling,make=2,seconds=12,pay=2,effort=2,capacity=1,target=5,equipment=[hall_table_east]);

 delivery boards_run(label="Bring boards to the workshop",from=station_supplies,to=market_stall,good=boards,quantity=2,pay=4,price=1,capacity=1,on=market_hall,grounds=[market_square]);
 delivery fasteners_run(label="Bring fasteners to the workshop",from=station_supplies,to=market_stall,good=fasteners,quantity=2,pay=4,price=1,capacity=1,on=market_hall,grounds=[market_square,school_yard,school_yard_access,school_yard_return]);

}
