route village_skate(kind=path,mode=loop,speed=45,wait_s=6,width=54,surface=paved){
  repeat arc(index=i,count=32){
    let a(value=270+i*360/32);
    point(at=[2250+cos(a)*200,2350+sin(a)*140]);
    point(at=[2250+cos(a+360/64)*200,2350+sin(a+360/64)*140]);
  }
}
