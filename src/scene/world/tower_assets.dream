dream 2;
material tower_brick(style=brick,colors=[#9b6755,#b7ab96]);
material tower_stone(style=stone,colors=[#b9b6a6,#a29f91]);
material tower_glass(style=toon,colors=[#6b8a8b,#4b676e],night=#e6bf87);
material tower_metal(style=toon,colors=[#47565e,#34434c]);
material tower_office_glass(style=toon,colors=[#658798,#466575],night=#dfcc9f);
material tower_floor(style=stone,colors=[#ccc6b5,#b7b09d]);
material tower_light(style=toon,colors=[#edd7ad,#ddc599],night=#f4d398);

object station_residences(label="Copper Court residences"){
 measure(kind=building,axis=y,meters=55);
 body(interaction=solid,radius=30,height=160);
 foundation(size=[72.4,62.4],color=#aaa797);
 interior(at=[0,.5,0],size=[70,10,60]){portal entrance(side=front,offset=0,width=4,height=7);}
 lamp(at=[0,9.8,0],radius=26,color=#f4d398);
 contact c_floor(at=[0,0,0],size=[70,60],height=.5);
 contact c_left(at=[-35.5,0,0],size=[1,62],height=10.5);
 contact c_right(at=[35.5,0,0],size=[1,62],height=10.5);
 contact c_back(at=[0,0,30.5],size=[72,1],height=10.5);
 contact c_front_left(at=[-19,0,-30.5],size=[34,1],height=10.5);
 contact c_front_right(at=[19,0,-30.5],size=[34,1],height=10.5);
 contact c_lintel(at=[0,7.5,-30.5],size=[4,1],height=3);
 contact c_ceiling(at=[0,10.5,0],size=[72,62],height=21.5);
 contact c_shaft(at=[0,32,0],size=[62,52],height=96);
 contact c_crown(at=[0,128,0],size=[50,42],height=30);
 contact c_roof_left(at=[-24,128,0],size=[2,42],height=32);
 contact c_roof_right(at=[24,128,0],size=[2,42],height=32);
 contact c_roof_front(at=[0,128,-20],size=[46,2],height=32);
 contact c_roof_back(at=[0,128,20],size=[46,2],height=32);
 part floor(shape=box,material=tower_floor,at=[0,.25,0],size=[70,.5,60]);
 part left(shape=box,material=tower_stone,at=[-35.5,5.25,0],size=[1,10.5,62],cutaway=left);
 part right(shape=box,material=tower_stone,at=[35.5,5.25,0],size=[1,10.5,62],cutaway=right);
 part back(shape=box,material=tower_stone,at=[0,5.25,30.5],size=[72,10.5,1],cutaway=back);
 part front_left(shape=box,material=tower_stone,at=[-19,5.25,-30.5],size=[34,10.5,1],cutaway=front);
 part front_right(shape=box,material=tower_stone,at=[19,5.25,-30.5],size=[34,10.5,1],cutaway=front);
 part lintel(shape=box,material=tower_stone,at=[0,9,-30.5],size=[4,3,1],cutaway=front);
 part podium(shape=box,material=tower_brick,at=[0,21.25,0],size=[72,21.5,62],cutaway=roof);
 part shaft(shape=box,material=tower_brick,at=[0,80,0],size=[62,96,52],cutaway=roof);
 voxels crown(material=tower_brick,at=[0,128,0],size=[50,64,42],grid=[25,32,21],cutaway=roof){fill storeys(from=[0,16,0],to=[25,31,21]);}
 voxels crown_parapet(material=tower_stone,at=[0,128,0],size=[50,64,42],grid=[25,32,21],cutaway=roof){fill rim(from=[0,31,0],to=[25,32,21]);cut terrace(from=[1,31,1],to=[24,32,20]);}
 part terrace_band(shape=box,material=tower_stone,at=[0,31.7,0],size=[72,.6,62],cutaway=roof);
 part upper_terrace_band(shape=box,material=tower_stone,at=[0,127.7,0],size=[62,.6,52],cutaway=roof);
 repeat faces(index=s,count=2){
  voxels podium_glass(material=tower_glass,at=[0,21.25,s*62.12-31.06],size=[68,21.5,.12],grid=[32,12,1],cutaway=roof){repeat rows(index=f,count=2){repeat bays(index=b,count=5){fill pane(from=[b*6+2,f*6+1,0],to=[b*6+5,f*6+5,1]);}}}
  voxels shaft_glass(material=tower_glass,at=[0,80,s*52.12-26.06],size=[62,96,.12],grid=[31,30,1],cutaway=roof){repeat rows(index=f,count=10){repeat bays(index=b,count=5){fill pane(from=[b*6+2,f*3,0],to=[b*6+5,f*3+2,1]);}}}
  voxels crown_glass(material=tower_glass,at=[0,128,s*42.12-21.06],size=[50,64,.12],grid=[25,32,1],cutaway=roof){repeat rows(index=f,count=3){repeat bays(index=b,count=4){fill pane(from=[b*6+2,f*5+17,0],to=[b*6+5,f*5+20,1]);}}}
 }
 repeat sides(index=s,count=2){
  voxels shaft_glass(material=tower_glass,at=[s*62.12-31.06,80,0],size=[.12,96,52],grid=[1,30,26],cutaway=roof){repeat rows(index=f,count=10){repeat bays(index=b,count=4){fill pane(from=[0,f*3,b*6+2],to=[1,f*3+2,b*6+5]);}}}
  voxels crown_glass(material=tower_glass,at=[s*50.12-25.06,128,0],size=[.12,64,42],grid=[1,32,21],cutaway=roof){repeat rows(index=f,count=3){repeat bays(index=b,count=3){fill pane(from=[0,f*5+17,b*6+2],to=[1,f*5+20,b*6+5]);}}}
 }
 voxels lobby_glass(material=tower_glass,at=[0,5.5,-31.08],size=[60,6,.16],grid=[30,3,1],cutaway=front){fill left(from=[0,0,0],to=[12,3,1]);fill right(from=[18,0,0],to=[30,3,1]);}
 voxels door_surround(material=tower_metal,at=[0,4.3,-31.08],size=[5,8,.2],grid=[20,32,1],cutaway=front){fill frame(from=[0,0,0],to=[20,32,1]);cut opening(from=[2,0,0],to=[18,29,1]);}
 part canopy(shape=box,material=tower_metal,at=[0,8.8,-33],size=[16,.5,5],cutaway=roof);
 part light(shape=box,material=tower_light,at=[0,10.35,-4],size=[18,.3,1.2],cutaway=roof);
}

object station_offices(label="Lantern Exchange offices"){
 measure(kind=building,axis=y,meters=75);
 body(interaction=solid,radius=30,height=160);
 foundation(size=[64.4,56.4],color=#a4aaa8);
 interior(at=[0,.5,0],size=[62,12,54]){portal entrance(side=front,offset=0,width=4,height=8);}
 lamp(at=[0,11.8,0],radius=26,color=#f4d398);
 contact c_floor(at=[0,0,0],size=[62,54],height=.5);
 contact c_left(at=[-31.5,0,0],size=[1,56],height=12.5);
 contact c_right(at=[31.5,0,0],size=[1,56],height=12.5);
 contact c_back(at=[0,0,27.5],size=[64,1],height=12.5);
 contact c_front_left(at=[-17,0,-27.5],size=[30,1],height=12.5);
 contact c_front_right(at=[17,0,-27.5],size=[30,1],height=12.5);
 contact c_lintel(at=[0,8.5,-27.5],size=[4,1],height=4);
 contact c_ceiling(at=[0,12.5,0],size=[64,56],height=51.5);
 contact c_shaft(at=[0,64,0],size=[52,44],height=124);
 contact c_roof_left(at=[-25,128,0],size=[2,44],height=64);
 contact c_roof_right(at=[25,128,0],size=[2,44],height=64);
 contact c_roof_front(at=[0,128,-21],size=[48,2],height=64);
 contact c_roof_back(at=[0,128,21],size=[48,2],height=64);
 part floor(shape=box,material=tower_floor,at=[0,.25,0],size=[62,.5,54]);
 part left(shape=box,material=tower_metal,at=[-31.5,6.25,0],size=[1,12.5,56],cutaway=left);
 part right(shape=box,material=tower_metal,at=[31.5,6.25,0],size=[1,12.5,56],cutaway=right);
 part back(shape=box,material=tower_metal,at=[0,6.25,27.5],size=[64,12.5,1],cutaway=back);
 part front_left(shape=box,material=tower_metal,at=[-17,6.25,-27.5],size=[30,12.5,1],cutaway=front);
 part front_right(shape=box,material=tower_metal,at=[17,6.25,-27.5],size=[30,12.5,1],cutaway=front);
 part lintel(shape=box,material=tower_metal,at=[0,10.5,-27.5],size=[4,4,1],cutaway=front);
 part podium(shape=box,material=tower_metal,at=[0,38.25,0],size=[64,51.5,56],cutaway=roof);
 part shaft(shape=box,material=tower_metal,at=[0,126,0],size=[52,124,44],cutaway=roof);
 voxels parapet(material=tower_metal,at=[0,128,0],size=[52,128,44],grid=[26,32,22],cutaway=roof){fill rim(from=[0,31,0],to=[26,32,22]);cut roof(from=[1,31,1],to=[25,32,21]);}
 part podium_coping(shape=box,material=tower_stone,at=[0,63.7,0],size=[64,.6,56],cutaway=roof);
 repeat faces(index=s,count=2){
  voxels podium_glass(material=tower_office_glass,at=[0,38.25,s*56.12-28.06],size=[60,51.5,.12],grid=[30,30,1],cutaway=roof){fill facade(from=[0,0,0],to=[30,30,1]);repeat rails(index=f,count=7){cut floor(from=[0,f*4,0],to=[30,f*4+1,1]);}repeat mullions(index=b,count=6){cut upright(from=[b*5,0,0],to=[b*5+1,30,1]);}}
  voxels shaft_glass(material=tower_office_glass,at=[0,126,s*44.12-22.06],size=[52,124,.12],grid=[26,31,1],cutaway=roof){fill facade(from=[0,0,0],to=[26,31,1]);repeat rails(index=f,count=16){cut floor(from=[0,f*2,0],to=[26,f*2+1,1]);}repeat mullions(index=b,count=7){cut upright(from=[b*4,0,0],to=[b*4+1,31,1]);}}
  voxels vertical_fins(material=tower_stone,at=[0,126,s*44.32-22.16],size=[52,124,.4],grid=[26,31,1],cutaway=roof){repeat columns(index=b,count=7){fill fin(from=[b*4,0,0],to=[b*4+1,31,1]);}}
 }
 repeat sides(index=s,count=2){
  voxels podium_glass(material=tower_office_glass,at=[s*64.12-32.06,38.25,0],size=[.12,51.5,52],grid=[1,30,26],cutaway=roof){fill facade(from=[0,0,0],to=[1,30,26]);repeat rails(index=f,count=7){cut floor(from=[0,f*4,0],to=[1,f*4+1,26]);}repeat mullions(index=b,count=7){cut upright(from=[0,0,b*4],to=[1,30,b*4+1]);}}
  voxels shaft_glass(material=tower_office_glass,at=[s*52.12-26.06,126,0],size=[.12,124,44],grid=[1,31,22],cutaway=roof){fill facade(from=[0,0,0],to=[1,31,22]);repeat rails(index=f,count=16){cut floor(from=[0,f*2,0],to=[1,f*2+1,22]);}repeat mullions(index=b,count=6){cut upright(from=[0,0,b*4],to=[1,31,b*4+1]);}}
 }
 voxels lobby_glass(material=tower_office_glass,at=[0,6.25,-28.08],size=[60,10,.16],grid=[30,5,1],cutaway=front){fill left(from=[0,0,0],to=[13,5,1]);fill right(from=[17,0,0],to=[30,5,1]);}
 voxels door_surround(material=tower_stone,at=[0,4.8,-28.08],size=[5,9,.2],grid=[20,32,1],cutaway=front){fill frame(from=[0,0,0],to=[20,32,1]);cut opening(from=[2,0,0],to=[18,29,1]);}
 part canopy(shape=box,material=tower_metal,at=[0,10,-30],size=[18,.5,5],cutaway=roof);
 part light(shape=box,material=tower_light,at=[0,12.35,-4],size=[20,.3,1.2],cutaway=roof);
}
