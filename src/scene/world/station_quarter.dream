dream 2;
// Two street-connected towers, a shared promenade and working station parking.
asset homes(module=tower_assets,object=station_residences);
asset offices(module=tower_assets,object=station_offices);
asset taxi(module=station_vehicles,object=station_taxi);
asset van(module=station_vehicles,object=station_cargo_van);
asset bench(module=destructible,object=slatted_bench);
asset lamp(module=street_assets,object=neighborhood_lamp);
asset planter(module=street_assets,object=planted_tub);
asset rowan(module=nature,object=young_rowan);
asset shopper(module=city_people,object=river_shopper);
asset student(module=city_people,object=campus_student);
asset neighbor(module=city_people,object=park_neighbor);
asset resident(module=city_people,object=city_resident);

place station_quarter_residences(object=homes,at=[11700,4700],heading_deg=180,role=prop);
place station_quarter_offices(object=offices,at=[12200,4700],heading_deg=180,role=prop);
site station_quarter_home_access(object=station_quarter_residences,kind=home,label="Copper Court",entry=[0,-31],street=workshop_street,width=16,points=[[11700,5150]]);
site station_quarter_office_access(object=station_quarter_offices,kind=work,label="Lantern Exchange",entry=[0,-28],street=workshop_street,width=16,points=[[12200,5150]]);
floor station_quarter_home_floor(on=station_quarter_residences,at=[0,.5,0],size=[70,60]);
floor station_quarter_office_floor(on=station_quarter_offices,at=[0,.5,0],size=[62,54]);

surface station_quarter_promenade(color=#bcb6a4,walkable=true,points=[[11520,4940],[12420,4940],[12420,4908],[11520,4908]]);
surface station_quarter_taxi_apron(color=#939a96,points=[[11445,5152.5],[11615,5152.5],[11615,5010],[11445,5010]]);
surface station_quarter_van_apron(color=#939a96,points=[[12300,5152.5],[12470,5152.5],[12470,5010],[12300,5010]]);

place station_quarter_taxi_0(object=taxi,at=[11485,5090],heading_deg=90,role=controllable,parked=true);
place station_quarter_taxi_1(object=taxi,at=[11575,5090],heading_deg=90,role=controllable,parked=true);
place station_quarter_van_0(object=van,at=[12340,5090],heading_deg=90,role=controllable,parked=true);
place station_quarter_van_1(object=van,at=[12430,5090],heading_deg=90,role=controllable,parked=true);

place station_quarter_bench_nw(object=bench,at=[11830,4950],heading_deg=180,role=prop);
place station_quarter_bench_ne(object=bench,at=[12050,4950],heading_deg=180,role=prop);
place station_quarter_bench_sw(object=bench,at=[11830,4897],heading_deg=0,role=prop);
place station_quarter_bench_se(object=bench,at=[12050,4897],heading_deg=0,role=prop);
place station_quarter_home_seat(object=bench,at=[11630,4690],heading_deg=270,role=prop,floor=station_quarter_home_floor);
place station_quarter_office_seat(object=bench,at=[12270,4690],heading_deg=90,role=prop,floor=station_quarter_office_floor);
place station_quarter_lamp_west(object=lamp,at=[11540,4948],heading_deg=180,role=prop);
place station_quarter_lamp_center(object=lamp,at=[11940,4900],heading_deg=0,role=prop);
place station_quarter_lamp_east(object=lamp,at=[12400,4948],heading_deg=180,role=prop);
place station_quarter_tree_west(object=rowan,at=[11555,4870],heading_deg=32,role=prop);
place station_quarter_tree_center(object=rowan,at=[11945,4840],heading_deg=146,role=prop);
place station_quarter_tree_east(object=rowan,at=[12390,4870],heading_deg=257,role=prop);
place station_quarter_home_planter(object=planter,at=[11665,4830],heading_deg=20,role=prop);
place station_quarter_work_planter(object=planter,at=[12240,4840],heading_deg=200,role=prop);

place station_quarter_walker_0(object=shopper,at=[11620,4924],heading_deg=0,role=ambient,motion=walk(speed=13,wait_s=2));
place station_quarter_walker_1(object=student,at=[11820,4924],heading_deg=180,role=ambient,motion=walk(speed=17,wait_s=1));
place station_quarter_walker_2(object=neighbor,at=[11970,4924],heading_deg=0,role=ambient,motion=walk(speed=12,wait_s=3));
place station_quarter_walker_3(object=resident,at=[12150,4924],heading_deg=180,role=ambient,motion=walk(speed=15,wait_s=2));
place station_quarter_walker_4(object=shopper,at=[12325,4924],heading_deg=180,role=ambient,motion=walk(speed=14,wait_s=1));
place station_quarter_walker_5(object=student,at=[11700,5020],heading_deg=90,role=ambient,motion=walk(speed=16,wait_s=2));
place station_quarter_walker_6(object=neighbor,at=[12200,5010],heading_deg=90,role=ambient,motion=walk(speed=11,wait_s=3));
place station_quarter_walker_7(object=resident,at=[12200,4870],heading_deg=270,role=ambient,motion=walk(speed=14,wait_s=2));

// Invisible maintenance grounds bridge the doorway thresholds and the promenade.
surface station_repair_work(finish=terrain,points=[[11520,4790],[12420,4790],[12420,4970],[11520,4970]]);
surface station_tree_work_west(finish=terrain,points=[[11530,4845],[11580,4845],[11580,4916],[11530,4916]]);
surface station_tree_work_center(finish=terrain,points=[[11920,4815],[11970,4815],[11970,4916],[11920,4916]]);
surface station_tree_work_east(finish=terrain,points=[[12365,4845],[12415,4845],[12415,4916],[12365,4916]]);
