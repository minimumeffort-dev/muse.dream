dream 2;
material masonry(style=brick,colors=[#a96f55,#bcb1a0]);
material steel(style=toon,colors=[#8f9b94,#8f9b94]);
material glazing(style=toon,colors=[#61919a,#61919a]);
material bark(style=grain,colors=[#6e5137,#9a7550]);
material birch_bark(style=toon,colors=[#e5e3d5,#bec5b5]);
material birch_leaf(style=toon,colors=[#7fa461,#5e804e]);
material birch_shade(style=toon,colors=[#6c9252,#527146]);
material leaves(style=toon,colors=[#638653,#365b42]);
material fir_leaves(style=toon,colors=[#416958,#284b40]);
material amber(style=toon,colors=[#c18942,#866037]);
material wood(style=wood,colors=[#91613f,#bb915d]);
material dark_wood(style=toon,colors=[#5e4735,#40372d]);
material plaster(style=toon,colors=[#ddd0a7,#b4a17b]);
material roof(style=toon,colors=[#45626c,#2d424e]);
material brick(style=brick,colors=[#a66146,#bcb1a0]);
material stone(style=stone,colors=[#8b9181,#5a655f]);
object leaning_birch(label="Leaning birch"){
  measure(kind=tree,axis=y,meters=10);
  body(interaction=solid,radius=9,height=67);
  impact(mode=topple(speed=110,duration=1.1,lifetime=8));
  fragment tree(){
    beam trunk(shape=cylinder,material=birch_bark,from=[0,.18,0],to=[-4,57,2],width=4.8,depth=4.8,taper=.23);
    beam left_fork(shape=cylinder,material=birch_bark,from=[-1.7,25,.9],to=[-15,49,0],width=2,depth=2,taper=.3);
    beam right_fork(shape=cylinder,material=birch_bark,from=[-2.25,32,1.1],to=[10,51,5],width=1.7,depth=1.7,taper=.28);
    beam back_fork(shape=cylinder,material=birch_bark,from=[-2.1,30,1.05],to=[-8,53,-10],width=1.5,depth=1.5,taper=.3);
    beam front_fork(shape=cylinder,material=birch_bark,from=[-1.9,27,.95],to=[1,47,12],width=1.7,depth=1.7,taper=.28);
    beam leader(shape=cylinder,material=birch_bark,from=[-2.9,41,1.44],to=[-8,61,2],width=1.2,depth=1.2,taper=.25);
    beam left_twig(shape=cylinder,material=birch_bark,from=[-13.95,47.1,.08],to=[-22,37,2],width=.7,depth=.7,taper=.3);
    beam right_twig(shape=cylinder,material=birch_bark,from=[8.85,49.2,4.64],to=[17,37,6],width=.7,depth=.7,taper=.3);
    repeat bark_marks(index=b,count=4){
      let y(value=6+b*9);
      part front_scar(shape=icosphere,material=dark_wood,at=[-y*.07+.1,y,2.2+y*.003],size=[2.1-b*.22,.5,.5],rot_deg=[0,0,b*3-5]);
      part back_scar(shape=icosphere,material=dark_wood,at=[-(y+3)*.07-.1,y+3,-2.2+(y+3)*.0675],size=[1.8-b*.18,.5,.5],rot_deg=[0,0,6-b*4]);
    }
    part top(shape=icosphere,material=birch_leaf,at=[-4,61,2],size=[13,13,12],faceted=true);
    part left(shape=icosphere,material=birch_leaf,at=[-14,50,0],size=[16,18,14],faceted=true);
    part right(shape=icosphere,material=birch_leaf,at=[10,52,5],size=[15,18,13],faceted=true);
    part back(shape=icosphere,material=birch_shade,at=[-7,51,-9],size=[14,18,13],faceted=true);
    part left_drop(shape=icosphere,material=birch_leaf,at=[-19,42,1],size=[10,16,10],faceted=true);
    part right_drop(shape=icosphere,material=birch_leaf,at=[15,43,5],size=[10,16,10],faceted=true);
    part front(shape=icosphere,material=birch_shade,at=[1,49,11],size=[13,15,12],faceted=true);
    part upper_left(shape=icosphere,material=birch_leaf,at=[-10,58,5],size=[11,14,10],faceted=true);
    part left_tassel(shape=icosphere,material=birch_leaf,at=[-22,35,2],size=[5,12,6],faceted=true);
    part right_tassel(shape=icosphere,material=birch_leaf,at=[18,36,6],size=[5,12,6],faceted=true);
  }
}
object silver_spruce(label="Silver spruce"){
  measure(kind=tree,axis=y,meters=12);
  body(interaction=solid,radius=12,height=76);
  impact(mode=topple(speed=145,duration=1.35,lifetime=8));
  fragment tree(){
    part trunk(shape=cylinder,material=bark,at=[0,30,0],size=[8,60,8],taper=.6,faceted=true);
    repeat boughs(index=i,count=4){
      part crown(shape=cone,material=fir_leaves,at=[0,23+i*13,0],size=[42-i*9,30,36-i*7],faceted=true);
    }
      beam root_left(shape=cylinder,material=bark,from=[-5,1,0],to=[0,6,0],width=2,depth=2);
    beam root_right(shape=cylinder,material=bark,from=[5,1,0],to=[0,6,0],width=2,depth=2);
    repeat bark_marks(index=b,count=3){part mark(shape=box,material=dark_wood,at=[0,6+b*6,4.0],size=[5.2,.7,.5]);}
  }
}
object amber_sapling(label="Amber sapling"){
  measure(kind=tree,axis=y,meters=4.5);
  body(interaction=solid,radius=7,height=43);
  impact(mode=topple(speed=70,duration=.7,lifetime=7));
  fragment tree(){
    part trunk(shape=cylinder,material=bark,at=[0,13,0],size=[5,26,5]);
    beam branch(shape=cylinder,material=bark,from=[0,17,0],to=[8,29,2],width=2,depth=2);
    beam left_fork(shape=cylinder,material=bark,from=[0,16,0],to=[-7,29,0],width=1.8,depth=1.8,taper=.4);
    part crown(shape=icosphere,material=amber,at=[-5.5,31,0],size=[22,24,23],faceted=true);
    part side(shape=icosphere,material=amber,at=[9,26,2],size=[18,19,17],faceted=true);
      beam root_left(shape=cylinder,material=bark,from=[-5,1,0],to=[0,6,0],width=2,depth=2);
    beam root_right(shape=cylinder,material=bark,from=[5,1,0],to=[0,6,0],width=2,depth=2);
    repeat bark_marks(index=b,count=3){part mark(shape=box,material=dark_wood,at=[0,6+b*6,2.5],size=[3.25,.7,.5]);}
  }
}
object slatted_bench(label="Slatted park bench"){
 measure(kind=bench,axis=x,meters=1.8);
 body(interaction=solid,radius=28,height=31,clearance=34.9857113690718);
 seat left(at=[-13,18,12],approach=[-13,48],heading_deg=90);
 seat right(at=[13,18,12],approach=[13,48],heading_deg=90);
 impact(mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
 repeat slats(index=i,count=4){fragment plank(){
  part seat(shape=prism,material=wood,at=[0,16,-12+i*8],size=[60,4,6],outline=[[.012,0],[.988,0],[1,.15],[1,.85],[.988,1],[.012,1],[0,.85],[0,.15]]);
  repeat fasteners(index=b,count=2){part bolt(shape=cylinder,material=steel,at=[b*44-22,18.08,-12+i*8],size=[.8,.16,.8],faceted=true);}
 }}
 repeat supports(index=i,count=2){fragment frame(){
  part leg_front(shape=box,material=dark_wood,at=[i*44-22,6.5,12],size=[5,13,6]);
  part leg_back(shape=prism,material=dark_wood,at=[i*44-22,15,-13.75],size=[6.5,30,5],rot_deg=[0,90,0],outline=[[.769230769230769,0],[0,0],[0,.533333333333333],[.538461538461538,1],[1,1],[.769230769230769,.533333333333333]]);
  part brace(shape=box,material=dark_wood,at=[i*44-22,12,0],size=[6,4,29]);
  part armrest(shape=prism,material=wood,at=[i*44-22,24,0],size=[5,3,29],outline=[[.012,0],[.988,0],[1,.15],[1,.85],[.988,1],[.012,1],[0,.85],[0,.15]]);
  part arm_support(shape=box,material=dark_wood,at=[i*44-22,20,12],size=[3,8,3]);
 }}
 fragment back(){repeat boards(index=b,count=3){
  let y(value=19.675133091918468+b*4.324866908081532);
  let z(value=-16.709984863039555+(28.324866908081532-y)*0.2125565616700221);
  part board(shape=prism,material=wood,at=[0,y,z],size=[60,3,2],rot_deg=[-12,0,0],outline=[[.012,0],[.988,0],[1,.15],[1,.85],[.988,1],[.012,1],[0,.85],[0,.15]]);
  repeat fasteners(index=f,count=2){part bolt(shape=cylinder,material=steel,at=[f*44-22,y,z+1.13],size=[.8,.2,.8],rot_deg=[90,0,0],faceted=true);}
 }}
}

object garden_wall(label="Voxel garden wall"){
  measure(kind=custom,axis=x,meters=3);
  body(interaction=solid,radius=24,height=32);
  impact(mode=break(speed=90,scatter=50,lift=55,spin=3,lifetime=6,pattern=crumble));
  voxels wall(material=masonry,at=[0,16,0],size=[60,32,8],grid=[30,16,4],chunks=[2,2,1]){
    fill solid(from=[0,0,0],to=[30,16,4]);
    cut opening(from=[12,0,0],to=[18,10,4]);
    repeat top(index=i,count=5){
      cut notch(from=[i*6+2,14,0],to=[i*6+4,16,4]);
    }
  }
}

material home_brick(style=brick,colors=[#a96f55,#bcb1a0]);
material home_plaster(style=toon,colors=[#ddd1b9,#c5b69a]);
material home_glass(style=toon,colors=[#6c929d,#42616f],night=#edc590);
material home_roof(style=toon,colors=[#535b64,#3b4753]);
material home_trim(style=toon,colors=[#e5decd,#c5bfae]);
material home_wood(style=wood,colors=[#805c40,#aa815a]);
material home_dark(style=toon,colors=[#35464c,#28363e]);
material home_floorboards(style=wood,colors=[#c4aa83,#9b805d]);
material home_cushion(style=toon,colors=[#70887a,#50695e]);
material home_warm_light(style=toon,colors=[#f2d6a0,#e2c48c],night=#f6ce84);

object commuter_home(label="Commuter's terrace"){
 measure(kind=building,axis=y,meters=9);
 body(interaction=solid,radius=9.5,height=23);
 foundation(size=[19.4,34.8],color=#9e9d8c);
 lamp(at=[0,8.3,0],radius=20,color=#ffd69a);
 interior(at=[0,.5,0],size=[18,8,32]){portal front(side=front,offset=0,width=3,height=6);}
 contact c_floor(at=[0,0,0],size=[18,32],height=.5);
 contact c_left(at=[-9.25,0,0],size=[.5,32.8],height=8.5);
 contact c_right(at=[9.25,0,0],size=[.5,32.8],height=8.5);
 contact c_back(at=[0,0,16.15],size=[19,.5],height=8.5);
 contact c_front_left(at=[-5.5,0,-16.4],size=[8,.5],height=8.5);
 contact c_front_right(at=[5.5,0,-16.4],size=[8,.5],height=8.5);
 contact c_lintel(at=[0,6.5,-16.4],size=[3,.5],height=2);
 contact c_upper(at=[0,8.5,0],size=[19,32.8],height=14.5);
 part floor(shape=box,material=home_floorboards,at=[0,.25,0],size=[18,.5,32]);
 part left(shape=box,material=home_plaster,at=[-9.25,4.25,0],size=[.5,8.5,32.8],cutaway=left);
 part right(shape=box,material=home_plaster,at=[9.25,4.25,0],size=[.5,8.5,32.8],cutaway=right);
 part back(shape=box,material=home_plaster,at=[0,4.25,16.15],size=[19,8.5,.5],cutaway=back);
 part front_left(shape=box,material=home_brick,at=[-5.5,4.25,-16.4],size=[8,8.5,.5],cutaway=front);
 part front_right(shape=box,material=home_brick,at=[5.5,4.25,-16.4],size=[8,8.5,.5],cutaway=front);
 part lintel(shape=box,material=home_brick,at=[0,7.5,-16.4],size=[3,2,.5],cutaway=front);
 part ceiling(shape=box,material=home_trim,at=[0,8.7,0],size=[19,.4,32.8],cutaway=roof);
 part upper(shape=box,material=home_brick,at=[0,13.5,0],size=[19,9,32.8],cutaway=roof);
 part roof(shape=prism,material=home_roof,at=[0,20.5,0],size=[19.2,5,34.3],outline=[[0,0],[.5,1],[1,0],[.98,0],[.5,.88],[.02,0]],cutaway=roof);
 part attic(shape=prism,material=home_brick,at=[0,20.2,0],size=[19,4.4,32.8],outline=[[0,0],[1,0],[.5,1]],cutaway=roof);
 part eaves(shape=box,material=home_trim,at=[0,17.75,0],size=[19.2,.5,34.3],cutaway=roof);
 repeat bays(index=b,count=2){
  part lower_glass(shape=box,material=home_glass,at=[b*10-5,4.5,-16.7],size=[3.4,4.5,.12],cutaway=front);
  voxels lower_frame(material=home_trim,at=[b*10-5,4.5,-16.8],size=[3.8,4.9,.16],grid=[16,20,1],cutaway=front){fill frame(from=[0,0,0],to=[16,20,1]);cut aperture(from=[2,2,0],to=[14,18,1]);fill mullion(from=[7,2,0],to=[8,18,1]);}
  part upper_glass(shape=box,material=home_glass,at=[b*10-5,13.5,-16.5],size=[3.4,4.5,.12],cutaway=roof);
  voxels upper_frame(material=home_trim,at=[b*10-5,13.5,-16.6],size=[3.8,4.9,.16],grid=[16,20,1],cutaway=roof){fill frame(from=[0,0,0],to=[16,20,1]);cut aperture(from=[2,2,0],to=[14,18,1]);fill mullion(from=[7,2,0],to=[8,18,1]);}
 }
 part rear_glass(shape=box,material=home_glass,at=[0,13.5,16.5],size=[7,4.5,.12],cutaway=roof);
 voxels rear_frame(material=home_trim,at=[0,13.5,16.6],size=[7.5,4.9,.16],grid=[24,20,1],cutaway=roof){fill frame(from=[0,0,0],to=[24,20,1]);cut aperture(from=[2,2,0],to=[22,18,1]);fill mullion(from=[11,2,0],to=[12,18,1]);}
 part left_glass(shape=box,material=home_glass,at=[-9.5,4.8,5.4],size=[.12,4,5],cutaway=left);
 voxels left_frame(material=home_trim,at=[-9.65,4.8,5.4],size=[.16,4.5,5.5],grid=[1,20,20],cutaway=left){fill surround(from=[0,0,0],to=[1,20,20]);cut aperture(from=[0,2,2],to=[1,18,18]);}
 part right_glass(shape=box,material=home_glass,at=[9.5,4.8,5.4],size=[.12,4,5],cutaway=right);
 voxels right_frame(material=home_trim,at=[9.65,4.8,5.4],size=[.16,4.5,5.5],grid=[1,20,20],cutaway=right){fill surround(from=[0,0,0],to=[1,20,20]);cut aperture(from=[0,2,2],to=[1,18,18]);}
 part step(shape=box,material=home_trim,at=[0,.25,-17.4],size=[6,.5,2.4]);
 part open_door(shape=box,material=home_dark,at=[-1.65,3.5,-14.9],size=[.16,6,3],cutaway=front);
 voxels door_frame(material=home_trim,at=[0,3.5,-16.76],size=[3.8,6.8,.18],grid=[20,30,1],cutaway=front){fill surround(from=[0,0,0],to=[20,30,1]);cut aperture(from=[2,0,0],to=[18,27,1]);}
 part pendant(shape=box,material=home_warm_light,at=[0,8.35,0],size=[3,.3,2],cutaway=roof);
 voxels chimney(material=home_brick,at=[6,20.2,6.9],size=[2.4,4.4,2.8],grid=[12,16,12],cutaway=roof){fill shaft(from=[2,0,2],to=[10,14,10]);fill crown(from=[0,14,0],to=[12,16,12]);cut flue(from=[4,14,4],to=[8,16,8]);}
}

object timber_settee(label="Timber settee"){
 measure(kind=bench,axis=x,meters=2.1);
 body(interaction=solid,radius=16,height=15);
 impact(mode=break(speed=95,scatter=65,lift=65,spin=4,lifetime=6,pattern=splinter));
 seat left(at=[-6.5,6.8,1],approach=[-6.5,22],heading_deg=90);
 seat right(at=[6.5,6.8,1],approach=[6.5,22],heading_deg=90);
 fragment frame(){
  part base(shape=box,material=home_wood,at=[0,4,0],size=[30,2,12]);
  part back_rail(shape=box,material=home_wood,at=[0,10,-5.5],size=[30,10,1]);
  repeat legs(index=l,count=2){
   part front(shape=box,material=home_wood,at=[l*26-13,1.5,4.5],size=[2,3,2]);
   part back(shape=box,material=home_wood,at=[l*26-13,1.5,-4.5],size=[2,3,2]);
  }
 }
 repeat cushions(index=c,count=2){fragment cushion(){
  part seat(shape=prism,material=home_cushion,at=[c*14-7,5.9,.5],size=[13.5,1.8,10.5],outline=[[.04,0],[.96,0],[1,.2],[1,.8],[.96,1],[.04,1],[0,.8],[0,.2]]);
  part back(shape=prism,material=home_cushion,at=[c*14-7,10,-4],size=[13.5,8,2],outline=[[.04,0],[.96,0],[1,.08],[1,.92],[.96,1],[.04,1],[0,.92],[0,.08]]);
 }}
 repeat arms(index=a,count=2){fragment arm(){part side(shape=prism,material=home_wood,at=[a*30-15,8,0],size=[2,6,14],outline=[[.08,0],[.92,0],[1,.1],[1,.9],[.92,1],[.08,1],[0,.9],[0,.1]]);}}
}
