dream 2;
scenario class_preparation(seed=2,max_steps=50){
  item material(label="Lesson pack");
  item session(label="Session completed");
  location library(label="Learning library",at=[150,200]);
  location classroom(label="Classroom",at=[650,200]);
  link campus_walk(from=library,to=classroom,steps=3);
  stock lesson_packs(at=library,item=material,mode=source,quantity=4,price=1);
  service class_session(at=classroom,consumes=material,produces=session,duration=5,capacity=1,fee=0);
  agent learner(at=library,budget=4,capacity=1);
  objective attend_session(agent=learner,kind=produce,at=classroom,item=session,quantity=1);
}
